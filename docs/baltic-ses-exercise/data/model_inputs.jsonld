  "@graph": [

    {"@id": "ses:DATA", "@type": "skos:Concept", "label": "DATA", "note": "Taken from a published source, possibly unit-converted."},
    {"@id": "ses:FIT", "@type": "skos:Concept", "label": "FIT", "note": "Estimated in this notebook from DATA."},
    {"@id": "ses:ASSUMPTION", "@type": "skos:Concept", "label": "ASSUMPTION", "note": "Set by the modeller; no dataset gives it directly."},

    {"@id": "worms:126425", "@type": "ses:Taxon", "label": "Sprattus sprattus",
     "asfisCode": "SPR", "commercialName": "European sprat",
     "note": "WoRMS AphiaID 126425 (accepted). EUMOFA reports first-sale prices under the commercial species 'European sprat' (FAO ASFIS 3-alpha SPR); ICES assesses the stock spr.27.22-32 of the same species."},

    {"@id": "urn:baltic-ses:series:ices-spr.27.22-32", "@type": "dcat:DatasetSeries",
