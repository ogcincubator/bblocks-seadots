    "aboutTaxon": {"@id": "ses:aboutTaxon", "@type": "@id"},
    "asfisCode": "ses:asfisCode",
    "commercialName": "ses:commercialSpeciesName",
    "stockKeyLabel": "ses:stockKeyLabel",
    "liveCheck": "ses:liveCheckURL",

    "hasProperty": "iop:hasProperty",
    "hasObjectOfInterest": {"@id": "iop:hasObjectOfInterest", "@type": "@id"},
    "hasContextObject": "iop:hasContextObject",
    "column": "ses:sourceColumn",
    "inDataset": {"@id": "ses:inDataset", "@type": "@id"},
    "unit": {"@id": "qudt:unit", "@type": "@id"},

    "multiplier": {"@id": "qudt:conversionMultiplier", "@type": "xsd:double"},
    "dimension": "ses:baseDimension",
    "factors": {"@id": "ses:unitFactors", "@container": "@list"},
    "of": {"@id": "ses:factorUnit", "@type": "@id"},
    "exp": {"@id": "ses:exponent", "@type": "xsd:integer"},

    "symbol": "ses:symbol",
    "key": "ses:parameterKey",
    "status": {"@id": "ses:evidenceStatus", "@type": "@id"},
    "modelUnit": {"@id": "ses:modelUnit", "@type": "@id"},
    "measures": {"@id": "ses:measures", "@type": "@id"},
    "derivedFrom": {"@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set"},
    "generatedBy": {"@id": "prov:wasGeneratedBy", "@type": "@id"},
    "used": {"@id": "prov:used", "@type": "@id", "@container": "@set"},
    "method": "ses:method",
    "sourceQuantity": "ses:sourceQuantity",
    "op": "ses:operation",
    "terms": {"@id": "ses:term", "@container": "@list"},
    "exactMatch": {"@id": "skos:exactMatch", "@type": "@id"},
