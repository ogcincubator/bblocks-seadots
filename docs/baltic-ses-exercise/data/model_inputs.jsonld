     "accessURL": "https://windeurope.org/news/poland-powers-ahead-first-offshore-wind-auction-delivers-strong-results/",
     "localFile": "economic_inputs.csv", "retrieved": "2026-10-26", "spatialScope": "Polish EEZ"},

    {"@id": "urn:baltic-ses:dataset:baltica2-investment", "@type": "dcat:Dataset",
     "title": "Baltica 2 investment decision (Notes from Poland)", "publisher": "Notes from Poland",
     "issued": "2025-01-31", "periodicity": "freq:irregular",
     "accessURL": "https://notesfrompoland.com/2025/01/31/pge-and-orsted-set-to-build-polands-second-offshore-wind-farm-for-e7-11-billion/",
     "localFile": "economic_inputs.csv", "retrieved": "2026-10-26", "spatialScope": "Polish EEZ"},

    {"@id": "urn:baltic-ses:dataset:national", "@type": "dcat:Dataset",
