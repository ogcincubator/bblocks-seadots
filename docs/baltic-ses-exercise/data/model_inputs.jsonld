     "localFile": "polish_offshore_wind_pipeline.csv", "retrieved": "2026-10-26", "spatialScope": "Polish EEZ",
     "note": "Same @id as the national FeatureCollection written by the GeoJSON-LD cell in part 2b."},

    {"@id": "urn:baltic-ses:dataset:emodnet", "@type": "dcat:Dataset",
     "title": "EMODnet Human Activities, wind farms (points), Poland", "publisher": "EMODnet Human Activities",
     "version": "2026", "issued": "2026", "periodicity": "freq:annual",
     "accessURL": "https://ows.emodnet-humanactivities.eu/wfs",
     "localFile": "emodnet_windfarms_poland_2026-10-26.csv", "retrieved": "2026-10-26", "spatialScope": "Polish EEZ",
     "note": "Same @id as the EMODnet FeatureCollection written by the GeoJSON-LD cell in part 2b."},

    {"@id": "urn:baltic-ses:variable:sprat-ssb", "@type": "iop:Variable",
     "label": "Spawning-stock biomass of Baltic sprat",
     "hasProperty": "biomass", "hasObjectOfInterest": "worms:126425",
     "hasContextObject": "spawning stock, ICES subdivisions 22-32",
     "column": "SSB", "inDataset": ["urn:baltic-ses:dataset:ices-sag-20915", "urn:baltic-ses:dataset:ices-sag-22378"],
     "unit": "unit:TONNE"},

    {"@id": "urn:baltic-ses:variable:sprat-catch", "@type": "iop:Variable",
     "label": "Total catch of Baltic sprat",
     "hasProperty": "mass", "hasObjectOfInterest": "worms:126425",
     "hasContextObject": "catch (landings + discards), ICES subdivisions 22-32",
     "column": "Catches", "inDataset": ["urn:baltic-ses:dataset:ices-sag-20915", "urn:baltic-ses:dataset:ices-sag-22378"],
     "unit": "unit:TONNE"},

    {"@id": "urn:baltic-ses:variable:sprat-first-sale-price", "@type": "iop:Variable",
     "label": "First-sale price of European sprat", "hasProperty": "price",
     "hasObjectOfInterest": "worms:126425", "hasContextObject": "first sale, fresh, Poland",
     "column": "value (sprat_first_sale_price_PL_2024)", "inDataset": "urn:baltic-ses:dataset:eumofa-sprat-price",
     "unit": "ses:EUR-PER-KiloGM"},

    {"@id": "urn:baltic-ses:model-variable:x", "@type": "ses:ModelVariable", "symbol": "x",
     "label": "Fish biomass in the model", "modelUnit": "ses:MegaTONNE",
     "closeMatch": "urn:baltic-ses:variable:sprat-ssb",
     "note": "closeMatch, not exactMatch: the model's x is a single-stock biomass with logistic growth; it is calibrated on SSB, which excludes juveniles."},
    {"@id": "urn:baltic-ses:model-variable:q", "@type": "ses:ModelVariable", "symbol": "q",
     "label": "Harvest in the model", "modelUnit": "ses:MegaTONNE",
     "exactMatch": "urn:baltic-ses:variable:sprat-catch"},

    {"@id": "unit:KiloGM", "@type": "qudt:Unit", "label": "kilogram", "dimension": "mass", "multiplier": 1},
    {"@id": "unit:TONNE", "@type": "qudt:Unit", "label": "tonne", "dimension": "mass", "multiplier": 1000},
    {"@id": "ses:MegaTONNE", "@type": "qudt:Unit", "label": "million tonnes", "dimension": "mass", "multiplier": 1e9},
    {"@id": "unit:CCY_EUR", "@type": "qudt:Unit", "label": "euro", "dimension": "currency", "multiplier": 1},
    {"@id": "ses:MegaEUR", "@type": "qudt:Unit", "label": "million euro", "dimension": "currency", "multiplier": 1e6},
    {"@id": "unit:MegaW", "@type": "qudt:Unit", "label": "megawatt", "dimension": "power", "multiplier": 1e6},
    {"@id": "unit:GigaW", "@type": "qudt:Unit", "label": "gigawatt", "dimension": "power", "multiplier": 1e9},
    {"@id": "unit:HR", "@type": "qudt:Unit", "label": "hour", "dimension": "time", "multiplier": 3600},
    {"@id": "unit:YR", "@type": "qudt:Unit", "label": "year (365.25 d)", "dimension": "time", "multiplier": 31557600},
    {"@id": "unit:UNITLESS", "@type": "qudt:Unit", "label": "dimensionless", "factors": []},
    {"@id": "unit:PER-YR", "@type": "qudt:Unit", "label": "per year", "factors": [{"of": "unit:YR", "exp": -1}]},
    {"@id": "unit:MegaW-HR", "@type": "qudt:Unit", "label": "megawatt hour", "factors": [{"of": "unit:MegaW", "exp": 1}, {"of": "unit:HR", "exp": 1}]},
    {"@id": "ses:EUR-PER-KiloGM", "@type": "qudt:Unit", "label": "EUR per kg", "factors": [{"of": "unit:CCY_EUR", "exp": 1}, {"of": "unit:KiloGM", "exp": -1}]},
    {"@id": "ses:EUR-PER-TONNE", "@type": "qudt:Unit", "label": "EUR per tonne", "factors": [{"of": "unit:CCY_EUR", "exp": 1}, {"of": "unit:TONNE", "exp": -1}]},
    {"@id": "ses:EUR-PER-MegaW-HR", "@type": "qudt:Unit", "label": "EUR per MWh", "factors": [{"of": "unit:CCY_EUR", "exp": 1}, {"of": "unit:MegaW-HR", "exp": -1}]},
    {"@id": "ses:MegaEUR-PER-MegaW", "@type": "qudt:Unit", "label": "million EUR per MW", "factors": [{"of": "ses:MegaEUR", "exp": 1}, {"of": "unit:MegaW", "exp": -1}]},
    {"@id": "ses:MegaEUR-PER-GigaW", "@type": "qudt:Unit", "label": "million EUR per GW", "factors": [{"of": "ses:MegaEUR", "exp": 1}, {"of": "unit:GigaW", "exp": -1}]},
    {"@id": "ses:MegaEUR-PER-GigaW-YR", "@type": "qudt:Unit", "label": "million EUR per GW per year", "factors": [{"of": "ses:MegaEUR", "exp": 1}, {"of": "unit:GigaW", "exp": -1}, {"of": "unit:YR", "exp": -1}]},
    {"@id": "ses:MegaEUR-PER-MegaTONNE", "@type": "qudt:Unit", "label": "million EUR per million tonnes", "factors": [{"of": "ses:MegaEUR", "exp": 1}, {"of": "ses:MegaTONNE", "exp": -1}]},
    {"@id": "ses:PER-MegaTONNE-YR", "@type": "qudt:Unit", "label": "per million tonnes per year", "factors": [{"of": "ses:MegaTONNE", "exp": -1}, {"of": "unit:YR", "exp": -1}]},

    {"@id": "urn:baltic-ses:activity:fit-surplus-production", "@type": "prov:Activity",
     "label": "Fit of logistic surplus production (part 3a)",
     "method": "least squares, S = alpha*x - beta*x^2, no intercept, years from FIT_FROM",
     "used": ["urn:baltic-ses:dataset:ices-sag-20915"]},

    {"@id": "urn:baltic-ses:parameter:alpha", "@type": "ses:ModelParameter", "key": "alpha", "symbol": "α",
     "label": "Intrinsic growth rate", "status": "ses:FIT", "modelUnit": "unit:PER-YR",
     "generatedBy": "urn:baltic-ses:activity:fit-surplus-production"},
    {"@id": "urn:baltic-ses:parameter:beta", "@type": "ses:ModelParameter", "key": "beta", "symbol": "β",
     "label": "Density dependence", "status": "ses:FIT", "modelUnit": "ses:PER-MegaTONNE-YR",
     "generatedBy": "urn:baltic-ses:activity:fit-surplus-production"},
    {"@id": "urn:baltic-ses:parameter:x0", "@type": "ses:ModelParameter", "key": "x0", "symbol": "x₀",
     "label": "Initial fish biomass (SSB in 2025)", "status": "ses:DATA", "modelUnit": "ses:MegaTONNE",
     "measures": "urn:baltic-ses:variable:sprat-ssb",
     "derivedFrom": ["urn:baltic-ses:dataset:ices-sag-20915"],
     "sourceQuantity": {"op": "value", "terms": ["ices:SSB@2025"], "unit": "unit:TONNE"}},
    {"@id": "urn:baltic-ses:parameter:p", "@type": "ses:ModelParameter", "key": "p", "symbol": "p",
     "label": "Fish price", "status": "ses:DATA", "modelUnit": "ses:MegaEUR-PER-MegaTONNE",
     "measures": "urn:baltic-ses:variable:sprat-first-sale-price",
     "derivedFrom": ["urn:baltic-ses:dataset:eumofa-sprat-price"],
     "sourceQuantity": {"op": "value", "terms": ["econ:sprat_first_sale_price_PL_2024"], "unit": "ses:EUR-PER-KiloGM"}},
    {"@id": "urn:baltic-ses:parameter:cof1", "@type": "ses:ModelParameter", "key": "cof1", "symbol": "c₁",
     "label": "Fishing cost scale", "status": "ses:ASSUMPTION",
     "note": "Set so that costs are fishing_cost_share of 2024 revenue; replace with STECF AER.",
     "derivedFrom": ["urn:baltic-ses:parameter:p", "urn:baltic-ses:dataset:ices-sag-20915"]},
    {"@id": "urn:baltic-ses:parameter:cof2", "@type": "ses:ModelParameter", "key": "cof2", "symbol": "c₂",
     "label": "Catch-cost exponent", "status": "ses:ASSUMPTION", "modelUnit": "unit:UNITLESS", "note": "Kept from the Excel workbook."},
    {"@id": "urn:baltic-ses:parameter:pe", "@type": "ses:ModelParameter", "key": "pe", "symbol": "p_e",
     "label": "Wind revenue per GW per year", "status": "ses:ASSUMPTION", "modelUnit": "ses:MegaEUR-PER-GigaW-YR",
     "note": "Auction price is DATA; the capacity factor is an ASSUMPTION (the spatial extension replaces it with ERA5).",
     "derivedFrom": ["urn:baltic-ses:dataset:windeurope-pl-auction-2025"],
     "sourceQuantity": {"op": "product", "terms": ["econ:offshore_wind_auction_price_2025", "econ:capacity_factor"], "unit": "ses:EUR-PER-MegaW-HR"}},
    {"@id": "urn:baltic-ses:parameter:cofe1", "@type": "ses:ModelParameter", "key": "cofe1", "symbol": "c_e1",
     "label": "Wind operating cost", "status": "ses:ASSUMPTION", "modelUnit": "ses:MegaEUR-PER-GigaW-YR",
     "sourceQuantity": {"op": "value", "terms": ["econ:wind_opex"], "unit": "ses:MegaEUR-PER-GigaW-YR"}},
    {"@id": "urn:baltic-ses:parameter:cofe2", "@type": "ses:ModelParameter", "key": "cofe2", "symbol": "c_e2",
     "label": "Wind cost exponent", "status": "ses:ASSUMPTION", "modelUnit": "unit:UNITLESS"},
    {"@id": "urn:baltic-ses:parameter:Iwp", "@type": "ses:ModelParameter", "key": "Iwp", "symbol": "p_I",
     "label": "Investment cost per GW", "status": "ses:DATA", "modelUnit": "ses:MegaEUR-PER-GigaW",
     "derivedFrom": ["urn:baltic-ses:dataset:baltica2-investment"],
     "sourceQuantity": {"op": "ratio", "terms": ["econ:baltica2_investment", "econ:baltica2_capacity"], "unit": "ses:MegaEUR-PER-MegaW"}},
    {"@id": "urn:baltic-ses:parameter:dl", "@type": "ses:ModelParameter", "key": "dl", "symbol": "δ",
     "label": "Depreciation rate", "status": "ses:ASSUMPTION", "modelUnit": "unit:PER-YR",
     "sourceQuantity": {"op": "inverse", "terms": ["econ:turbine_lifetime"], "unit": "unit:PER-YR"}},
    {"@id": "urn:baltic-ses:parameter:roi", "@type": "ses:ModelParameter", "key": "roi", "symbol": "r",
     "label": "Discount rate", "status": "ses:ASSUMPTION", "modelUnit": "unit:PER-YR",
     "sourceQuantity": {"op": "value", "terms": ["econ:discount_rate"], "unit": "unit:PER-YR"}},
    {"@id": "urn:baltic-ses:parameter:pu1", "@type": "ses:ModelParameter", "key": "pu1", "symbol": "u₁",
     "label": "Passive-use scale", "status": "ses:ASSUMPTION",
     "note": "Public values a stock at B_MSY at EUR 100 m/yr, so it inherits the growth fit.",
     "derivedFrom": ["urn:baltic-ses:parameter:alpha", "urn:baltic-ses:parameter:beta"]},
    {"@id": "urn:baltic-ses:parameter:pu2", "@type": "ses:ModelParameter", "key": "pu2", "symbol": "u₂",
     "label": "Passive-use exponent (fish)", "status": "ses:ASSUMPTION", "modelUnit": "unit:UNITLESS"},
    {"@id": "urn:baltic-ses:parameter:pu3", "@type": "ses:ModelParameter", "key": "pu3", "symbol": "u₃",
     "label": "Passive-use exponent (wind)", "status": "ses:ASSUMPTION", "modelUnit": "unit:UNITLESS"},
    {"@id": "urn:baltic-ses:parameter:eps1", "@type": "ses:ModelParameter", "key": "eps1", "symbol": "ε₁",
     "label": "Wind effect on fish growth", "status": "ses:ASSUMPTION"},
    {"@id": "urn:baltic-ses:parameter:eps2", "@type": "ses:ModelParameter", "key": "eps2", "symbol": "ε₂",
     "label": "Wind effect on fishing cost", "status": "ses:ASSUMPTION",
     "derivedFrom": ["urn:baltic-ses:parameter:cof1"]},
    {"@id": "urn:baltic-ses:parameter:w0", "@type": "ses:ModelParameter", "key": "w0", "symbol": "w₀",
     "label": "Initial wind capacity", "status": "ses:DATA", "modelUnit": "unit:GigaW",
     "derivedFrom": ["urn:baltic-ses:dataset:national"]},
    {"@id": "urn:baltic-ses:parameter:Iw_contracted", "@type": "ses:ModelParameter", "key": "Iw_contracted", "symbol": "I_w(t)",
     "label": "Contracted investment path", "status": "ses:DATA", "modelUnit": "unit:GigaW",
     "derivedFrom": ["urn:baltic-ses:dataset:national"]}
  ]
}
