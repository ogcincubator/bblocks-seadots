{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://wiki.openstreetmap.org/wiki/Key:",
    "osmk": "https://wiki.openstreetmap.org/wiki/Key:",
    "osmr": "urn:baltic-ses:osm-raw#",
    "geojson": "https://purl.org/geojson/vocab#",
    "id": "@id",
    "type": "@type",
    "Feature": "geojson:Feature",
    "properties": "geojson:properties",
    "tags": "@nest",
    "osm_type": "osmr:elementType",
    "osm_id": "osmr:elementId",
    "members": {"@id": "osmr:member", "@container": "@set"},
    "generator:method": "osmk:generator:method",
    "generator:source": "osmk:generator:source",
    "generator:type": "osmk:generator:type",
    "generator:output:electricity": "osmk:generator:output:electricity",
    "rotor:diameter": "osmk:rotor:diameter",
    "height:hub": "osmk:height:hub",
    "plant:output:electricity": "osmk:plant:output:electricity",
    "plant:source": "osmk:plant:source",
    "plant:type": "osmk:plant:type",
    "plant:method": "osmk:plant:method",
    "construction:power": "osmk:construction:power",
    "seamark:name": "osmk:seamark:name",
    "seamark:type": "osmk:seamark:type",
    "seamark:production_area:product": "osmk:seamark:production_area:product",
    "seamark:platform:category": "osmk:seamark:platform:category",
    "seamark:landmark:production_area": "osmk:seamark:landmark:production_area"
  }
}
