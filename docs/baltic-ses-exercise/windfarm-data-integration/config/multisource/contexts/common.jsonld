{
  "@context": {
    "@version": 1.1,
    "owc": "urn:baltic-ses:owc#",
    "em": "https://w3id.org/ogc/hosted/seadots/emodnet-compliant-windfarm#",
    "ses": "https://w3id.org/ogc/hosted/seadots/emodnet-compliant-windfarm-pl#",
    "sem": "https://w3id.org/ogc/hosted/seadots/emodnet/",
    "geojson": "https://purl.org/geojson/vocab#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "Feature": "geojson:Feature",
    "FeatureCollection": "geojson:FeatureCollection",
    "features": {
      "@id": "geojson:features",
      "@container": "@set"
    },
    "properties": "geojson:properties",
    "geometry": "geojson:geometry",
    "name": "schema:name",
    "WindFarm": "owc:WindFarm",
    "WindTurbine": "owc:WindTurbine",
    "PlanningZone": "owc:PlanningZone",
    "power_mw": "em:powerMW",
    "n_turbines": "em:nTurbines",
    "n_turbines_mapped": "owc:nTurbinesMapped",
    "status": {
      "@id": "owc:status",
      "@type": "@vocab"
    },
    "Planned": "sem:Planned",
    "Approved": "sem:Approved",
    "Construction": "sem:Construction",
    "Production": "sem:Production",
    "year": "em:year",
    "updateyear": "em:updateYear",
    "area_km2": "owc:areaKm2",
    "zones": {
      "@id": "owc:withinZone",
      "@type": "@id",
      "@container": "@set"
    },
    "farm": {
      "@id": "owc:partOfFarm",
      "@type": "@id"
    },
    "farms": {
      "@id": "owc:containsFarm",
      "@type": "@id",
      "@container": "@set"
    },
    "ref": "owc:turbineRef",
    "model": "owc:turbineModel",
    "manufacturer": "owc:manufacturer",
    "operator": "owc:operatorName",
    "rated_power_mw": "owc:ratedPowerMW",
    "rotor_diameter_m": "owc:rotorDiameterM",
    "hub_height_m": "owc:hubHeightM",
    "status_text": "owc:sourceStatusText",
    "records": {
      "@id": "owc:hasRecord",
      "@container": "@set"
    },
    "source": {
      "@id": "dcterms:source",
      "@type": "@id"
    },
    "source_key": "owc:sourceKey",
    "derived_from": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id"
    },
    "source_snapshot_date": "ses:sourceSnapshotDate",
    "location_kind": "owc:locationKind",
    "value_source": {
      "@id": "owc:valueSource",
      "@container": "@set"
    },
    "geo": "http://www.opengis.net/ont/geosparql#",
    "describes": {
      "@id": "owc:describes",
      "@type": "@id"
    },
    "record_kind": {
      "@id": "owc:recordKind",
      "@type": "@vocab"
    },
    "SourceRecord": "owc:SourceRecord",
    "source_status_text": "owc:sourceStatusText",
    "dist_coast": "em:distanceToCoast",
    "type_inst": "schema:additionalType",
    "developer": "schema:creator"
  }
}