{
  "@context": {
    "@version": 1.1,
    "owc": "urn:baltic-ses:owc#",
    "em": "https://w3id.org/ogc/hosted/seadots/emodnet-compliant-windfarm#",
    "ses": "https://w3id.org/ogc/hosted/seadots/emodnet-compliant-windfarm-pl#",
    "sem": "https://w3id.org/ogc/hosted/seadots/emodnet/",
    "geojson": "https://purl.org/geojson/vocab#",
    "schema": "https://schema.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "Feature": "geojson:Feature",
    "FeatureCollection": "geojson:FeatureCollection",
    "features": {"@id": "geojson:features", "@container": "@set"},
    "properties": "geojson:properties",
    "geometry": "geojson:geometry",
    "name": "schema:name",
    "kind": {"@id": "@type", "@type": "@vocab"},
    "WindFarm": "owc:WindFarm",
    "WindTurbine": "owc:WindTurbine",
    "PlanningZone": "owc:PlanningZone",
    "power_mw": {"@id": "em:powerMW", "@type": "xsd:decimal"},
    "n_turbines": {"@id": "em:nTurbines", "@type": "xsd:integer"},
    "n_turbines_mapped": {"@id": "owc:nTurbinesMapped", "@type": "xsd:integer"},
    "status": {"@id": "owc:status", "@type": "@vocab"},
    "Planned": "sem:Planned",
    "Approved": "sem:Approved",
    "Construction": "sem:Construction",
    "Production": "sem:Production",
    "year": "em:year",
    "updateyear": "em:updateYear",
    "area_km2": {"@id": "owc:areaKm2", "@type": "xsd:decimal"},
    "zones": {"@id": "owc:withinZone", "@type": "@id", "@container": "@set"},
    "farm": {"@id": "owc:partOfFarm", "@type": "@id"},
    "farms": {"@id": "^owc:withinZone", "@type": "@id", "@container": "@set"},
    "ref": "owc:turbineRef",
    "model": "owc:turbineModel",
    "manufacturer": "owc:manufacturer",
    "operator": "owc:operatorName",
    "rated_power_mw": {"@id": "owc:ratedPowerMW", "@type": "xsd:decimal"},
    "rotor_diameter_m": {"@id": "owc:rotorDiameterM", "@type": "xsd:decimal"},
    "hub_height_m": {"@id": "owc:hubHeightM", "@type": "xsd:decimal"},
    "status_text": "owc:sourceStatusText",
    "value_sources": {"@id": "owc:valueSources", "@type": "@json"},
    "records": {"@id": "^owc:describes", "@container": "@set"},
    "record": "@id",
    "source": {"@id": "dcterms:source", "@type": "@id"},
    "source_key": "owc:sourceKey",
    "derived_from": {"@id": "prov:wasDerivedFrom", "@type": "@id"},
    "source_snapshot_date": {"@id": "ses:sourceSnapshotDate", "@type": "xsd:date"},
    "location_kind": "owc:locationKind"
  }
}
