      "transforms": [
        {
          "id": "to-windfarm-designated-area",
          "description": "Converts an OSM API 0.6 map response into windfarm designated areas (`common-windfarm-designated-area`). The transformation is driven by the alignment declared in this block's `ontology.ttl`: `osmdata:WindfarmElement` selects wind farm ways and relations, and `osmdata:windfarmTagMappings` maps OSM tags onto `owf:` properties with their value conversions. A wind farm relation is merged with its outer and same-name ways, which become `same_as` links. Geometry comes from the area way, with `area_sqkm` computed geodesically. Turbines and other devices are not output. The output's `@context` references the target block's JSON-LD context.\n",
          "type": "python",
          "ref": "https://ogcincubator.github.io/bblocks-seadots/_sources/windfarms/windfarm-openstreetmap/transforms/osm_to_windfarm_area.py",
          "inputs": {
            "mediaTypes": [
              {
                "mimeType": "application/json",
                "label": "JSON",
                "defaultExtension": "json"
              }
            ]
          },
          "outputs": {
            "mediaTypes": [
              {
                "mimeType": "application/geo+json",
                "label": "GeoJSON",
                "defaultExtension": "geojson"
              },
              {
                "mimeType": "application/json",
                "label": "JSON",
                "defaultExtension": "json"
              }
            ],
            "profiles": [
              "bblocks://ogc.hosted.seadots.windfarms.common-windfarm-designated-area"
            ]
          },
          "metadata": {
            "ontology": "_sources/windfarms/windfarm-openstreetmap/ontology.ttl",
            "source_snapshot_date": "2026-10-27",
            "dependencies": {
              "pip": [
                "rdflib",
                "pyproj"
              ]
            }
          },
          "code": "#!/usr/bin/env python3\n\"\"\"\nTransform an OSM API 0.6 map response (windfarm-openstreetmap) into windfarm\ndesignated areas (common-windfarm-designated-area), driven by the alignment in\nwindfarm-openstreetmap/ontology.ttl.\n\nThe ontology declares which elements are wind farms (osmdata:WindfarmElement and\nits osmdata:selectionRules) and how tags map onto owf: properties\n(osmdata:windfarmTagMappings: source keys, value rules, conversions). This script\nonly interprets that alignment and applies the element-level rules documented in\nthe ontology (merging relation parts, geometry, provenance).\n\nOGC Building Blocks Python transform compatibility:\n* when `input_data` is provided, assigns `output_data`;\n* when run standalone: python3 osm_to_windfarm_area.py [ontology.ttl] < osm.json > areas.json\n\nThe ontology is located from transform metadata `ontology`, then\n_sources/windfarms/windfarm-openstreetmap/ontology.ttl relative to the working\ndirectory, then next to this script.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\nfrom urllib.parse import urljoin\n\nfrom pyproj import Geod\nfrom rdflib import Graph, Literal, Namespace, URIRef\nfrom rdflib.collection import Collection\nfrom rdflib.namespace import RDF\n\nOSMD = Namespace(\"https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source/\")\nONTOLOGY_IRI = URIRef(\"https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source\")\nKEY_NS = \"https://www.openstreetmap.org/wiki/Key:\"\nOSM = \"https://www.openstreetmap.org/\"\nONTOLOGY_PATH = \"_sources/windfarms/windfarm-openstreetmap/ontology.ttl\"\nPUBLISHED_BLOCK_URL = (\"https://ogcincubator.github.io/bblocks-seadots/build/annotated/\"\n                       \"hosted/seadots/windfarms/windfarm-openstreetmap/\")\nTARGET_CONTEXT_REF = \"../common-windfarm-designated-area/context.jsonld\"\n\nFIELDS = [\"name\", \"country\", \"n_turbines\", \"power_mw\", \"status\", \"status_detail\", \"status_as_of\",\n          \"type_inst\", \"offshore\", \"year\", \"year_semantics\", \"year_is_assumed\", \"updateyear\",\n          \"operational_date\", \"valid_from\", \"dist_coast\", \"area_sqkm\", \"operator\", \"owner\", \"developer\",\n          \"licence_status\", \"licensing_case\", \"admin_units\", \"electricity_price_area\",\n          \"mean_annual_production_gwh\", \"notes\", \"source_type\", \"source_dataset\", \"source_reference\",\n          \"source_record_id\", \"source_snapshot_date\", \"last_updated\", \"update_date\", \"metadata_record\",\n          \"location_status\", \"location_method\", \"location_reference\", \"positional_accuracy_m\", \"same_as\"]\n\n\n# ---------------------------------------------------------------- alignment\n\ndef tag_key(iri: URIRef) -> str:\n    \"\"\"Key IRI -> JSON tag key. Bare keys that are also prefixes carry a trailing colon.\"\"\"\n    key = str(iri)[len(KEY_NS):]\n    return key[:-1] if key.endswith(\":\") else key\n\n\ndef local_name(iri: URIRef) -> str:\n    return re.split(r\"[/#]\", str(iri))[-1]\n\n\ndef rlist(g: Graph, node) -> list:\n    return list(Collection(g, node)) if node is not None else []\n\n\ndef load_alignment(path: str | Path) -> dict[str, Any]:\n    g = Graph().parse(str(path), format=\"turtle\")\n    selection = [(tag_key(g.value(r, OSMD.ruleKey)), str(g.value(r, OSMD.ruleValue)))\n                 for r in rlist(g, g.value(OSMD.WindfarmElement, OSMD.selectionRules))]\n    mappings = []\n    for m in rlist(g, g.value(ONTOLOGY_IRI, OSMD.windfarmTagMappings)):\n        rules = []\n        for r in rlist(g, g.value(m, OSMD.valueRules)):\n            value = g.value(r, OSMD.ruleValue)\n            rules.append((tag_key(g.value(r, OSMD.ruleKey)), str(value) if value is not None else None,\n                          g.value(r, OSMD.yields)))\n        when = g.value(m, OSMD.whenPresent)\n        mappings.append({\n            \"key\": str(g.value(m, OSMD.targetKey)),\n            \"sources\": [tag_key(k) for k in rlist(g, g.value(m, OSMD.sourceKeys))],\n            \"conversion\": g.value(m, OSMD.conversion),\n            \"fallback\": g.value(m, OSMD.fallback),\n            \"rules\": rules,\n            \"when_present\": str(when) if when is not None else None,\n        })\n    if not selection or not mappings:\n        raise ValueError(f\"no windfarm alignment found in {path}\")\n    return {\"selection\": selection, \"mappings\": mappings}\n\n\ndef find_ontology(meta: Any) -> Path:\n    candidates = []\n    if meta:\n        inner = meta.get(\"metadata\") if hasattr(meta, \"get\") else None\n        for src in (meta, inner):\n            if src and hasattr(src, \"get\") and src.get(\"ontology\"):\n                candidates.append(Path(src.get(\"ontology\")))\n    candidates.append(Path(ONTOLOGY_PATH))\n    if \"__file__\" in globals():\n        candidates.append(Path(__file__).resolve().parent.parent / \"ontology.ttl\")\n    for c in candidates:\n        if c.is_file():\n            return c\n    raise FileNotFoundError(f\"ontology with the windfarm alignment not found; tried {candidates}\")\n\n\n# ---------------------------------------------------------------- conversions\n\ndef convert(conversion: URIRef | None, value: str) -> Any:\n    if conversion is None or conversion == OSMD.Copy:\n        return value\n    if conversion == OSMD.ParseInteger:\n        return int(value) if re.fullmatch(r\"\\s*\\d+\\s*\", value) else None\n    if conversion == OSMD.ParseMegawatts:\n        m = re.fullmatch(r\"\\s*(\\d+(?:\\.\\d+)?)\\s*(?:MW)?\\s*\", value)\n        return float(m.group(1)) if m else None\n    if conversion == OSMD.SplitSemicolon:\n        return [v.strip() for v in value.split(\";\") if v.strip()] or None\n    raise ValueError(f\"unsupported conversion {conversion}\")\n\n\ndef rule_result(yields: Any, key: str, value: str) -> Any:\n    if yields == OSMD.Copy:\n        return value\n    if yields == OSMD.KeyEqualsValue:\n        return f\"{key}={value}\"\n    if isinstance(yields, Literal):\n        return yields.toPython()\n    return local_name(yields)          # concept -> its code, e.g. seadots-emodnet:Construction -> \"Construction\"\n\n\n# ---------------------------------------------------------------- transform\n\ndef transform_response(src: dict, alignment: dict, snapshot_date: str | None = None) -> dict:\n    elements = src[\"elements\"]\n    index = {(e[\"type\"], e[\"id\"]): e for e in elements}\n    selected = [e for e in elements if e[\"type\"] in (\"way\", \"relation\")\n                and any(e.get(\"tags\", {}).get(k) == v for k, v in alignment[\"selection\"])]\n    relations = [e for e in selected if e[\"type\"] == \"relation\"]\n\n    def outer_ways(rel):\n        return [index[(\"way\", m[\"ref\"])] for m in rel[\"members\"]\n                if m[\"type\"] == \"way\" and m[\"role\"] == \"outer\" and (\"way\", m[\"ref\"]) in index]\n\n    def same_name_ways(rel):\n        name = rel.get(\"tags\", {}).get(\"name\")\n        return [w for w in selected if w[\"type\"] == \"way\" and name and w.get(\"tags\", {}).get(\"name\") == name\n                and w not in outer_ways(rel)]\n\n    merged = {w[\"id\"] for r in relations for w in outer_ways(r) + same_name_ways(r)}\n    primaries = relations + [w for w in selected if w[\"type\"] == \"way\" and w[\"id\"] not in merged]\n\n    b = src[\"bounds\"]\n    source_reference = (f\"https://api.openstreetmap.org/api/0.6/map.json?bbox=\"\n                        f\"{b['minlon']},{b['minlat']},{b['maxlon']},{b['maxlat']}\")\n    geod = Geod(ellps=\"WGS84\")\n    features = []\n    for el in primaries:\n        parts = outer_ways(el) + same_name_ways(el) if el[\"type\"] == \"relation\" else []\n        chain = [el] + parts\n\n        def tag(key):\n            for p in chain:\n                if key in p.get(\"tags\", {}):\n                    return p[\"tags\"][key]\n            return None\n\n        props: dict[str, Any] = {k: None for k in FIELDS}\n        for m in alignment[\"mappings\"]:\n            value = None\n            if m[\"sources\"]:\n                raw = next((tag(k) for k in m[\"sources\"] if tag(k) is not None), None)\n                if raw is not None:\n                    value = m[\"when_present\"] if m[\"when_present\"] else convert(m[\"conversion\"], raw)\n                elif m[\"fallback\"] == OSMD.CountGeneratorMembers:\n                    n = sum(1 for x in el.get(\"members\", []) if x[\"role\"] == \"generator\")\n                    value = n or None\n            for key, match, yields in m[\"rules\"]:\n                v = tag(key)\n                if v is not None and (match is None or v == match):\n                    value = rule_result(yields, key, v)\n                    break\n            props[m[\"key\"]] = value\n\n        area_way = el if el[\"type\"] == \"way\" else (outer_ways(el) or [None])[0]\n        geometry = None\n        if area_way:\n            ring = [[index[(\"node\", n)][\"lon\"], index[(\"node\", n)][\"lat\"]] for n in area_way[\"nodes\"]]\n            geometry = {\"type\": \"Polygon\", \"coordinates\": [ring]}\n            area, _ = geod.polygon_area_perimeter([c[0] for c in ring], [c[1] for c in ring])\n            props[\"area_sqkm\"] = round(abs(area) / 1e6, 3)\n        props.update({\n            \"source_type\": \"osm\",\n            \"source_dataset\": \"OpenStreetMap\",\n            \"source_reference\": source_reference,\n            \"source_record_id\": f\"{el['type']}/{el['id']}\",\n            \"source_snapshot_date\": snapshot_date,\n            \"last_updated\": max(p[\"timestamp\"] for p in chain),\n            \"location_status\": \"source-provided\" if geometry else \"unmatched\",\n            \"location_method\": (f\"outer way {area_way['id']} of the OSM element\" if geometry else\n                                \"no OSM area contains this wind farm's turbines; geometry left null\"),\n            \"same_as\": [f\"{OSM}way/{p['id']}\" for p in parts] or None,\n        })\n        features.append({\"type\": \"Feature\", \"id\": f\"{OSM}{el['type']}/{el['id']}\",\n                         \"geometry\": geometry, \"properties\": props})\n    return {\"type\": \"FeatureCollection\", \"features\": features}\n\n\ndef target_context_url() -> str:\n    \"\"\"Annotated context of the target block, a sibling of this block in the build; published URL if standalone.\"\"\"\n    ctx = getattr(globals().get(\"transform_metadata\"), \"context\", None)\n    base, annotated = getattr(ctx, \"base_url\", None), getattr(ctx, \"bblock_annotated_path\", None)\n    block_url = urljoin(base, f\"{annotated}/\") if base and annotated else PUBLISHED_BLOCK_URL\n    return urljoin(block_url, TARGET_CONTEXT_REF)\n\n\ndef transform(raw_json: str, meta: Any = None) -> str:\n    alignment = load_alignment(find_ontology(meta))\n    snapshot = None\n    if meta and hasattr(meta, \"get\"):\n        inner = meta.get(\"metadata\") or {}\n        snapshot = meta.get(\"source_snapshot_date\") or (inner.get(\"source_snapshot_date\") if hasattr(inner, \"get\") else None)\n    out = {\"@context\": target_context_url(), **transform_response(json.loads(raw_json), alignment, snapshot)}\n    return json.dumps(out, indent=2, ensure_ascii=False)\n\n\ndef main() -> int:\n    meta = {\"ontology\": sys.argv[1]} if len(sys.argv) > 1 else {}\n    if len(sys.argv) > 2:\n        meta[\"source_snapshot_date\"] = sys.argv[2]\n    sys.stdout.write(transform(sys.stdin.read(), meta) + \"\\n\")\n    return 0\n\n\nif \"input_data\" in globals():\n    output_data = transform(input_data, getattr(globals().get(\"transform_metadata\"), \"metadata\", None))  # noqa: F821\nelif __name__ == \"__main__\":\n    raise SystemExit(main())\n"
        },
        {
          "id": "to-windfarm-turbine",
          "description": "Converts an OSM API 0.6 map response into wind turbines (`common-windfarm-turbine`). The transformation is driven by the alignment declared in this block's `ontology.ttl`: `osmdata:TurbineElement` selects `power=generator` nodes and `osmdata:turbineTagMappings` maps their tags onto `owf:` properties (rated power, hub height, rotor diameter, rotor axis, condition). Each turbine gets the wind farm relation it is a member of as `windfarm`, and the relation name as `windfarm_name`. The output's `@context` references the target block's JSON-LD context.\n",
          "type": "python",
          "ref": "https://ogcincubator.github.io/bblocks-seadots/_sources/windfarms/windfarm-openstreetmap/transforms/osm_to_windfarm_turbine.py",
          "inputs": {
            "mediaTypes": [
              {
                "mimeType": "application/json",
                "label": "JSON",
                "defaultExtension": "json"
              }
            ]
          },
          "outputs": {
            "mediaTypes": [
              {
                "mimeType": "application/geo+json",
                "label": "GeoJSON",
                "defaultExtension": "geojson"
              },
              {
                "mimeType": "application/json",
                "label": "JSON",
                "defaultExtension": "json"
              }
            ],
            "profiles": [
              "bblocks://ogc.hosted.seadots.windfarms.common-windfarm-turbine"
            ]
          },
          "metadata": {
            "ontology": "_sources/windfarms/windfarm-openstreetmap/ontology.ttl",
            "target_context": "_sources/windfarms/common-windfarm-turbine/context.jsonld",
            "dependencies": {
              "pip": [
                "rdflib"
              ]
            }
          },
          "code": "#!/usr/bin/env python3\n\"\"\"\nTransform an OSM API 0.6 map response (windfarm-openstreetmap) into wind turbines\n(common-windfarm-turbine), driven by the alignment in windfarm-openstreetmap/ontology.ttl.\n\nThe ontology declares which nodes are turbines (osmdata:TurbineElement and its selection rules)\nand how their tags map onto owf: properties (osmdata:turbineTagMappings, with the same\nTagMapping / ValueRule vocabulary as the wind farm areas). This script only interprets that\nalignment and applies the element-level rules documented in the ontology: node -> Point\nfeature, membership of a wind farm relation (osmdata:WindfarmElement) -> windfarm and\nwindfarm_name, node timestamp -> last_updated.\n\nConcepts are written as the target block's JSON terms (owf:HorizontalAxis -> \"horizontal_axis\",\ninspire-cofv:underConstruction -> \"underConstruction\"), read from the target context.\n\nOGC Building Blocks Python transform compatibility:\n* when `input_data` is provided, assigns `output_data`;\n* standalone: python3 osm_to_windfarm_turbine.py [--ontology ontology.ttl] < osm.json > turbines.geojson\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\nfrom urllib.parse import urljoin\n\nfrom rdflib import Graph, Literal, Namespace, URIRef\nfrom rdflib.collection import Collection\n\nOSMD = Namespace(\"https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source/\")\nONTOLOGY_IRI = URIRef(\"https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source\")\nKEY_NS = \"https://www.openstreetmap.org/wiki/Key:\"\nOSM = \"https://www.openstreetmap.org/\"\nBLOCK_DIR = \"_sources/windfarms/windfarm-openstreetmap\"\nTARGET_CONTEXT = \"_sources/windfarms/common-windfarm-turbine/context.jsonld\"\nPUBLISHED_BLOCK_URL = (\"https://ogcincubator.github.io/bblocks-seadots/build/annotated/\"\n                       \"hosted/seadots/windfarms/windfarm-openstreetmap/\")\nTARGET_CONTEXT_REF = \"../common-windfarm-turbine/context.jsonld\"\n\nFIELDS = [\"ref\", \"windfarm_name\", \"windfarm\", \"manufacturer\", \"model\", \"rated_power_mw\", \"hub_height_m\",\n          \"rotor_diameter_m\", \"rotor_axis\", \"offshore\", \"operator\", \"status\", \"last_updated\"]\n\n\n# ---------------------------------------------------------------- locating block files\n\ndef _meta(meta: Any, key: str):\n    if not meta or not hasattr(meta, \"get\"):\n        return None\n    inner = meta.get(\"metadata\")\n    return meta.get(key) or (inner.get(key) if hasattr(inner, \"get\") else None)\n\n\ndef _here() -> Path | None:\n    return Path(__file__).resolve().parent.parent if \"__file__\" in globals() else None\n\n\ndef _find(meta: Any, key: str, *defaults: Path) -> Path | None:\n    candidates = [Path(p) for p in [_meta(meta, key)] if p] + list(defaults)\n    return next((c for c in candidates if c.is_file()), None)\n\n\n# ---------------------------------------------------------------- alignment\n\ndef tag_key(iri: URIRef) -> str:\n    \"\"\"Key IRI -> JSON tag key. Bare keys that are also prefixes carry a trailing colon.\"\"\"\n    key = str(iri)[len(KEY_NS):]\n    return key[:-1] if key.endswith(\":\") else key\n\n\ndef rlist(g: Graph, node) -> list:\n    return list(Collection(g, node)) if node is not None else []\n\n\ndef concept_terms(context_path: Path | None) -> dict[str, str]:\n    \"\"\"Concept IRI -> JSON term of the target block (e.g. owf:HorizontalAxis -> 'horizontal_axis').\"\"\"\n    if not context_path:\n        return {}\n    ctx = json.loads(context_path.read_text(encoding=\"utf-8\"))[\"@context\"]\n    prefixes = {k: v for k, v in ctx.items() if isinstance(v, str) and v.endswith((\"#\", \"/\"))}\n\n    def expand(v: str) -> str:\n        p, _, local = v.partition(\":\")\n        return prefixes[p] + local if p in prefixes else v\n    return {expand(v): k for k, v in ctx.items()\n            if isinstance(v, str) and not k.startswith(\"@\") and k not in prefixes and k[:1].islower()}\n\n\ndef _rules(g: Graph, node) -> list:\n    out = []\n    for r in rlist(g, node):\n        value = g.value(r, OSMD.ruleValue)\n        out.append((tag_key(g.value(r, OSMD.ruleKey)), str(value) if value is not None else None, g.value(r, OSMD.yields)))\n    return out\n\n\ndef load_alignment(path: str | Path) -> dict[str, Any]:\n    g = Graph().parse(str(path), format=\"turtle\")\n    mappings = [{\"key\": str(g.value(m, OSMD.targetKey)),\n                 \"sources\": [tag_key(k) for k in rlist(g, g.value(m, OSMD.sourceKeys))],\n                 \"conversion\": g.value(m, OSMD.conversion),\n                 \"rules\": _rules(g, g.value(m, OSMD.valueRules))}\n                for m in rlist(g, g.value(ONTOLOGY_IRI, OSMD.turbineTagMappings))]\n    turbine = [(k, v) for k, v, _ in _rules(g, g.value(OSMD.TurbineElement, OSMD.selectionRules))]\n    windfarm = [(k, v) for k, v, _ in _rules(g, g.value(OSMD.WindfarmElement, OSMD.selectionRules))]\n    if not mappings or not turbine:\n        raise ValueError(f\"no turbine alignment found in {path}\")\n    return {\"mappings\": mappings, \"turbine\": turbine, \"windfarm\": windfarm}\n\n\n# ---------------------------------------------------------------- conversions\n\ndef convert(conversion: URIRef | None, value: str) -> Any:\n    if conversion is None or conversion == OSMD.Copy:\n        return value\n    if conversion == OSMD.ParseMegawatts:\n        m = re.fullmatch(r\"\\s*(\\d+(?:\\.\\d+)?)\\s*(?:MW)?\\s*\", value)\n        return float(m.group(1)) if m else None\n    if conversion == OSMD.ParseNumber:\n        m = re.fullmatch(r\"\\s*(\\d+(?:\\.\\d+)?)\\s*(?:m)?\\s*\", value)\n        return float(m.group(1)) if m else None\n    if conversion == OSMD.SplitSemicolon:\n        return [v.strip() for v in value.split(\";\") if v.strip()] or None\n    raise ValueError(f\"unsupported conversion {conversion}\")\n\n\ndef rule_result(yields: Any, terms: dict[str, str], value: str) -> Any:\n    if yields == OSMD.Copy:\n        return value\n    if isinstance(yields, Literal):\n        return yields.toPython()\n    return terms.get(str(yields)) or re.split(r\"[/#]\", str(yields))[-1]\n\n\n# ---------------------------------------------------------------- transform\n\ndef transform_response(src: dict, alignment: dict, terms: dict[str, str]) -> dict:\n    elements = src[\"elements\"]\n    matches = lambda e, rules: any(e.get(\"tags\", {}).get(k) == v for k, v in rules)\n    farm_of = {}\n    for rel in elements:\n        if rel[\"type\"] == \"relation\" and matches(rel, alignment[\"windfarm\"]):\n            for m in rel.get(\"members\", []):\n                if m[\"type\"] == \"node\":\n                    farm_of.setdefault(m[\"ref\"], rel)\n    features = []\n    for el in elements:\n        if el[\"type\"] != \"node\" or not matches(el, alignment[\"turbine\"]):\n            continue\n        tags = el.get(\"tags\", {})\n        props: dict[str, Any] = dict.fromkeys(FIELDS)\n        for m in alignment[\"mappings\"]:\n            value = None\n            raw = next((tags[k] for k in m[\"sources\"] if k in tags), None)\n            if raw is not None:\n                value = convert(m[\"conversion\"], raw)\n            for key, match, yields in m[\"rules\"]:\n                if key in tags and (match is None or tags[key] == match):\n                    value = rule_result(yields, terms, tags[key])\n                    break\n            props[m[\"key\"]] = value\n        farm = farm_of.get(el[\"id\"])\n        if farm:\n            props[\"windfarm\"] = f\"{OSM}relation/{farm['id']}\"\n            props[\"windfarm_name\"] = farm.get(\"tags\", {}).get(\"name\")\n        props[\"last_updated\"] = el.get(\"timestamp\")\n        features.append({\"type\": \"Feature\", \"id\": f\"{OSM}node/{el['id']}\",\n                         \"geometry\": {\"type\": \"Point\", \"coordinates\": [el[\"lon\"], el[\"lat\"]]},\n                         \"properties\": props})\n    return {\"type\": \"FeatureCollection\", \"features\": features}\n\n\ndef target_context_url() -> str:\n    \"\"\"Annotated context of the target block, a sibling of this block in the build; published URL if standalone.\"\"\"\n    ctx = getattr(globals().get(\"transform_metadata\"), \"context\", None)\n    base, annotated = getattr(ctx, \"base_url\", None), getattr(ctx, \"bblock_annotated_path\", None)\n    block_url = urljoin(base, f\"{annotated}/\") if base and annotated else PUBLISHED_BLOCK_URL\n    return urljoin(block_url, TARGET_CONTEXT_REF)\n\n\ndef transform(raw_json: str, meta: Any = None) -> str:\n    here = _here()\n    ontology = _find(meta, \"ontology\", Path(BLOCK_DIR) / \"ontology.ttl\", *([here / \"ontology.ttl\"] if here else []))\n    if not ontology:\n        raise FileNotFoundError(\"ontology.ttl of windfarm-openstreetmap not found\")\n    target = _find(meta, \"target_context\", Path(TARGET_CONTEXT),\n                   *([here.parent / \"common-windfarm-turbine/context.jsonld\"] if here else []))\n    out = transform_response(json.loads(raw_json), load_alignment(ontology), concept_terms(target))\n    return json.dumps({\"@context\": target_context_url(), **out}, indent=2, ensure_ascii=False)\n\n\ndef main() -> int:\n    ap = argparse.ArgumentParser(description=__doc__.split(\"\\n\\n\")[0])\n    ap.add_argument(\"--ontology\"); ap.add_argument(\"--target-context\")\n    args = {k: v for k, v in vars(ap.parse_args()).items() if v}\n    sys.stdout.write(transform(sys.stdin.read(), args) + \"\\n\")\n    return 0\n\n\nif \"input_data\" in globals():\n    output_data = transform(input_data, getattr(globals().get(\"transform_metadata\"), \"metadata\", None))  # noqa: F821\nelif __name__ == \"__main__\":\n    raise SystemExit(main())\n"
        }
      ],
