      "semanticUplift": {
        "additionalSteps": [
          {
            "type": "jq",
            "code": "def lift_row_id:\n  if (.properties | type) == \"object\" and (.properties | has(\"id\"))\n  then .properties |= (with_entries(if .key == \"id\" then .key = \"_emodnetRowId\" else . end))\n  else . end;\nif .type == \"FeatureCollection\" then .features |= map(lift_row_id) else lift_row_id end\n",
            "stage": "pre"
          }
