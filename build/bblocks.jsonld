    {
      "itemIdentifier": "ogc.hosted.seadots.linkeddata.marineProtectionProperties",
      "name": "Marine Protection Properties",
      "abstract": "Attributes of a marine managed area in the ProtectedSeas Navigator dataset, including its designation, regulations, fishing protection level and the regulation status of fishing gears and marine activities, bound to the Marine Protections Ontology and the OGC Cross Domain Model.",
      "status": "under-development",
      "dateTimeAddition": "2026-11-03T00:00:00Z",
