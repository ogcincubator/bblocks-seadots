    {
      "itemIdentifier": "ogc.hosted.seadots.emodnet-compliant-windfarm-pl",
      "name": "Polish windfarm extension for EMODnet",
      "abstract": "Independent Polish windfarm integration block combining EMODnet fields with national project, reporting, provenance, and explicit location-crosswalk information. It supports EMODnet records and sparse national-source records, including unmatched projects with null geometry.",
