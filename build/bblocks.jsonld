      ],
      "group": "Protected Areas",
      "authors": [
        {
          "name": "SeaDOTs Marine Data Team",
          "organization": "SINTEF Ocean (SeaDOTs)"
        }
      ],
      "sources": [
        {
          "title": "HELCOM MADS Biodiversity layer 54: HELCOM MPAs",
          "link": "https://maps.helcom.fi/arcgis/rest/services/MADS/Biodiversity/MapServer/54"
        },
        {
          "title": "HELCOM MADS Biodiversity layer 190: Baltic Sea MPA network 2026",
          "link": "https://maps.helcom.fi/arcgis/rest/services/MADS/Biodiversity/MapServer/190"
        },
