          "link": "https://api.obis.org/v3/checklist"
        }
      ],
      "dependsOn": null,
      "ldContext": {
        "prof:hasArtifact": "https://ogcincubator.github.io/bblocks-seadots/build/annotated/hosted/seadots/obis-mareano-checklist/context.jsonld",
        "prof:hasRole": "role:mapping",
