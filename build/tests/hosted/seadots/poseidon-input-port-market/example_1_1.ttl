@prefix : <https://w3id.org/iliad/seadots/poseidon/input#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] schema:location ( [ schema:name "Main Port" ;
                :usingGridCoordinates true ;
                :x 40 ;
                :y 25 ] ) ;
    schema:offers [ :priceBySpecies [ :Species_0 10 ] ;
            :type "Fixed Price Market" ] ;
    :fuel [ :fuelPrice 1.2e+00 ;
            :gasPriceMaker "Fixed Gas Price" ] ;
    :portInitializerType "One Port" .

