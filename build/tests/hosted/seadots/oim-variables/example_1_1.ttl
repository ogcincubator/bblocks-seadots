indo:landing_value_sprat_LV a skos:Concept,
        sosa:ObservableProperty,
        ind:Indicator ;
    rdfs:label "Sprat landing value, Large vessel fleet"@en ;
    dcterms:subject ind:emodnet-human-activities ;
    qudt:hasQuantityKind quantitykind:Currency ;
    skos:altLabel "landing-value_sprat_LV"@en,
