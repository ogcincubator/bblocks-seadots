@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] dcterms:source [ dcterms:format "text/plain; delimiter=space; quote=double" ;
            skos:note "The supplied source carries NUTS region indicator columns but no row-level geometry. This header includes an approximate Swedish case-region footprint spanning northern Baltic/Bothnian Sea case waters southward to Gotland Island. A concrete GeoParquet writer should replace or refine this with authoritative Eurostat NUTS geometries before emitting WKB geometry." ;
            schema:numberOfColumns 63 ;
            schema:numberOfItems 60000 ;
            :href "examples/eurostat nuts regions.qgz" ] ;
    ns1:metadata [ :columns [ :geometry [ schema:encodingFormat "WKB" ;
                            :bbox 1.64e+01,
                                2.25e+01,
                                5.7e+01,
                                6.58e+01 ;
                            :covering [ :bbox [ :xmax "bbox",
                                                "xmax" ;
                                            :xmin "bbox",
                                                "xmin" ;
                                            :ymax "bbox",
                                                "ymax" ;
                                            :ymin "bbox",
                                                "ymin" ] ] ;
                            :crs [ :name "WGS 84" ;
                                    :type "GeographicCRS" ] ;
                            :edges "planar" ;
                            :exampleGeometryGeoJSON [ :coordinates "[16.4, 59.0]",
                                        "[17.0, 57.0]",
                                        "[17.6, 63.0]",
                                        "[19.0, 65.8]",
                                        "[19.2, 57.0]",
                                        "[20.6, 58.1]",
                                        "[21.6, 60.3]",
                                        "[21.8, 65.8]",
                                        "[22.5, 63.4]" ;
                                    :type "Polygon" ] ;
                            :geometry_types "MultiPolygon",
                                "Polygon" ;
                            :orientation "counterclockwise" ] ] ;
            :primary_column "geometry" ;
            :version "1.1.0" ] ;
