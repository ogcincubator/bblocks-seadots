<bblocks://ogc.hosted.seadots.colonisation-time-factor> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Colonisation Time Factor (C_t)" ;
    dct:abstract "OGC Feature + OIM Variable profile for the dimensionless time factor C_t in the reef-biomass equation. Encodes the colonisation curve as a closed-form expression (typically a logistic sigmoid) with its parameters plus an evaluated lookup table at discrete time points. Mandatory provenance flags whether the curve parameters are calibrated or illustrative."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-19T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/markdown" ;
