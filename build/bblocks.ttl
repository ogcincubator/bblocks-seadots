<bblocks://ogc.hosted.seadots.floating-wind-infrastructure> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Floating-Wind Submerged Infrastructure" ;
    dct:abstract "OGC Feature profile describing per-unit submerged geometry (wetted hull + mooring + anchor surfaces) of a floating-wind farm layout. Used as the feature-of-interest geometry input to reef-effect biomass equations (drives the A_sub aggregate). Inline `data` block carries per-unit areas, count, design label, aggregate submerged area, and sample unit coordinates; geometry travels in the top-level GeoJSON Polygon."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-19T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "application/json" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-seadots/build/generateddocs/json-full/hosted/seadots/floating-wind-infrastructure/index.json> ],
        [ dct:format "text/markdown" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-seadots/build/generateddocs/markdown/hosted/seadots/floating-wind-infrastructure/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-seadots/bblock/ogc.hosted.seadots.floating-wind-infrastructure> ] ;
    dct:hasVersion "0.1" ;
    dct:modified "2026-05-19"^^xsd:date ;
    dct:source <https://veiledere.nve.no/havvind/strategisk-konsekvensutredning-av-vindkraft-til-havs/> ;
    skos:inScheme <https://ogcincubator.github.io/bblocks-seadots/> ;
    skos:prefLabel "Floating-Wind Submerged Infrastructure" ;
    skos:topConceptOf <https://ogcincubator.github.io/bblocks-seadots/> ;
    dcat:keyword "OIM",
        "floating-wind",
        "infrastructure",
        "reef-effect",
        "submerged-area" ;
    prof:hasResource [ dct:conformsTo shacl: ;
            dct:format "text/turtle" ;
            rdfs:seeAlso <bblocks://ogc.geo.features.feature> ;
            prof:hasArtifact <https://opengeospatial.github.io/bblocks/registereditems/geo/features/feature/shapes.shacl> ;
            prof:hasRole role:validation ],
        [ dct:conformsTo shacl: ;
