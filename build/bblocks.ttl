<bblocks://ogc.hosted.seadots.experiment-output> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Computational Experiment Output" ;
    dct:abstract "OGC API Records profile for describing a single output artefact produced by a computational experiment. Captures the kind of output (primary result, catalog, provenance), the format, the vocabulary term for the produced quantity, and the URI of the experiment that produced it. Carries inline result values with mandatory provenance (computed / retrieved / illustrative / mixed). Designed to be referenced by an `experiment` record so that one output definition can be reused across runs and audits."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-18T00:00:00+00:00"^^xsd:dateTime ;
