<https://ogcincubator.github.io/bblocks-seadots/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Seadots project" ;
    dct:abstract """This is a collection of OGC Blocks for the [SeaDOTs project](http://seadots-project.eu).
It defines the indicator model, property relationship schema, and supporting ontologies
used across the three SeaDOTs Digital Twin demonstrators (Germany, Norway, Sweden).
See also: [iliad-apis-features](https://github.com/ogcincubator/iliad-apis-features) for data types and DT processes.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-05-26T19:08:16.214978"^^xsd:dateTime ;
    void:sparqlEndpoint <http://defs-hosted.opengis.net/fuseki-hosted/query> ;
    owl:imports <https://ogcincubator.github.io/bblocks-ogcapi-processes/build/register.json>,
        <https://ogcincubator.github.io/bblocks-openscience/build/register.json>,
        <https://ogcincubator.github.io/bblocks-sta/build/register.json>,
        <https://ogcincubator.github.io/bblocks-stac/build/register.json>,
