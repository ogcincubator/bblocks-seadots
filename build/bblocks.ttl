<bblocks://ogc.hosted.seadots.area-of-interest> a skos:Concept,
        dcat:Dataset,
        bblocks:BBlock,
        bblocks:Schema ;
    rdfs:label "Marine Area of Interest" ;
    dct:abstract "OGC Feature profile for a polygon delimiting a marine area of interest (AOI) used by experiments, monitoring programmes, or impact assessments. Carries the bbox, centroid, area, and CRS as a self-contained inline `data` block with mandatory provenance. Geometry travels in the top-level GeoJSON `geometry` field."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:created "2026-05-19T00:00:00+00:00"^^xsd:dateTime ;
    dct:description [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/bblocks-seadots/bblock/ogc.hosted.seadots.area-of-interest> ],
        [ dct:format "application/json" ;
