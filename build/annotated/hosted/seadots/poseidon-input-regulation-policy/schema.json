{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POSEIDON Regulation and Policy Input",
  "description": "Management-policy and regulation input applied to POSEIDON scenarios.",
  "type": "object",
  "properties": {
    "regulations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "examples": [
              "Seasonal Closure",
              "Protected Area",
              "Quota",
              "Gear Restriction"
            ]
          },
          "startDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          },
          "endDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 366
          },
          "species": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "x-jsonld-id": "https://schema.org/about",
            "x-jsonld-container": "@list"
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": true
          },
          "actions": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "x-jsonld-id": "https://schema.org/legislation",
      "x-jsonld-container": "@list"
    },
    "shocks": {
      "type": "array",
      "description": "Time-varying interventions or exogenous changes applied during a run.",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "x-jsonld-id": "https://schema.org/event",
      "x-jsonld-container": "@list"
    }
  },
  "additionalProperties": true,
  "x-jsonld-vocab": "https://w3id.org/iliad/seadots/poseidon/input#",
  "x-jsonld-prefixes": {
    "schema": "https://schema.org/"
  }
}