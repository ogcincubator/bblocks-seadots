@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix osmwind: <https://w3id.org/ogc/hosted/seadots/emodnet-windfarm-osm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

osmwind:OffshoreProductionArea a owl:Class ;
    dcterms:source <https://metanorma.github.io/iho-s-101/documents/2.0.0/annex-a/document.html> ;
    skos:closeMatch <https://metanorma.github.io/iho-s-101/documents/2.0.0/annex-a/document.html> ;
    skos:definition "An OSM feature supported by source tags as an offshore wind-farm production area."@en ;
    skos:prefLabel "Offshore Production Area (OSPARE)"@en .

osmwind:WindTurbine a owl:Class ;
    dcterms:source <https://portal.iho.int/iho-ohi/S32/engView.php?page=303> ;
    skos:closeMatch <https://metanorma.github.io/iho-s-101/documents/2.0.0/annex-a/document.html>,
        <https://portal.iho.int/iho-ohi/S32/engView.php?page=303> ;
    skos:definition "An OSM node explicitly tagged with generator:method=wind_turbine, aligned with the IHO wind-turbine definition."@en ;
    skos:prefLabel "Wind Turbine (LNDMRK)"@en .

osmwind:categoryOfOffshoreProductionArea a rdf:Property ;
    dcterms:source <https://registry.iho.int/fdd/view3.do?idx=42&type=3> ;
    skos:closeMatch <https://registry.iho.int/fdd/view3.do?idx=42&type=3> ;
    skos:prefLabel "Category of Offshore Production Area"@en .

osmwind:featureRole a rdf:Property ;
    rdfs:label "IHO aligned feature role"@en ;
    rdfs:comment "A source-evidence-based association to a local concept aligned with an IHO feature label; it does not assert S-101 conformance."@en .

osmwind:windFarmCategory a skos:Concept ;
    skos:closeMatch <https://registry.iho.int/fdd/view5.do?idx=341&type=5&valueType=0> ;
    skos:inScheme <https://registry.iho.int/fdd/view3.do?idx=42&type=3> ;
    skos:notation "1" ;
    skos:prefLabel "Wind Farm"@en .

