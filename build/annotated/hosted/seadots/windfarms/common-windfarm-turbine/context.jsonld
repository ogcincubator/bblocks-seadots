{
  "@context": {
    "Feature": "geojson:Feature",
    "FeatureCollection": "geojson:FeatureCollection",
    "GeometryCollection": "geojson:GeometryCollection",
    "LineString": "geojson:LineString",
    "MultiLineString": "geojson:MultiLineString",
    "MultiPoint": "geojson:MultiPoint",
    "MultiPolygon": "geojson:MultiPolygon",
    "Point": "geojson:Point",
    "Polygon": "geojson:Polygon",
    "features": {
      "@container": "@set",
      "@id": "geojson:features"
    },
    "type": "@type",
    "id": "@id",
    "properties": "@nest",
    "geometry": "geojson:geometry",
    "bbox": {
      "@container": "@list",
      "@id": "geojson:bbox"
    },
    "links": {
      "@context": {
        "href": {
          "@type": "@id",
          "@id": "oa:hasTarget"
        },
        "rel": {
          "@context": {
            "@base": "http://www.iana.org/assignments/relation/"
          },
          "@id": "http://www.iana.org/assignments/relation",
          "@type": "@id"
        },
        "type": "dct:type",
        "hreflang": "dct:language",
        "title": "rdfs:label",
        "length": "dct:extent"
      },
      "@id": "rdfs:seeAlso"
    },
    "ref": "owf:turbineReference",
    "windfarm_name": "owf:windfarmName",
    "windfarm": {
      "@id": "owf:partOfWindfarm",
      "@type": "@id"
    },
    "manufacturer": "owf:manufacturerName",
    "model": "owf:modelName",
    "rated_power_mw": {
      "@id": "owf:ratedPowerMW",
      "@type": "xsd:decimal"
    },
    "hub_height_m": {
      "@id": "owf:hubHeight",
      "@type": "xsd:decimal"
    },
    "rotor_diameter_m": {
      "@id": "owf:rotorDiameter",
      "@type": "xsd:decimal"
    },
    "rotor_axis": {
      "@id": "owf:rotorAxis",
      "@type": "@vocab"
    },
    "offshore": {
      "@id": "owf:offshore",
      "@type": "xsd:boolean"
    },
    "operator": {
      "@id": "owf:operatorName",
      "@container": "@set"
    },
    "status": {
      "@id": "owf:conditionOfFacility",
      "@type": "@vocab"
    },
    "last_updated": {
      "@id": "dct:modified",
      "@type": "xsd:dateTime"
    },
    "commissioning_year": {
      "@id": "owf:commissioningYear",
      "@type": "xsd:gYear"
    },
    "coordinates": {
      "@id": "geojson:coordinates",
      "@container": "@list"
    },
    "WindTurbine": "owf:WindTurbine",
    "horizontal_axis": "owf:HorizontalAxis",
    "vertical_axis": "owf:VerticalAxis",
    "projected": "inspire-cofv:projected",
    "underConstruction": "inspire-cofv:underConstruction",
    "functional": "inspire-cofv:functional",
    "disused": "inspire-cofv:disused",
    "decommissioned": "inspire-cofv:decommissioned",
    "geojson": "https://purl.org/geojson/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "oa": "http://www.w3.org/ns/oa#",
    "dct": "http://purl.org/dc/terms/",
    "owf": "https://w3id.org/ogc/hosted/seadots/windfarm/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "inspire-cofv": "http://inspire.ec.europa.eu/codelist/ConditionOfFacilityValue/",
    "dcterms": "http://purl.org/dc/terms/",
    "@version": 1.1
  }
}