{
  "@context": {
    "@vocab": "https://w3id.org/ogc/hosted/seadots/emodnet/",
    "Feature": "geojson:Feature",
    "FeatureCollection": "geojson:FeatureCollection",
    "GeometryCollection": "geojson:GeometryCollection",
    "LineString": "geojson:LineString",
    "MultiLineString": "geojson:MultiLineString",
    "MultiPoint": "geojson:MultiPoint",
    "MultiPolygon": "geojson:MultiPolygon",
    "Point": "geojson:Point",
    "Polygon": "geojson:Polygon",
    "features": {
      "@container": "@set",
      "@id": "geojson:features"
    },
    "type": "@type",
    "id": "@id",
    "properties": "@nest",
    "geometry": "geojson:geometry",
    "bbox": {
      "@container": "@list",
      "@id": "geojson:bbox"
    },
    "links": {
      "@context": {
        "href": {
          "@type": "@id",
          "@id": "oa:hasTarget"
        },
        "rel": {
          "@context": {
            "@base": "http://www.iana.org/assignments/relation/"
          },
          "@id": "http://www.iana.org/assignments/relation",
          "@type": "@id"
        },
        "type": "dct:type",
        "hreflang": "dct:language",
        "title": "rdfs:label",
        "length": "dct:extent"
      },
      "@id": "rdfs:seeAlso"
    },
    "coordinates": {
      "@id": "geojson:coordinates",
      "@container": "@list"
    },
    "WindfarmArea": "owf:WindfarmArea",
    "osm": "owf:OpenStreetMapSource",
    "emodnet": "owf:EmodnetSource",
    "national": "owf:NationalSource",
    "source-provided": "owf:LocationSourceProvided",
    "mapped": "owf:LocationMapped",
    "anticipated": "owf:LocationAnticipated",
    "unmatched": "owf:LocationUnmatched",
    "geojson": "https://purl.org/geojson/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "oa": "http://www.w3.org/ns/oa#",
    "dct": "http://purl.org/dc/terms/",
    "owf": "https://w3id.org/ogc/hosted/seadots/windfarm#",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "prov": "http://www.w3.org/ns/prov#",
    "name": "dct:title",
    "country": {
      "@context": {
        "@vocab": "https://w3id.org/ogc/hosted/seadots/emodnet/"
      },
      "@id": "owf:country",
      "@type": "@vocab"
    },
    "n_turbines": {
      "@id": "owf:nTurbines",
      "@type": "xsd:integer"
    },
    "power_mw": {
      "@id": "owf:powerMW",
      "@type": "xsd:decimal"
    },
    "status": {
      "@id": "owf:conditionOfFacility",
      "@type": "@vocab"
    },
    "status_detail": "owf:statusDetail",
    "status_as_of": {
      "@id": "owf:statusAsOf",
      "@type": "xsd:date"
    },
    "type_inst": "owf:installationType",
    "offshore": {
      "@id": "owf:offshore",
      "@type": "xsd:boolean"
    },
    "year": "owf:year",
    "year_semantics": "owf:yearSemantics",
    "year_is_assumed": {
      "@id": "owf:yearIsAssumed",
      "@type": "xsd:boolean"
    },
    "updateyear": "owf:updateYear",
    "operational_date": {
      "@id": "owf:operationalDate",
      "@type": "xsd:date"
    },
    "valid_from": {
      "@id": "owf:validFrom",
      "@type": "xsd:date"
    },
    "dist_coast": {
      "@id": "owf:distanceToCoast",
      "@type": "xsd:decimal"
    },
    "area_sqkm": {
      "@id": "owf:areaSqKm",
      "@type": "xsd:decimal"
    },
    "operator": {
      "@id": "owf:operatorName",
      "@container": "@set"
    },
    "owner": "owf:ownerName",
    "developer": "owf:developerName",
    "licence_status": "owf:licenceStatus",
    "licensing_case": {
      "@id": "owf:licensingCase",
      "@type": "@id"
    },
    "admin_units": {
      "@id": "owf:administrativeUnit",
      "@container": "@set"
    },
    "electricity_price_area": "owf:electricityPriceArea",
    "mean_annual_production_gwh": {
      "@id": "owf:meanAnnualProductionGWh",
      "@type": "xsd:decimal"
    },
    "notes": "dct:description",
    "source_type": {
      "@id": "owf:sourceType",
      "@type": "@vocab"
    },
    "source_dataset": "owf:sourceDataset",
    "source_reference": {
      "@id": "dct:source",
      "@type": "@id"
    },
    "source_record_id": "dct:identifier",
    "source_snapshot_date": {
      "@id": "owf:sourceSnapshotDate",
      "@type": "xsd:date"
    },
    "last_updated": {
      "@id": "dct:modified",
      "@type": "xsd:dateTime"
    },
    "update_date": {
      "@id": "dct:modified",
      "@type": "xsd:date"
    },
    "metadata_record": {
      "@id": "foaf:isPrimaryTopicOf",
      "@type": "@id"
    },
    "location_status": {
      "@id": "owf:locationStatus",
      "@type": "@vocab"
    },
    "location_method": "owf:locationMethod",
    "location_reference": {
      "@id": "owf:locationReference",
      "@type": "@id"
    },
    "positional_accuracy_m": {
      "@id": "owf:positionalAccuracyM",
      "@type": "xsd:decimal"
    },
    "same_as": {
      "@id": "prov:alternateOf",
      "@type": "@id",
      "@container": "@set"
    },
    "@version": 1.1
  }
}