@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix osmdata: <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source#> .
@prefix osmkey: <https://www.openstreetmap.org/wiki/Key:> .
@prefix owf: <https://w3id.org/ogc/hosted/seadots/windfarm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix seadots-emodnet: <https://w3id.org/ogc/hosted/seadots/emodnet/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

osmdata:Node a owl:Class ;
    rdfs:label "node"@en ;
    rdfs:comment "OSM element representing a single point, defined by latitude and longitude."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Node> ;
    rdfs:subClassOf osmdata:Element .

osmdata:WindfarmElement a owl:Class ;
    rdfs:label "OSM wind farm element"@en ;
    rdfs:comment "A way or relation tagged as a wind farm. A way that is an outer member of a wind farm relation, or has the same name as one, is part of that relation's wind farm; the relation is the primary element, the ways are linked with prov:alternateOf, and the first area way gives the geometry."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:subClassOf osmdata:Element ;
    owl:equivalentClass [ owl:intersectionOf ( osmdata:Element [ a owl:Restriction ;
                        owl:onProperty osmdata:tagSet ;
                        owl:someValuesFrom [ owl:unionOf ( [ a owl:Restriction ;
                                            owl:hasValue "wind" ;
                                            owl:onProperty <https://www.openstreetmap.org/wiki/Key:plant:source> ] [ a owl:Restriction ;
                                            owl:hasValue "windfarm" ;
                                            owl:onProperty osmkey:industrial ] [ a owl:Restriction ;
                                            owl:hasValue "wind_farm" ;
                                            owl:onProperty <https://www.openstreetmap.org/wiki/Key:seamark:landmark:production_area> ] ) ] ] ) ] ;
    skos:closeMatch owf:WindfarmArea ;
    osmdata:selectionRules ( osmdata:sel-plant-source osmdata:sel-industrial osmdata:sel-seamark ) .

osmdata:apiVersion a owl:DatatypeProperty ;
    rdfs:label "API version"@en ;
    rdfs:comment "Version of the OSM API that produced the response, e.g. \"0.6\"."@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:string .

osmdata:bounds a owl:ObjectProperty ;
    rdfs:label "bounds"@en ;
    rdfs:comment "Bounding box of the request that produced the response."@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range osmdata:Bounds ;
    skos:relatedMatch dcterms:source .

osmdata:changeset a owl:DatatypeProperty ;
    rdfs:label "changeset"@en ;
    rdfs:comment "Numeric identifier of the changeset in which this element version was created."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:integer ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Changeset> .

osmdata:conversion a owl:ObjectProperty ;
    rdfs:label "conversion"@en ;
    rdfs:domain osmdata:TagMapping ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range osmdata:Conversion .

osmdata:element a owl:ObjectProperty ;
    rdfs:label "element"@en ;
    rdfs:comment "OSM element returned in the response."@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range osmdata:Element .

osmdata:elementIdentifier a owl:DatatypeProperty ;
    rdfs:label "element identifier"@en ;
    rdfs:comment "Numeric OSM identifier of an element. It is unique only within its element type, so it identifies an element only together with the element's class."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:integer ;
    skos:relatedMatch dcterms:identifier .

osmdata:elementVersion a owl:DatatypeProperty ;
    rdfs:label "element version"@en ;
    rdfs:comment "Version number of the element, incremented on each edit."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:integer .

osmdata:fallback a owl:ObjectProperty ;
    rdfs:label "fallback"@en ;
    rdfs:comment "Conversion applied when no source key has a value."@en ;
    rdfs:domain osmdata:TagMapping ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range osmdata:Conversion .

osmdata:generator a owl:DatatypeProperty ;
    rdfs:label "generator"@en ;
    rdfs:comment "Power generator device?"@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:string .

osmdata:maxlat a owl:DatatypeProperty ;
    rdfs:label "maximum latitude"@en ;
    rdfs:comment "Northern edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:decimal .

osmdata:maxlon a owl:DatatypeProperty ;
    rdfs:label "maximum longitude"@en ;
    rdfs:comment "Eastern edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:decimal .

osmdata:memberReference a owl:DatatypeProperty ;
    rdfs:label "member reference"@en ;
    rdfs:comment "Numeric identifier of the referenced member, interpreted within the type given by osmdata:memberType."@en ;
    rdfs:domain osmdata:RelationMember ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:integer .

osmdata:memberRole a owl:DatatypeProperty ;
    rdfs:label "member role"@en ;
    rdfs:comment "Role of the member within the relation, e.g. \"outer\" or \"inner\"; may be empty."@en ;
    rdfs:domain osmdata:RelationMember ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Relation#Roles> .

osmdata:memberType a owl:ObjectProperty ;
    rdfs:label "member type"@en ;
    rdfs:comment "Element class of the referenced member: osmdata:Node, osmdata:Way, or osmdata:Relation."@en ;
    rdfs:domain osmdata:RelationMember ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range owl:Class .

osmdata:minlat a owl:DatatypeProperty ;
    rdfs:label "minimum latitude"@en ;
    rdfs:comment "Southern edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:decimal .

osmdata:minlon a owl:DatatypeProperty ;
    rdfs:label "minimum longitude"@en ;
    rdfs:comment "Western edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:decimal .

osmdata:nodeReference a owl:ObjectProperty ;
    rdfs:label "node reference"@en ;
    rdfs:comment "Ordered list (rdf:List) of numeric node identifiers that define a way."@en ;
    rdfs:domain osmdata:Way ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range rdf:List .

osmdata:relationMember a owl:ObjectProperty ;
    rdfs:label "relation member"@en ;
    rdfs:comment "Ordered list (rdf:List) of the members of a relation."@en ;
    rdfs:domain osmdata:Relation ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range rdf:List .

osmdata:ruleKey a owl:ObjectProperty ;
    rdfs:label "rule key"@en ;
    rdfs:domain osmdata:ValueRule ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range rdf:Property .

osmdata:ruleValue a owl:DatatypeProperty ;
    rdfs:label "rule value"@en ;
    rdfs:comment "Source tag value the rule matches; omitted to match any value."@en ;
    rdfs:domain osmdata:ValueRule ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:string .

osmdata:selectionRules a owl:AnnotationProperty ;
    rdfs:label "selection rules"@en ;
    rdfs:comment "Any matching rule selects an element; machine-readable form of the class definition."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:sourceKeys a owl:ObjectProperty ;
    rdfs:label "source keys"@en ;
    rdfs:comment "Ordered list (rdf:List) of OSM tag key properties; the first key with a value is used."@en ;
    rdfs:domain osmdata:TagMapping ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range rdf:List .

osmdata:targetKey a owl:DatatypeProperty ;
    rdfs:label "target JSON key"@en ;
    rdfs:comment "JSON property name in the target block, i.e. the context term for osmdata:targetProperty."@en ;
    rdfs:domain osmdata:TagMapping ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:string .

osmdata:targetProperty a owl:ObjectProperty ;
    rdfs:label "target property"@en ;
    rdfs:comment "The ontology property the mapping produces."@en ;
    rdfs:domain osmdata:TagMapping ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range rdf:Property .

osmdata:uid a owl:DatatypeProperty ;
    rdfs:label "user identifier"@en ;
    rdfs:comment "Numeric identifier of the user who last edited the element."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:integer .

osmdata:user a owl:DatatypeProperty ;
    rdfs:label "user"@en ;
    rdfs:comment "Display name of the user who last edited the element. Display names can change; osmdata:uid is the stable identifier."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:string .

osmdata:valueRules a owl:ObjectProperty ;
    rdfs:label "value rules"@en ;
    rdfs:comment "Ordered list (rdf:List) of osmdata:ValueRule; the first rule whose key/value matches gives the target value."@en ;
    rdfs:domain osmdata:TagMapping ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range rdf:List .

osmdata:whenPresent a owl:DatatypeProperty ;
    rdfs:label "constant when present"@en ;
    rdfs:comment "Constant target value written when the mapping's source key has a value (used for explanatory fields)."@en ;
    rdfs:domain osmdata:TagMapping ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range xsd:string .

osmdata:windfarmTagMappings a owl:AnnotationProperty ;
    rdfs:label "windfarm tag mappings"@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:yields a rdf:Property ;
    rdfs:label "yields"@en ;
    rdfs:comment "Target value of a rule: a concept (written as its local name), a literal, or osmdata:KeyEqualsValue."@en ;
    rdfs:domain osmdata:ValueRule ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

