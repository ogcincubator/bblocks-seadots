osmdata:CountGeneratorMembers a osmdata:Conversion ;
    rdfs:label "count generator members"@en ;
    rdfs:comment "Number of relation members with role generator; null when there are none."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:KeyEqualsValue a owl:NamedIndividual ;
    rdfs:label "key=value"@en ;
    rdfs:comment "Rule result: the matched tag written as key=value."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:ParseInteger a osmdata:Conversion ;
    rdfs:label "parse integer"@en ;
    rdfs:comment "The tag value read as an integer; null when it is not one."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:ParseMegawatts a osmdata:Conversion ;
    rdfs:label "parse megawatts"@en ;
    rdfs:comment "A number with optional unit MW, e.g. \"720 MW\" -> 720; null for any other unit or text."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:Relation a owl:Class ;
    rdfs:label "relation"@en ;
    rdfs:comment "OSM element grouping other elements as an ordered list of role-labelled members."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Relation> ;
    rdfs:subClassOf osmdata:Element .

osmdata:SplitSemicolon a osmdata:Conversion ;
    rdfs:label "split on semicolon"@en ;
    rdfs:comment "The OSM multi-value convention: split on ';' and trim, giving an array."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:Way a owl:Class ;
    rdfs:label "way"@en ;
    rdfs:comment "OSM element defined by an ordered list of node references; a closed way repeats its first node last."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Way> ;
    rdfs:subClassOf osmdata:Element .

osmdata:map-n-turbines a osmdata:TagMapping ;
    osmdata:conversion osmdata:ParseInteger ;
    osmdata:fallback osmdata:CountGeneratorMembers ;
    osmdata:sourceKeys ( osmkey:turbines ) ;
    osmdata:targetKey "n_turbines" ;
    osmdata:targetProperty owf:nTurbines .

osmdata:map-name a osmdata:TagMapping ;
    osmdata:conversion osmdata:Copy ;
    osmdata:sourceKeys ( <https://www.openstreetmap.org/wiki/Key:name:> <https://www.openstreetmap.org/wiki/Key:seamark:name> ) ;
    osmdata:targetKey "name" ;
    osmdata:targetProperty dcterms:title .

osmdata:map-offshore a osmdata:TagMapping ;
    osmdata:targetKey "offshore" ;
    osmdata:targetProperty owf:offshore ;
    osmdata:valueRules ( [ a osmdata:ValueRule ;
                osmdata:ruleKey osmkey:offshore ;
                osmdata:ruleValue "yes" ;
                osmdata:yields true ] [ a osmdata:ValueRule ;
                osmdata:ruleKey <https://www.openstreetmap.org/wiki/Key:plant:type> ;
                osmdata:ruleValue "offshore" ;
                osmdata:yields true ] ) .

osmdata:map-operator a osmdata:TagMapping ;
    osmdata:conversion osmdata:SplitSemicolon ;
    osmdata:sourceKeys ( osmkey:operator ) ;
    osmdata:targetKey "operator" ;
    osmdata:targetProperty owf:operatorName .

osmdata:map-power a osmdata:TagMapping ;
    osmdata:conversion osmdata:ParseMegawatts ;
    osmdata:sourceKeys ( <https://www.openstreetmap.org/wiki/Key:plant:output:electricity> ) ;
    osmdata:targetKey "power_mw" ;
    osmdata:targetProperty owf:powerMW .

osmdata:map-status a osmdata:TagMapping ;
    osmdata:targetKey "status" ;
    osmdata:targetProperty owf:conditionOfFacility ;
    osmdata:valueRules ( [ a osmdata:ValueRule ;
                osmdata:ruleKey <https://www.openstreetmap.org/wiki/Key:construction:power> ;
                osmdata:ruleValue "plant" ;
                osmdata:yields seadots-emodnet:Construction ] [ a osmdata:ValueRule ;
                osmdata:ruleKey osmkey:status ;
                osmdata:ruleValue "construction" ;
                osmdata:yields seadots-emodnet:Construction ] [ a osmdata:ValueRule ;
                osmdata:ruleKey osmkey:power ;
                osmdata:ruleValue "plant" ;
                osmdata:yields seadots-emodnet:Production ] ) .

osmdata:map-status-detail a osmdata:TagMapping ;
    osmdata:targetKey "status_detail" ;
    osmdata:targetProperty owf:statusDetail ;
    osmdata:valueRules ( [ a osmdata:ValueRule ;
                osmdata:ruleKey osmkey:status ;
                osmdata:yields osmdata:Copy ] [ a osmdata:ValueRule ;
                osmdata:ruleKey <https://www.openstreetmap.org/wiki/Key:construction:power> ;
                osmdata:yields osmdata:KeyEqualsValue ] ) .

osmdata:map-year a osmdata:TagMapping ;
    osmdata:conversion osmdata:Copy ;
    osmdata:sourceKeys ( osmkey:start_date ) ;
    osmdata:targetKey "year" ;
    osmdata:targetProperty owf:year .

osmdata:map-year-semantics a osmdata:TagMapping ;
    osmdata:sourceKeys ( osmkey:start_date ) ;
    osmdata:targetKey "year_semantics" ;
    osmdata:targetProperty owf:yearSemantics ;
    osmdata:whenPresent "planned start of operation (OSM start_date)" .

osmdata:sel-industrial a osmdata:ValueRule ;
    osmdata:ruleKey osmkey:industrial ;
    osmdata:ruleValue "windfarm" .

osmdata:sel-plant-source a osmdata:ValueRule ;
    osmdata:ruleKey <https://www.openstreetmap.org/wiki/Key:plant:source> ;
    osmdata:ruleValue "wind" .

osmdata:sel-seamark a osmdata:ValueRule ;
    osmdata:ruleKey <https://www.openstreetmap.org/wiki/Key:seamark:landmark:production_area> ;
    osmdata:ruleValue "wind_farm" .

osmdata:tagSet a owl:ObjectProperty ;
    rdfs:label "tag set"@en ;
    rdfs:comment "Key-value tags of the element."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:range osmdata:TagSet ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Tags> .

<https://www.openstreetmap.org/wiki/Key:name:> a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:name> ;
    owl:equivalentProperty osmkey:name ;
    skos:closeMatch dcterms:title ;
    skos:notation "name" .

osmkey:offshore a owl:DatatypeProperty ;
    rdfs:label "offshore" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:offshore> ;
    skos:closeMatch owf:offshore ;
    skos:notation "offshore" .

osmkey:operator a owl:DatatypeProperty ;
    rdfs:label "operator" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:operator> ;
    skos:closeMatch owf:operatorName ;
    skos:notation "operator" .

<https://www.openstreetmap.org/wiki/Key:plant:output:electricity> a owl:DatatypeProperty ;
    rdfs:label "plant:output:electricity" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:plant:output:electricity> ;
    skos:closeMatch owf:powerMW ;
    skos:notation "plant:output:electricity" .

<https://www.openstreetmap.org/wiki/Key:plant:type> a owl:DatatypeProperty ;
    rdfs:label "plant:type" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:plant:type> ;
    skos:notation "plant:type" .

osmkey:power a owl:DatatypeProperty ;
    rdfs:label "power" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:power> ;
    skos:notation "power" ;
    skos:relatedMatch owf:conditionOfFacility .

<https://www.openstreetmap.org/wiki/Key:seamark:name> a owl:DatatypeProperty ;
    rdfs:label "seamark:name" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:seamark:name> ;
    skos:closeMatch dcterms:title ;
    skos:notation "seamark:name" .

osmkey:turbines a owl:DatatypeProperty ;
    rdfs:label "turbines" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:turbines> ;
    skos:closeMatch owf:nTurbines ;
    skos:notation "turbines" .

<https://www.openstreetmap.org/wiki/Key:construction:power> a owl:DatatypeProperty ;
    rdfs:label "construction:power" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:construction:power> ;
    skos:notation "construction:power" ;
    skos:relatedMatch owf:conditionOfFacility .

osmkey:industrial a owl:DatatypeProperty ;
    rdfs:label "industrial" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:industrial> ;
    skos:notation "industrial" .

<https://www.openstreetmap.org/wiki/Key:plant:source> a owl:DatatypeProperty ;
    rdfs:label "plant:source" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:plant:source> ;
    skos:notation "plant:source" .

<https://www.openstreetmap.org/wiki/Key:seamark:landmark:production_area> a owl:DatatypeProperty ;
    rdfs:label "seamark:landmark:production_area" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:seamark:landmark:production_area> ;
    skos:notation "seamark:landmark:production_area" .

osmkey:start_date a owl:DatatypeProperty ;
    rdfs:label "start_date" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:start_date> ;
    skos:closeMatch owf:year ;
    skos:notation "start_date" .

osmkey:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:status> ;
    skos:notation "status" ;
    skos:relatedMatch owf:conditionOfFacility .

osmdata:Copy a osmdata:Conversion ;
    rdfs:label "copy"@en ;
    rdfs:comment "The tag value unchanged."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:RelationMember a owl:Class ;
    rdfs:label "relation member"@en ;
    rdfs:comment "Reference from a relation to a member element, given by member type, numeric identifier, and role. It is a reference, not the member element itself."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:MapResponse a owl:Class ;
    rdfs:label "OSM map response"@en ;
    rdfs:comment "Response body of the OSM API 0.6 map call for a bounding box, carrying API metadata, the request bounds, and the returned elements."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/API_v0.6#Retrieving_map_data_by_bounding_box:_GET_/api/0.6/map> .

osmdata:Bounds a owl:Class ;
    rdfs:label "bounds"@en ;
    rdfs:comment "Bounding box of an OSM map request in WGS 84 decimal degrees."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:Conversion a owl:Class ;
    rdfs:label "value conversion"@en ;
    rdfs:comment "How a source tag value is turned into the target value."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:Element a owl:Class ;
    rdfs:label "OSM element"@en ;
    rdfs:comment "Basic component of the OpenStreetMap data model: a node, way, or relation. Identifiers are unique only within each element type."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Elements> .

osmdata:ValueRule a owl:Class ;
    rdfs:label "value rule"@en ;
    rdfs:comment "Maps one OSM tag key/value pair to a target value."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:TagMapping a owl:Class ;
    rdfs:label "tag mapping"@en ;
    rdfs:comment "Maps one or more OSM tag keys of a wind farm element onto one owf property and the corresponding JSON property of the target block."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

<https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> a owl:Ontology ;
    rdfs:label "OpenStreetMap API 0.6 source vocabulary"@en ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:creator "SeaDOTs Marine Data Team" ;
    dcterms:description "Terms used by the SeaDOTs JSON-LD context for unconverted OpenStreetMap API 0.6 map responses: response metadata, request bounds, nodes, ways, relations, relation members, and edit metadata. Tag keys and values are kept as an uninterpreted JSON literal."@en ;
    dcterms:source <https://wiki.openstreetmap.org/wiki/API_v0.6>,
        <https://wiki.openstreetmap.org/wiki/Elements> ;
    dcterms:title "OpenStreetMap API 0.6 source vocabulary"@en ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/OSM_JSON> ;
    owl:imports <https://w3id.org/ogc/hosted/seadots/windfarm> ;
    owl:versionInfo "0.1" ;
    osmdata:windfarmTagMappings ( osmdata:map-name osmdata:map-n-turbines osmdata:map-power osmdata:map-status osmdata:map-status-detail osmdata:map-offshore osmdata:map-year osmdata:map-year-semantics osmdata:map-operator ) .

osmdata:TagSet a owl:Class ;
    rdfs:label "tag set"@en ;
    rdfs:comment "Set of key-value tags of an OSM element. Each tag is a property whose IRI is the OSM key appended to <https://www.openstreetmap.org/wiki/Key:> (the osm2rdf convention, e.g. osmkey:plant:source); values are the uninterpreted source strings."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://github.com/ad-freiburg/osm2rdf>,
        <https://wiki.openstreetmap.org/wiki/Tags> .

