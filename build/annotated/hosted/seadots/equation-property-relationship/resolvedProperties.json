{"defs":{},"properties":[{"path":["id"],"id":"@id","description":"Identifier (IRI or CURIE) for this equation record.","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"@id"},{"path":["type"],"id":"@type","description":"Relationship type. Use EquationPropertyRelationship, optionally alongside PropertyRelationship.","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"@type"},{"path":["relationshipKind"],"id":"https://schema.org/additionalType","description":"Discriminator for equation-based relationships.","const":"equation","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://schema.org/additionalType"},{"path":["fromProperty"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/fromProperty","jsonld_type":"@id","description":"Optional. Use when the record focuses on one specific symbol-edge of the equation (a sensitivity / cross-impact reading); it must then match exactly one entry in `symbols[]` by its `fromProperty`. Omit when the record describes the equation as a whole \u2014 the full table is in `symbols[]` and there is no single \"from\".\n","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/fromProperty"},{"path":["toProperty"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/toProperty","jsonld_type":"@id","description":"IRI or CURIE of the derived target property calculated by the equation.","required":true,"sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/toProperty"},{"path":["equation"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasEquation","description":"Canonical mathematical expression. It should match schema:mathExpression on the target property definition.","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasEquation"},{"path":["symbols"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasEquationSymbol","description":"Complete symbol table for `equation`: one entry per symbol used in the expression. The primary symbol (the one this record is about) is the entry whose `fromProperty` equals the top-level `fromProperty`. The other entries are the rest of the table, with their own bindings, so the record is computationally self-contained.\n","required":true,"schema_type":"array","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasEquationSymbol"},{"path":["symbols","symbol"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasSymbol","description":"LaTeX symbol as it occurs literally in `equation`.","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasSymbol"},{"path":["symbols","symbolAliases"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasSymbolAlias","description":"Alternative renderings (ASCII variants, plain forms).","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasSymbolAlias"},{"path":["symbols","fromProperty"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/fromProperty","jsonld_type":"@id","description":"Abstract Rainbow IRI for this symbol.","required":true,"sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/fromProperty"},{"path":["symbols","variableKind"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasVariableKind","jsonld_type":"@vocab","description":"Semantic role of the symbol in the equation.\n","schema_type":"string","enum":["featureOfInterest","intensiveQuantity","extensiveQuantity","adjustmentFactor","timeCoefficient","rateCoefficient","uncertaintyFactor","aggregationIndex"],"sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasVariableKind"},{"path":["symbols","dimensionKind"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasDimensionKind","jsonld_type":"@id","description":"Unit-abstract dimensional type as a QUDT QuantityKind URI (e.g. `quantitykind:Area`, `quantitykind:AreaDensity`, `quantitykind:Dimensionless`, `quantitykind:Time`, `quantitykind:Frequency`). Decouples dimensional analysis from unit selection.\n","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasDimensionKind"},{"path":["symbols","indexed"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/isIndexed","description":"True if the term is iterated under the aggregation index of toProperty (e.g. per-taxon `D_{pre,i}`).\n","schema_type":"boolean","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/isIndexed"},{"path":["symbols","index"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasIndex","description":"Index symbol, e.g. \"i\". Only meaningful when `indexed` is true.","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasIndex"},{"path":["symbols","indexedBy"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasIndexedBy","jsonld_type":"@id","description":"IRI of the entity class whose instances enumerate the index (e.g. `odd:TaxonGroup`). Required when `indexed` is true.\n","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasIndexedBy"},{"path":["symbols","equationRole"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasEquationRole","jsonld_type":"@vocab","description":"Role this symbol plays in the equation.","schema_type":"string","enum":["input","coefficient","normaliser","lossTerm","uncertaintyTerm","qualityTerm","output","other"],"sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasEquationRole"},{"path":["symbols","operator"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasOperator","jsonld_type":"@vocab","description":"Main operation connecting this symbol to the equation.","schema_type":"string","enum":["sum","product","subtract","divide","transform","weightedSum","other"],"sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasOperator"},{"path":["symbols","bindings"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasBinding","description":"Concrete vocabulary IRIs that realise the abstract `fromProperty` of this symbol. Use when one symbol expands over an index (per-taxon, per-region), or when alternate / fallback measurements exist.\n","required":true,"schema_type":"array","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasBinding"},{"path":["symbols","bindings","variable"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingVariable","jsonld_type":"@id","description":"Concrete Rainbow IRI realising the entry's fromProperty.","required":true,"sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingVariable"},{"path":["symbols","bindings","indexValue"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingIndexValue","description":"Value of the equation index variable (e.g. \"Mytilus edulis\").","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingIndexValue"},{"path":["symbols","bindings","bindingRole"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingRole","jsonld_type":"@vocab","schema_type":"string","enum":["primary","alternate","fallback","expansion"],"sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingRole"},{"path":["symbols","bindings","validityScope"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingValidityScope","description":"Short scope note (region, scenario, season).","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/bindingValidityScope"},{"path":["symbols","bindings","evidence"],"id":"http://www.w3.org/ns/prov#wasDerivedFrom","jsonld_type":"@id","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/ns/prov#wasDerivedFrom"},{"path":["symbols","explanation"],"id":"https://schema.org/explanation","description":"Human-readable note about this symbol.","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://schema.org/explanation"},{"path":["weight"],"id":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasWeight","jsonld_type":"@id","description":"Optional sensitivity or coefficient value. In this profile it is not a causal cross-impact weight.","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/prop-rel/hasWeight"},{"path":["weight","value"],"id":"http://qudt.org/schema/qudt/numericValue","description":"Numeric sensitivity or coefficient value.","required":true,"schema_type":"number","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://qudt.org/schema/qudt/numericValue"},{"path":["model"],"id":"http://www.w3.org/ns/prov#wasAttributedTo","description":"Model that defines or evaluates this equation relationship (prov:wasAttributedTo).","required":true,"schema_type":"object","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/ns/prov#wasAttributedTo"},{"path":["model","id"],"id":"http://purl.org/dc/terms/identifier","description":"Identifier of the model (dct:identifier).","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["model","name"],"id":"http://www.w3.org/2000/01/rdf-schema#label","description":"Human-readable label of the model (rdfs:label).","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["model","uri"],"id":"@id","description":"URI of the model resource.","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"@id"},{"path":["experiment"],"id":"http://www.w3.org/ns/prov#wasGeneratedBy","description":"Experiment activity that evaluated this relationship (prov:wasGeneratedBy).","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/ns/prov#wasGeneratedBy"},{"path":["experiment","id"],"id":"http://purl.org/dc/terms/identifier","description":"Identifier of the experiment (dct:identifier).","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["experiment","name"],"id":"http://www.w3.org/2000/01/rdf-schema#label","description":"Human-readable label of the experiment (rdfs:label).","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["experiment","uri"],"id":"@id","description":"URI of the experiment resource.","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"@id"},{"path":["experiment","start"],"id":"http://www.w3.org/ns/prov#startedAtTime","jsonld_type":"http://www.w3.org/2001/XMLSchema#dateTime","description":"Date and time when the experiment started (prov:startedAtTime).","schema_type":"string","format":"date-time","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/ns/prov#startedAtTime"},{"path":["experiment","end"],"id":"http://www.w3.org/ns/prov#endedAtTime","jsonld_type":"http://www.w3.org/2001/XMLSchema#dateTime","description":"Date and time when the experiment ended (prov:endedAtTime).","schema_type":"string","format":"date-time","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/ns/prov#endedAtTime"},{"path":["evidence"],"id":"http://www.w3.org/ns/prov#wasDerivedFrom","jsonld_type":"@id","description":"Evidence or definition source for the equation relationship.","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"http://www.w3.org/ns/prov#wasDerivedFrom"},{"path":["explanation"],"id":"https://schema.org/explanation","description":"Human-readable explanation of how the primary fromProperty participates in the equation.","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.equation-property-relationship"],"effectiveId":"https://schema.org/explanation"}]}