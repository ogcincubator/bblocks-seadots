{"defs":{},"properties":[{"path":["fileName"],"id":"https://schema.org/contentUrl","required":true,"schema_type":"string","effectiveId":"https://schema.org/contentUrl"},{"path":["encoding"],"id":"https://schema.org/encodingFormat","description":"Free-text encoding statement, e.g. \"GeoParquet 1.1.0; Parquet logical types; geometry encoded as WKB\".","required":true,"schema_type":"string","effectiveId":"https://schema.org/encodingFormat"},{"path":["source"],"id":"http://purl.org/dc/terms/source","required":true,"schema_type":"object","effectiveId":"http://purl.org/dc/terms/source"},{"path":["source","href"],"id":"http://purl.org/dc/terms/references","jsonld_type":"@id","description":"Path or URL to the original source artifact this header was derived from.","required":true,"schema_type":"string","effectiveId":"http://purl.org/dc/terms/references"},{"path":["source","sourceFormat"],"id":"http://purl.org/dc/terms/format","description":"Media type or free-text description of the source format, e.g. \"application/geo+json\".","required":true,"schema_type":"string","effectiveId":"http://purl.org/dc/terms/format"},{"path":["source","rowCount"],"id":"https://schema.org/numberOfItems","required":true,"schema_type":"integer","effectiveId":"https://schema.org/numberOfItems"},{"path":["source","columnCount"],"id":"https://schema.org/numberOfColumns","required":true,"schema_type":"integer","effectiveId":"https://schema.org/numberOfColumns"},{"path":["source","note"],"id":"https://schema.org/comment","schema_type":"string","effectiveId":"https://schema.org/comment"},{"path":["parquetSchema"],"id":"https://geoparquet.org/schema","required":true,"schema_type":"array","effectiveId":"https://geoparquet.org/schema"},{"path":["parquetSchema","name"],"id":"http://www.w3.org/ns/csvw#name","required":true,"schema_type":"string","effectiveId":"http://www.w3.org/ns/csvw#name"},{"path":["parquetSchema","type"],"id":"http://www.w3.org/ns/csvw#datatype","description":"Parquet logical type, e.g. INT32, INT64, FLOAT, DOUBLE, BOOLEAN, BYTE_ARRAY/UTF8, BYTE_ARRAY/WKB.","required":true,"schema_type":"string","effectiveId":"http://www.w3.org/ns/csvw#datatype"},{"path":["parquetSchema","nullable"],"id":"https://geoparquet.org/schema#nullable","schema_type":"boolean","effectiveId":"https://geoparquet.org/schema#nullable"},{"path":["parquetSchema","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","effectiveId":"http://purl.org/dc/terms/description"},{"path":["parquetSchema","propertyUrl"],"id":"http://www.w3.org/ns/csvw#propertyUrl","jsonld_type":"@id","description":"CSVW-style compact IRI or full IRI naming this column's semantic mapping.","schema_type":"string","effectiveId":"http://www.w3.org/ns/csvw#propertyUrl"},{"path":["geo"],"id":"https://geoparquet.org/metadata","required":true,"schema_type":"object","effectiveId":"https://geoparquet.org/metadata"},{"path":["geo","version"],"id":"https://schema.org/version","required":true,"schema_type":"string","effectiveId":"https://schema.org/version"},{"path":["geo","primary_column"],"id":"https://geoparquet.org/metadata#primary_column","required":true,"schema_type":"string","effectiveId":"https://geoparquet.org/metadata#primary_column"},{"path":["geo","columns"],"id":"https://geoparquet.org/metadata#columns","required":true,"schema_type":"object","effectiveId":"https://geoparquet.org/metadata#columns"},{"path":["geo","columns","encoding"],"id":"https://schema.org/encodingFormat","required":true,"schema_type":"string","effectiveId":"https://schema.org/encodingFormat"},{"path":["geo","columns","geometry_types"],"id":"https://geoparquet.org/metadata#geometry_types","schema_type":"array","effectiveId":"https://geoparquet.org/metadata#geometry_types"},{"path":["geo","columns","crs"],"id":"https://geoparquet.org/metadata#crs","description":"Must be omitted/null (defaults to OGC:CRS84), a CRS identifier string (e.g. \"OGC:CRS84\"), or a full PROJJSON object. A shorthand object that merely looks like PROJJSON (has a \"type\" but none of the keys that make a CRS definition complete) is exactly the authoring mistake that breaks real GeoParquet readers (e.g. geopandas, via proj) at read time \u2014 this schema rejects that shape rather than silently accepting it.\n","effectiveId":"https://geoparquet.org/metadata#crs"},{"path":["geo","columns","edges"],"id":"https://geoparquet.org/metadata#edges","schema_type":"string","enum":["planar","spherical"],"effectiveId":"https://geoparquet.org/metadata#edges"},{"path":["geo","columns","orientation"],"id":"https://geoparquet.org/metadata#orientation","schema_type":"string","effectiveId":"https://geoparquet.org/metadata#orientation"},{"path":["geo","columns","bbox"],"id":"https://geoparquet.org/metadata#bbox","schema_type":"array","effectiveId":"https://geoparquet.org/metadata#bbox"},{"path":["geo","columns","covering"],"id":"https://geoparquet.org/metadata#covering","schema_type":"object","effectiveId":"https://geoparquet.org/metadata#covering"},{"path":["geo","columns","crs","type"],"id":"http://www.w3.org/ns/csvw#datatype","required":true,"enum":["GeographicCRS","ProjectedCRS","GeodeticCRS","CompoundCRS","VerticalCRS"],"effectiveId":"http://www.w3.org/ns/csvw#datatype"}]}