{
  "@context": {
    "Feature": "geojson:Feature",
    "FeatureCollection": "geojson:FeatureCollection",
    "GeometryCollection": "geojson:GeometryCollection",
    "LineString": "geojson:LineString",
    "MultiLineString": "geojson:MultiLineString",
    "MultiPoint": "geojson:MultiPoint",
    "MultiPolygon": "geojson:MultiPolygon",
    "Point": "geojson:Point",
    "Polygon": "geojson:Polygon",
    "features": {
      "@container": "@set",
      "@id": "geojson:features"
    },
    "type": "@type",
    "id": "@id",
    "properties": "@nest",
    "geometry": {
      "@context": {
        "coordinates": {
          "@container": "@list",
          "@id": "geojson:coordinates"
        }
      },
      "@id": "geojson:geometry"
    },
    "bbox": {
      "@container": "@list",
      "@id": "geojson:bbox"
    },
    "links": {
      "@context": {
        "href": {
          "@type": "@id",
          "@id": "oa:hasTarget"
        },
        "rel": {
          "@context": {
            "@base": "http://www.iana.org/assignments/relation/"
          },
          "@id": "http://www.iana.org/assignments/relation",
          "@type": "@id"
        },
        "type": "dct:type",
        "hreflang": "dct:language",
        "title": "rdfs:label",
        "length": "dct:extent"
      },
      "@id": "rdfs:seeAlso"
    },
    "geojson": "https://purl.org/geojson/vocab#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "oa": "http://www.w3.org/ns/oa#",
    "dct": "http://purl.org/dc/terms/",
    "pa": "https://w3id.org/ogc/hosted/seadots/emodnet-protected-area/",
    "pa-helcom": "pa:helcom/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Name": "pa:siteName",
    "MPA_ID": "pa:conventionSiteCode",
    "Country": "pa:countryName",
    "Site_link": {
      "@id": "foaf:page",
      "@type": "@id"
    },
    "MPA_status": "pa:managementStatus",
    "Date_est": "pa:helcom/establishmentDate",
    "Year_est": {
      "@id": "pa:establishmentYear",
      "@type": "xsd:gYear"
    },
    "Type": "pa:helcom/designationType",
    "TypeSpecification": "pa:helcom/designationTypeSpecification",
    "Code": "pa:helcom/siteCode",
    "HasCoastalArea": "pa:helcom/hasCoastalArea",
    "@version": 1.1
  }
}