{"defs":{},"properties":[{"path":["id"],"description":"identifier of the collection used, for example, in URIs","required":true,"schema_type":"string","sources":["bblocks://ogc.api.features.v1.schemas.collection","bblocks://ogc.hosted.seadots.emodnet-protected-area.api-collection"]},{"path":["title"],"description":"human readable title of the collection","schema_type":"string","sources":["bblocks://ogc.api.features.v1.schemas.collection"]},{"path":["description"],"description":"a description of the features in the collection","schema_type":"string","sources":["bblocks://ogc.api.features.v1.schemas.collection"]},{"path":["links"],"id":"http://www.w3.org/2000/01/rdf-schema#seeAlso","required":true,"schema_type":"array","sources":["bblocks://ogc.api.features.v1.schemas.collection","bblocks://ogc.hosted.seadots.emodnet-protected-area.api-collection"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#seeAlso"},{"path":["links","href"],"id":"http://www.w3.org/ns/oa#hasTarget","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri-reference","enum":["https://ogcincubator.github.io/bblocks-seadots/bblock/ogc.hosted.seadots.emodnet-protected-area.nationally-designated-area","https://ogcincubator.github.io/bblocks-seadots/bblock/ogc.hosted.seadots.emodnet-protected-area.rsc-mpa"],"sources":["bblocks://ogc.ogc-utils.json-link","bblocks://ogc.hosted.seadots.emodnet-protected-area.api-collection"],"effectiveId":"http://www.w3.org/ns/oa#hasTarget"},{"path":["links","rel"],"id":"http://www.iana.org/assignments/relation","jsonld_type":"@id","required":true,"schema_type":"string","const":"profile","sources":["bblocks://ogc.ogc-utils.json-link","bblocks://ogc.hosted.seadots.emodnet-protected-area.api-collection"],"effectiveId":"http://www.iana.org/assignments/relation"},{"path":["links","anchor"],"schema_type":"string","sources":["bblocks://ogc.ogc-utils.json-link"]},{"path":["links","type"],"id":"http://purl.org/dc/terms/type","required":true,"schema_type":"string","const":"application/schema+json","sources":["bblocks://ogc.ogc-utils.json-link","bblocks://ogc.hosted.seadots.emodnet-protected-area.api-collection"],"effectiveId":"http://purl.org/dc/terms/type"},{"path":["links","hreflang"],"id":"http://purl.org/dc/terms/language","schema_type":"string","sources":["bblocks://ogc.ogc-utils.json-link"],"effectiveId":"http://purl.org/dc/terms/language"},{"path":["links","title"],"id":"http://www.w3.org/2000/01/rdf-schema#label","schema_type":"string","sources":["bblocks://ogc.ogc-utils.json-link"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["links","length"],"id":"http://purl.org/dc/terms/extent","schema_type":"integer","sources":["bblocks://ogc.ogc-utils.json-link"],"effectiveId":"http://purl.org/dc/terms/extent"},{"path":["extent"],"sources":["bblocks://ogc.api.features.v1.schemas.collection"]},{"path":["extent","spatial"],"description":"The spatial extent of the features in the collection.","schema_type":"object","sources":["bblocks://ogc.api.features.v1.schemas.extent"]},{"path":["extent","spatial","bbox"],"schema_type":"array","sources":["bblocks://ogc.api.features.v1.schemas.extent"]},{"path":["extent","spatial","crs"],"description":"Coordinate reference system of the coordinates in the spatial extent\n(property `bbox`). The default reference system is WGS 84 longitude/latitude.\nIn the Core the only other supported coordinate reference system is\nWGS 84 longitude/latitude/ellipsoidal height for coordinates with height.\nExtensions may support additional coordinate reference systems and add\nadditional enum values.","schema_type":"string","enum":["http://www.opengis.net/def/crs/OGC/1.3/CRS84","http://www.opengis.net/def/crs/OGC/0/CRS84h"],"sources":["bblocks://ogc.api.features.v1.schemas.extent"]},{"path":["extent","temporal"],"description":"The temporal extent of the features in the collection.","schema_type":"object","sources":["bblocks://ogc.api.features.v1.schemas.extent"]},{"path":["extent","temporal","interval"],"description":"One or more time intervals that describe the temporal extent of the dataset.\nIn the Core only a single time interval is supported.\n\nExtensions may support multiple intervals.\nThe first time interval describes the overall\ntemporal extent of the data. All subsequent time intervals describe\nmore precise time intervals, e.g., to identify clusters of data.\nClients only interested in the overall temporal extent will only need\nto access the first time interval in the array (a pair of lower and upper\nbound instants).","schema_type":"array","sources":["bblocks://ogc.api.features.v1.schemas.extent"]},{"path":["extent","temporal","trs"],"description":"Coordinate reference system of the coordinates in the temporal extent\n(property `interval`). The default reference system is the Gregorian calendar.\nIn the Core this is the only supported temporal coordinate reference system.\nExtensions may support additional temporal coordinate reference systems and add\nadditional enum values.","schema_type":"string","enum":["http://www.opengis.net/def/uom/ISO-8601/0/Gregorian"],"sources":["bblocks://ogc.api.features.v1.schemas.extent"]},{"path":["itemType"],"description":"indicator about the type of the items in the collection (the default value is 'feature').","required":true,"schema_type":"string","const":"feature","sources":["bblocks://ogc.api.features.v1.schemas.collection","bblocks://ogc.hosted.seadots.emodnet-protected-area.api-collection"]},{"path":["crs"],"description":"the list of coordinate reference systems supported by the service","required":true,"schema_type":"array","sources":["bblocks://ogc.api.features.v1.schemas.collection","bblocks://ogc.hosted.seadots.emodnet-protected-area.api-collection"]}]}