@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix es: <https://w3id.org/ogc/hosted/seadots/emodnet-windfarm-source#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ogc/hosted/seadots/emodnet-windfarm-source> a owl:Ontology ;
    dcterms:description "Terms for source-specific fields in the raw EMODnet windfarm snapshot."@en ;
    dcterms:title "EMODnet windfarm source vocabulary"@en .

es:distanceToCoastMetres a rdf:Property ;
    rdfs:label "distance to coast in metres"@en ;
    rdfs:comment "Source-reported distance from the windfarm location to the coast, in metres; preserved as the original CSV field value."@en ;
    rdfs:range xsd:string .

es:latitude a rdf:Property ;
    rdfs:label "latitude"@en ;
    rdfs:comment "Latitude coordinate from the original EMODnet source record, in decimal degrees, preserved as the original CSV field value."@en ;
    rdfs:range xsd:string .

es:longitude a rdf:Property ;
    rdfs:label "longitude"@en ;
    rdfs:comment "Longitude coordinate from the original EMODnet source record, in decimal degrees, preserved as the original CSV field value."@en ;
    rdfs:range xsd:string .

