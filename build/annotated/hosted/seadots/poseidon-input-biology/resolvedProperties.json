purl.org/geojson/vocab#coordinates"},{"path":["stacItems","geometry","_oneOf","1","type"],"id":"@type","required":true,"schema_type":"string","enum":["Point"],"sources":["bblocks://ogc.geo.common.data_types.geojson"],"effectiveId":"@type"},{"path":["stacItems","properties"],"id":"@nest","required":true,"schema_type":"object","sources":["bblocks://ogc.geo.common.data_types.geojson","bblocks://ogc.api.records.v1.schemas.recordGeoJSON","bblocks://ogc.contrib.stac.item"],"effectiveId":"@nest"},{"path":["stacItems","properties","datetime"],"id":"http://purl.org/dc/terms/date","jsonld_type":"xsd:dateTime","required":true,"sources":["bblocks://ogc.contrib.stac.item"],"effectiveId":"http://purl.org/dc/terms/date"},{"path":["stacItems","properties","rights"],"id":"http://www.w3.org/ns/dcat#rights","description":"A statement that concerns all rights not addressed by the license such as a copyright statement.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#rights"},{"path":["stacItems","properties","license"],"id":"http://www.w3.org/ns/dcat#license","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#license"},{"path":["stacItems","properties","contacts"],"id":"http://www.w3.org/ns/dcat#contactPoint","jsonld_type":"@id","description":"A list of contacts qualified by their role(s) in association to the record or the resource described by the record.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#contactPoint"},{"path":["stacItems","properties","contacts","roles"],"description":"The set of named duties, job functions and/or permissions associated with this contact. (e.g. developer, administrator, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","contactInstructions"],"description":"Supplemental instructions on how or when to contact the\nresponsible party.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","hoursOfService"],"description":"Time period when the contact can be contacted.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","links"],"description":"On-line information about the contact.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","addresses"],"description":"Physical location at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","addresses","roles"],"description":"The type of address (e.g. office, home, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","addresses","country"],"description":"Country of the physical address.  ISO 3166-1 is recommended.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","addresses","postalCode"],"description":"ZIP or other postal code.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","addresses","administrativeArea"],"description":"State or province of the location.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","addresses","city"],"description":"City for the location.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","addresses","deliveryPoint"],"description":"Address lines for the location.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","emails"],"description":"Email addresses at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","emails","roles"],"description":"The type of email (e.g. home, work, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","emails","value"],"description":"The value is the email number itself.","required":true,"schema_type":"string","format":"email","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","phones"],"description":"Telephone numbers at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","phones","roles"],"description":"The type of phone number (e.g. home, work, fax, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","phones","value"],"description":"The value is the phone number itself.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","logo"],"description":"Graphic identifying a contact. The link relation should be `icon` and the media type should be an image media type.","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","logo","rel"],"required":true,"enum":["icon"],"sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","organization"],"description":"Organization/affiliation of the contact.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","position"],"description":"The name of the role or position of the responsible person taken from the organization's formal organizational hierarchy or chart.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","name"],"description":"The name of the responsible person.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","contacts","identifier"],"description":"A value uniquely identifying a contact.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["stacItems","properties","formats"],"id":"https://www.opengis.net/def/ogc-api/records/format","jsonld_type":"@id","description":"A list of available distributions of the resource.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/format"},{"path":["stacItems","properties","formats","mediaType"],"id":"https://www.opengis.net/def/ogc-api/records/mediaType","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/mediaType"},{"path":["stacItems","properties","formats","name"],"id":"https://www.opengis.net/def/ogc-api/records/name","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/name"},{"path":["stacItems","properties","themes"],"id":"https://www.opengis.net/def/ogc-api/records/themes","description":"A knowledge organization system used to classify the resource.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/themes"},{"path":["stacItems","properties","themes","scheme"],"id":"https://w3id.org/ogc/stac/themes/scheme","description":"An identifier for the knowledge organization system used\nto classify the resource.  It is recommended that the\nidentifier be a resolvable URI.  The list of schemes used\nin a searchable catalog can be determined by inspecting\nthe server's OpenAPI document or, if the server implements\nCQL2, by exposing a queryable (e.g. named `scheme`) and\nenumerating the list of schemes in the queryable's schema\ndefinition.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/scheme"},{"path":["stacItems","properties","themes","concepts"],"id":"https://w3id.org/ogc/stac/themes/concepts","description":"One or more entity/concept identifiers from this knowledge\nsystem. it is recommended that a resolvable URI be used for\neach entity/concept identifier.","required":true,"schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/concepts"},{"path":["stacItems","properties","themes","concepts","url"],"id":"@id","description":"A URI providing further description of the concept.","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"@id"},{"path":["stacItems","properties","themes","concepts","description"],"id":"http://purl.org/dc/terms/description","description":"A human readable description for the concept.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["stacItems","properties","themes","concepts","title"],"id":"http://purl.org/dc/terms/title","description":"A human readable title for the concept.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["stacItems","properties","themes","concepts","id"],"id":"https://w3id.org/ogc/stac/themes/id","description":"An identifier for the concept.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/id"},{"path":["stacItems","properties","externalIds"],"id":"https://www.opengis.net/def/ogc-api/records/scopedIdentifier","description":"An identifier for the resource assigned by an external (to the catalog) entity.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/scopedIdentifier"},{"path":["stacItems","properties","externalIds","value"],"id":"https://www.opengis.net/def/ogc-api/records/id","description":"The value of the identifier.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/id"},{"path":["stacItems","properties","externalIds","scheme"],"id":"https://www.opengis.net/def/ogc-api/records/scheme","description":"A reference to an authority or identifier for a knowledge organization system from which the external identifier was obtained. It is recommended that the identifier be a resolvable URI.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/scheme"},{"path":["stacItems","properties","resourceLanguages"],"id":"https://www.opengis.net/def/ogc-api/records/resourceLanguages","description":"The list of languages in which the resource described by this record is available.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/resourceLanguages"},{"path":["stacItems","properties","languages"],"id":"https://www.opengis.net/def/ogc-api/records/languages","description":"This list of languages in which this record is available.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/languages"},{"path":["stacItems","properties","language"],"id":"https://www.opengis.net/def/ogc-api/records/language","description":"The language used for textual values in this record representation.","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/language"},{"path":["stacItems","properties","language","dir"],"description":"The direction for text in this language. The default, `ltr`\n(left-to-right), represents the most common situation.\nHowever, care should be taken to set the value of `dir`\nappropriately if the language direction is not `ltr`.\nOther values supported are `rtl` (right-to-left), `ttb`\n(top-to-bottom), and `btt` (bottom-to-top).","schema_type":"string","enum":["ltr","rtl","ttb","btt"],"sources":["bblocks://ogc.api.records.v1.schemas.language"]},{"path":["stacItems","properties","language","alternate"],"description":"The name of the language in another well-understood language,\nusually English.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.language"]},{"path":["stacItems","properties","language","name"],"description":"The untranslated name of the language.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.language"]},{"path":["stacItems","properties","language","code"],"description":"The language tag as per RFC-5646.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.language"]},{"path":["stacItems","properties","keywords"],"id":"http://www.w3.org/ns/dcat#keyword","description":"The topic or topics of the resource. Typically represented using free-form keywords, tags, key phrases, or classification codes.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#keyword"},{"path":["stacItems","properties","description"],"id":"http://purl.org/dc/terms/description","description":"A free-text account of the resource.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["stacItems","properties","title"],"id":"http://purl.org/dc/terms/title","description":"A human-readable name given to the resource.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["stacItems","properties","type"],"description":"The nature or genre of the resource. The value should be a code, convenient for filtering records. Where available, a link to the canonical URI of the record type resource will be added to the 'links' property.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"]},{"path":["stacItems","properties","updated"],"id":"http://purl.org/dc/terms/modified","description":"The most recent date on which the record was changed.","schema_type":"string","format":"date-time","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/modified"},{"path":["stacItems","properties","created"],"id":"http://purl.org/dc/terms/created","description":"Date of creation of this record.","schema_type":"string","format":"date-time","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/created"},{"path":["stacItems","id"],"id":"@id","title":"Provider ID","description":"A unique identifier of the catalog record.","required":true,"schema_type":"string","sources":["bblocks://ogc.geo.common.data_types.geojson","bblocks://ogc.api.records.v1.schemas.recordGeoJSON","bblocks://ogc.contrib.stac.item"],"effectiveId":"@id"},{"path":["stacItems","type"],"id":"@type","required":true,"schema_type":"string","enum":["Feature"],"const":"Feature","sources":["bblocks://ogc.geo.common.data_types.geojson","bblocks://ogc.geo.features.feature","bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"@type"}]}