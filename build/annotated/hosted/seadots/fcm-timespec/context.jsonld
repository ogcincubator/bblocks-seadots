{
  "@context": {
    "type": "@type",
    "dt": {
      "@id": "fcm:instant",
      "@type": "xsd:dateTime"
    },
    "year": {
      "@id": "fcm:year",
      "@type": "xsd:integer"
    },
    "week": {
      "@id": "fcm:week",
      "@type": "xsd:integer"
    },
    "month": {
      "@id": "fcm:month",
      "@type": "xsd:integer"
    },
    "start": {
      "@id": "fcm:intervalStart",
      "@type": "xsd:dateTime"
    },
    "stop": {
      "@id": "fcm:intervalStop",
      "@type": "xsd:dateTime"
    },
    "id": "@id",
    "pointtimespec": "fcm:PointTimeSpec",
    "weekofyeartimespec": "fcm:WeekOfYearTimeSpec",
    "monthofyeartimespec": "fcm:MonthOfYearTimeSpec",
    "rangetimespec": "fcm:RangeTimeSpec",
    "fcm": "https://w3id.org/ogc/hosted/seadots/fcm/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "@version": 1.1
  }
}