{"defs":{},"properties":[{"path":["ogc_fid"],"description":"Row identifier of the serving database. Not listed in the Navigator data dictionary; a technical field with no semantic mapping.","schema_type":"integer","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"]},{"path":["site_id"],"id":"http://purl.org/dc/terms/identifier","description":"ProtectedSeas-assigned unique identifier","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["site_name"],"id":"http://schema.org/name","description":"Site name","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://schema.org/name"},{"path":["country"],"id":"http://schema.org/addressCountry","description":"Country name","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://schema.org/addressCountry"},{"path":["category_name"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/category","description":"Site category. The value is the category name from the Navigator Site Categories table.","required":true,"schema_type":"string","enum":["Marine Protected Area","Other Effective Area-Based Conservation Area","Fisheries Management Area","Water Quality/Human Health Area","Recreational Area","Vessel Restricted Area","Vessel Reporting Area","Voluntary Conservation Measure Area","Jurisdictional Authority Area","Other","To Be Determined","Local Marine Managed Area","Marine Spatial Planning Area"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/category"},{"path":["designation"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/designation","description":"Specific site type (e.g. National Marine Sanctuary)","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/designation"},{"path":["managing_authority"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/managingAuthority","description":"Agency(s) with presiding jurisdiction over this site","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/managingAuthority"},{"path":["state"],"id":"http://schema.org/addressRegion","description":"Subnational unit name, if applicable (e.g. State, Province)","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://schema.org/addressRegion"},{"path":["wdpa_id"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/wdpaId","description":"WDPA-assigned unique identifier for site. NULL = Area not included in WDPA","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/wdpaId"},{"path":["iucn_category"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/iucnCategory","description":"IUCN Protected Area Category. 'Unassigned' if no value found, not reported, or not applicable","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/iucnCategory"},{"path":["purpose"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/purpose","description":"Short summary explaining what is special about this marine area; number of habitats and endangered species","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/purpose"},{"path":["restrictions"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/restrictions","description":"Lists prohibited or entirely banned marine-related activities (fishing, dumping, pollution, anchoring, boating) and outlines restricted commercial and/or recreational fishing activities","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/restrictions"},{"path":["allowed"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/allowedActivities","description":"Lists allowed marine-related activities, including associated licenses/permits if applicable","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/allowedActivities"},{"path":["definitions"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/regulatoryDefinitions","description":"Definitions, where necessary and possible, of terms contained in 'Restrictions' or 'Allowed', e.g. fishing gear, enumerated species, or geographical locations","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/regulatoryDefinitions"},{"path":["regulation_titles"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationName","description":"List of names of the relevant regulations that established the site. Semicolon-separated.","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationName"},{"path":["regulation_urls"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationUrl","description":"List of URLs of relevant regulations. Semicolon-separated.","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationUrl"},{"path":["urls"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/website","description":"URL link to the most relevant webpage about the site","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/website"},{"path":["seasonality"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/season","description":"Temporal applicability of the listed restrictions; either Year-round (permanent) or Seasonal (only effective between Effective From and Effective To dates each year)","schema_type":"string","enum":["Year-round","Seasonal"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/season"},{"path":["effective_from"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveFrom","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date restrictions begin, if seasonal","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveFrom"},{"path":["effective_to"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveTo","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date restrictions end, if seasonal","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveTo"},{"path":["protection_focus"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/protectionFocus","description":"The focus of the protection afforded by the site.","schema_type":"string","enum":["Ecosystem","Focal Species","Human Health","Cultural Heritage","Human Safety","Water Quality","Marine Spatial Planning","Unknown"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/protectionFocus"},{"path":["species_of_concern"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/speciesOfConcern","description":"General categories of species that are of interest or concern","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/speciesOfConcern"},{"path":["focal_species_tokens"],"description":"Search tokens derived from the species of concern. Not listed in the Navigator data dictionary; a technical field with no semantic mapping.","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"]},{"path":["government_level"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/governmentLevel","description":"Agency(s) level of government. NULL = Not Yet Coded","schema_type":["string","null"],"enum":["National","Subnational","Local","Collaborative Governance","Partnership","Private",null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/governmentLevel"},{"path":["year_established"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/yearEstablished","description":"Year the site was first established","schema_type":["integer","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/yearEstablished"},{"path":["other_links"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/otherLinks","description":"Other helpful URL links related to site","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/otherLinks"},{"path":["level_fishing_protection"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/levelOfFishingProtection","description":"An indicator of the strength of fishing regulations, coded on a 1-5 scale, with higher scores indicating more restrictions and more protection.","required":true,"schema_type":"integer","enum":[0,1,2,3,4,5],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/levelOfFishingProtection"},{"path":["recreational_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/recreationalFishing","description":"Fishing for recreational purposes - not sold","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/recreationalFishing"},{"path":["commercial_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/commercialFishing","description":"Professional large-scale fisheries that use large, often impactful, gear","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/commercialFishing"},{"path":["artisanal_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/artisanalFishing","description":"Artisanal fisheries are those that use a relatively low level of technology: small canoes or boats instead of larger, more powerful vessels; no engines or very simple low-power engines; and traditional fishing gear such as spears or hand reels, some nets","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/artisanalFishing"},{"path":["subsistence_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/subsistenceFishing","description":"Fishing in order to feed the fisher's family - not sold","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/subsistenceFishing"},{"path":["bottom_trawling"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/bottomTrawling","description":"A fishing practice that herds and captures the target species, like ground fish or crabs, by towing a net along the ocean floor","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/bottomTrawling"},{"path":["pelagic_trawling"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/pelagicTrawling","description":"Pelagic or midwater trawling involves towing a large net through the water column. Trawls are designed to capture and trap the target species inside the codend as the net is hauled through the water","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/pelagicTrawling"},{"path":["hook_and_line"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/hookAndLine","description":"A fishing method that catches fish by means of a series of baited hooks, which are suspended on lines into the ocean. Excludes trolling and longline, which are separate categories","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/hookAndLine"},{"path":["trolling"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/trolling","description":"To trail artificial or natural baits behind a moving boat. The bait can be made to skip along the surface or trailed below at any depth to just above the bottom. A bait or lure trailed behind an angler walking along a pier, bridge, or breakwater is also called trolling","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/trolling"},{"path":["purse_seine_surrounding_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/purseSeineSurroundingNets","description":"A net that encircles schools of fish","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/purseSeineSurroundingNets"},{"path":["gillnets_entangling_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetsEntanglingNets","description":"Gillnets and entangling nets are walls of netting that hang in the water column, typically made of monofilament or multifilament nylon","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetsEntanglingNets"},{"path":["trammel_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/trammelNets","description":"An entangling net that hangs down in several curtains","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/trammelNets"},{"path":["dip_scoop_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/dipScoopNets","description":"A bag net with a handle that is used to scoop fish from the water","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/dipScoopNets"},{"path":["cast_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/castNets","description":"A net constructed from a series of tailored netting sections joined together to produce a cone-shaped net with weights and a drawstring attached to the perimeter and cast by a fisher to catch fish","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/castNets"},{"path":["drift_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/driftNets","description":"A fishing net that drifts with the tide or current and is buoyed or attached to a boat","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/driftNets"},{"path":["other_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/otherNets","description":"Any fishing net types not accounted for","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/otherNets"},{"path":["dredges"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/dredges","description":"Dredges are dragged along the seafloor to catch shellfish. Dredges are made from an openmouthed frame that scoops shellfish from the seafloor. Attached to the back of the frame is a collection area made from metal rings or mesh","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/dredges"},{"path":["traps_pots"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/trapsAndPots","description":"Traps and pots are submerged three-dimensional wire or wood devices that permit organisms to enter the enclosure but make escape extremely difficult or impossible","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/trapsAndPots"},{"path":["spear_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/spearFishing","description":"Fishing with a shaft with one or more sharpened points at one end","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/spearFishing"},{"path":["underwater_extraction_diving"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/underwaterExtractionDiving","description":"Fishing or collecting marine life underwater by hand, spear, or harpoon gun with or without the use of an underwater breathing device gear","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/underwaterExtractionDiving"},{"path":["hand_capture"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/handCapture","description":"Fishing or collecting by hand without the use of gear","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/handCapture"},{"path":["fish_aggregating_devices"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/fishAggregatingDevices","description":"Floating objects that are designed and strategically placed to attract pelagic fish. Includes both static and free-floating","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/fishAggregatingDevices"},{"path":["longlining"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/longlining","description":"A line that is deployed horizontally to which gangions and hooks are attached. A longline may be a bottom longline, i.e., designed for use on the bottom, or a pelagic longline, i.e., designed for use off the bottom. The longline hauler may be manually, electrically, or hydraulically operated","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/longlining"},{"path":["gillnetting_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetting","description":"Gillnets are walls of netting that hang in the water column, typically made of monofilament or multifilament nylon","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetting"},{"path":["nets_other_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/nets","description":"Any fishing net types not accounted for","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/nets"},{"path":["gear_misc_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/miscellaneousGear","description":"Any fishing gear not included elsewhere","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/miscellaneousGear"},{"path":["tribal_exemptions"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/tribalExemptions","description":"Are there tribal exemptions to fishing restrictions? Yes (0); No (1); Not Yet Coded (null)","schema_type":["integer","null"],"enum":[0,1,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/tribalExemptions"},{"path":["discharge"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/discharge","description":"The deliberate disposal at sea of wastes or other matter from vessels","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/discharge"},{"path":["vessel_speed"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselSpeed","description":"Speed of vessel. Prohibited (i.e. no transit) (1); Restricted (2); N/A or Unknown (3); Not Yet Coded (null)","schema_type":["integer","null"],"enum":[1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselSpeed"},{"path":["vessel_entry"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselEntry","description":"Permittance of vessel types to enter or transit the area","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselEntry"},{"path":["diving"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/diving","description":"Recreational, non-extractive, SCUBA diving or freediving","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/diving"},{"path":["historic_artifact_removal"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/historicArtifactRemoval","description":"Removal of fossils or artifacts","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/historicArtifactRemoval"},{"path":["vessel_stopping"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselStopping","description":"Permittance of vessels to stop in area (opposed to continuous transit required)","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselStopping"},{"path":["anchoring"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/anchoring","description":"Holding a vessel in place by mooring it to the seafloor with an anchor","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/anchoring"},{"path":["mooring"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/mooring","description":"Securing a vessel to a fixed object, such as a mooring buoy","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/mooring"},{"path":["landing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/landing","description":"Stopping a vessel to load and unload things or peo