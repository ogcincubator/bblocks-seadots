blocks://ogc.ogc-utils.json-link"],"effectiveId":"http://purl.org/dc/terms/type"},{"path":["links","hreflang"],"id":"http://purl.org/dc/terms/language","schema_type":"string","sources":["bblocks://ogc.ogc-utils.json-link"],"effectiveId":"http://purl.org/dc/terms/language"},{"path":["links","title"],"id":"http://www.w3.org/2000/01/rdf-schema#label","schema_type":"string","sources":["bblocks://ogc.ogc-utils.json-link"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#label"},{"path":["links","length"],"id":"http://purl.org/dc/terms/extent","schema_type":"integer","sources":["bblocks://ogc.ogc-utils.json-link"],"effectiveId":"http://purl.org/dc/terms/extent"},{"path":["properties","ogc_fid"],"description":"Row identifier of the serving database. Not listed in the Navigator data dictionary; a technical field with no semantic mapping.","schema_type":"integer","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"]},{"path":["properties","site_id"],"id":"http://purl.org/dc/terms/identifier","description":"ProtectedSeas-assigned unique identifier","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://purl.org/dc/terms/identifier"},{"path":["properties","site_name"],"id":"http://schema.org/name","description":"Site name","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://schema.org/name"},{"path":["properties","country"],"id":"http://schema.org/addressCountry","description":"Country name","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://schema.org/addressCountry"},{"path":["properties","category_name"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/category","description":"Site category. The value is the category name from the Navigator Site Categories table.","required":true,"schema_type":"string","enum":["Marine Protected Area","Other Effective Area-Based Conservation Area","Fisheries Management Area","Water Quality/Human Health Area","Recreational Area","Vessel Restricted Area","Vessel Reporting Area","Voluntary Conservation Measure Area","Jurisdictional Authority Area","Other","To Be Determined","Local Marine Managed Area","Marine Spatial Planning Area"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/category"},{"path":["properties","designation"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/designation","description":"Specific site type (e.g. National Marine Sanctuary)","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/designation"},{"path":["properties","managing_authority"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/managingAuthority","description":"Agency(s) with presiding jurisdiction over this site","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/managingAuthority"},{"path":["properties","state"],"id":"http://schema.org/addressRegion","description":"Subnational unit name, if applicable (e.g. State, Province)","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://schema.org/addressRegion"},{"path":["properties","wdpa_id"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/wdpaId","description":"WDPA-assigned unique identifier for site. NULL = Area not included in WDPA","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/wdpaId"},{"path":["properties","iucn_category"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/iucnCategory","description":"IUCN Protected Area Category. 'Unassigned' if no value found, not reported, or not applicable","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/iucnCategory"},{"path":["properties","purpose"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/purpose","description":"Short summary explaining what is special about this marine area; number of habitats and endangered species","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/purpose"},{"path":["properties","restrictions"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/restrictions","description":"Lists prohibited or entirely banned marine-related activities (fishing, dumping, pollution, anchoring, boating) and outlines restricted commercial and/or recreational fishing activities","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/restrictions"},{"path":["properties","allowed"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/allowedActivities","description":"Lists allowed marine-related activities, including associated licenses/permits if applicable","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/allowedActivities"},{"path":["properties","definitions"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/regulatoryDefinitions","description":"Definitions, where necessary and possible, of terms contained in 'Restrictions' or 'Allowed', e.g. fishing gear, enumerated species, or geographical locations","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/regulatoryDefinitions"},{"path":["properties","regulation_titles"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationName","description":"List of names of the relevant regulations that established the site. Semicolon-separated.","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationName"},{"path":["properties","regulation_urls"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationUrl","description":"List of URLs of relevant regulations. Semicolon-separated.","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/regulationUrl"},{"path":["properties","urls"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/website","description":"URL link to the most relevant webpage about the site","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/website"},{"path":["properties","seasonality"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/season","description":"Temporal applicability of the listed restrictions; either Year-round (permanent) or Seasonal (only effective between Effective From and Effective To dates each year)","schema_type":"string","enum":["Year-round","Seasonal"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/season"},{"path":["properties","effective_from"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveFrom","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date restrictions begin, if seasonal","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveFrom"},{"path":["properties","effective_to"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveTo","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date restrictions end, if seasonal","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/effectiveTo"},{"path":["properties","protection_focus"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/protectionFocus","description":"The focus of the protection afforded by the site.","schema_type":"string","enum":["Ecosystem","Focal Species","Human Health","Cultural Heritage","Human Safety","Water Quality","Marine Spatial Planning","Unknown"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/protectionFocus"},{"path":["properties","species_of_concern"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/speciesOfConcern","description":"General categories of species that are of interest or concern","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/speciesOfConcern"},{"path":["properties","focal_species_tokens"],"description":"Search tokens derived from the species of concern. Not listed in the Navigator data dictionary; a technical field with no semantic mapping.","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"]},{"path":["properties","government_level"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/governmentLevel","description":"Agency(s) level of government. NULL = Not Yet Coded","schema_type":["string","null"],"enum":["National","Subnational","Local","Collaborative Governance","Partnership","Private",null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/governmentLevel"},{"path":["properties","year_established"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/yearEstablished","description":"Year the site was first established","schema_type":["integer","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/yearEstablished"},{"path":["properties","other_links"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/otherLinks","description":"Other helpful URL links related to site","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/otherLinks"},{"path":["properties","level_fishing_protection"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/levelOfFishingProtection","description":"An indicator of the strength of fishing regulations, coded on a 1-5 scale, with higher scores indicating more restrictions and more protection.","required":true,"schema_type":"integer","enum":[0,1,2,3,4,5],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/levelOfFishingProtection"},{"path":["properties","recreational_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/recreationalFishing","description":"Fishing for recreational purposes - not sold","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/recreationalFishing"},{"path":["properties","commercial_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/commercialFishing","description":"Professional large-scale fisheries that use large, often impactful, gear","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/commercialFishing"},{"path":["properties","artisanal_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/artisanalFishing","description":"Artisanal fisheries are those that use a relatively low level of technology: small canoes or boats instead of larger, more powerful vessels; no engines or very simple low-power engines; and traditional fishing gear such as spears or hand reels, some nets","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/artisanalFishing"},{"path":["properties","subsistence_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/subsistenceFishing","description":"Fishing in order to feed the fisher's family - not sold","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/subsistenceFishing"},{"path":["properties","bottom_trawling"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/bottomTrawling","description":"A fishing practice that herds and captures the target species, like ground fish or crabs, by towing a net along the ocean floor","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/bottomTrawling"},{"path":["properties","pelagic_trawling"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/pelagicTrawling","description":"Pelagic or midwater trawling involves towing a large net through the water column. Trawls are designed to capture and trap the target species inside the codend as the net is hauled through the water","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/pelagicTrawling"},{"path":["properties","hook_and_line"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/hookAndLine","description":"A fishing method that catches fish by means of a series of baited hooks, which are suspended on lines into the ocean. Excludes trolling and longline, which are separate categories","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/hookAndLine"},{"path":["properties","trolling"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/trolling","description":"To trail artificial or natural baits behind a moving boat. The bait can be made to skip along the surface or trailed below at any depth to just above the bottom. A bait or lure trailed behind an angler walking along a pier, bridge, or breakwater is also called trolling","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/trolling"},{"path":["properties","purse_seine_surrounding_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/purseSeineSurroundingNets","description":"A net that encircles schools of fish","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/purseSeineSurroundingNets"},{"path":["properties","gillnets_entangling_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetsEntanglingNets","description":"Gillnets and entangling nets are walls of netting that hang in the water column, typically made of monofilament or multifilament nylon","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetsEntanglingNets"},{"path":["properties","trammel_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/trammelNets","description":"An entangling net that hangs down in several curtains","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/trammelNets"},{"path":["properties","dip_scoop_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/dipScoopNets","description":"A bag net with a handle that is used to scoop fish from the water","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/dipScoopNets"},{"path":["properties","cast_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/castNets","description":"A net constructed from a series of tailored netting sections joined together to produce a cone-shaped net with weights and a drawstring attached to the perimeter and cast by a fisher to catch fish","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/castNets"},{"path":["properties","drift_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/driftNets","description":"A fishing net that drifts with the tide or current and is buoyed or attached to a boat","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/driftNets"},{"path":["properties","other_nets"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/otherNets","description":"Any fishing net types not accounted for","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/otherNets"},{"path":["properties","dredges"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/dredges","description":"Dredges are dragged along the seafloor to catch shellfish. Dredges are made from an openmouthed frame that scoops shellfish from the seafloor. Attached to the back of the frame is a collection area made from metal rings or mesh","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/dredges"},{"path":["properties","traps_pots"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/trapsAndPots","description":"Traps and pots are submerged three-dimensional wire or wood devices that permit organisms to enter the enclosure but make escape extremely difficult or impossible","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/trapsAndPots"},{"path":["properties","spear_fishing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/spearFishing","description":"Fishing with a shaft with one or more sharpened points at one end","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/spearFishing"},{"path":["properties","underwater_extraction_diving"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/underwaterExtractionDiving","description":"Fishing or collecting marine life underwater by hand, spear, or harpoon gun with or without the use of an underwater breathing device gear","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/underwaterExtractionDiving"},{"path":["properties","hand_capture"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/handCapture","description":"Fishing or collecting by hand without the use of gear","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/handCapture"},{"path":["properties","fish_aggregating_devices"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/fishAggregatingDevices","description":"Floating objects that are designed and strategically placed to attract pelagic fish. Includes both static and free-floating","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/fishAggregatingDevices"},{"path":["properties","longlining"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/longlining","description":"A line that is deployed horizontally to which gangions and hooks are attached. A longline may be a bottom longline, i.e., designed for use on the bottom, or a pelagic longline, i.e., designed for use off the bottom. The longline hauler may be manually, electrically, or hydraulically operated","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/longlining"},{"path":["properties","gillnetting_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetting","description":"Gillnets are walls of netting that hang in the water column, typically made of monofilament or multifilament nylon","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/gillnetting"},{"path":["properties","nets_other_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/nets","description":"Any fishing net types not accounted for","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/nets"},{"path":["properties","gear_misc_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/miscellaneousGear","description":"Any fishing gear not included elsewhere","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/miscellaneousGear"},{"path":["properties","tribal_exemptions"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/tribalExemptions","description":"Are there tribal exemptions to fishing restrictions? Yes (0); No (1); Not Yet Coded (null)","schema_type":["integer","null"],"enum":[0,1,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/tribalExemptions"},{"path":["properties","discharge"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/discharge","description":"The deliberate disposal at sea of wastes or other matter from vessels","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/discharge"},{"path":["properties","vessel_speed"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselSpeed","description":"Speed of vessel. Prohibited (i.e. no transit) (1); Restricted (2); N/A or Unknown (3); Not Yet Coded (null)","schema_type":["integer","null"],"enum":[1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselSpeed"},{"path":["properties","vessel_entry"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselEntry","description":"Permittance of vessel types to enter or transit the area","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselEntry"},{"path":["properties","diving"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/diving","description":"Recreational, non-extractive, SCUBA diving or freediving","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/diving"},{"path":["properties","historic_artifact_removal"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/historicArtifactRemoval","description":"Removal of fossils or artifacts","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/historicArtifactRemoval"},{"path":["properties","vessel_stopping"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselStopping","description":"Permittance of vessels to stop in area (opposed to continuous transit required)","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/vesselStopping"},{"path":["properties","anchoring"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/anchoring","description":"Holding a vessel in place by mooring it to the seafloor with an anchor","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/anchoring"},{"path":["properties","mooring"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/mooring","description":"Securing a vessel to a fixed object, such as a mooring buoy","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/mooring"},{"path":["properties","landing"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/landing","description":"Stopping a vessel to load and unload things or people to/from land","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/landing"},{"path":["properties","dredging_dumping"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/dredgingDumping","description":"Removal of silt and other material from the bottom of bodies of water and/or dumping of dredged material","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/dredgingDumping"},{"path":["properties","industrial_exploration"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/industrialExploration","description":"Exploration methods for finding minerals, oil, and gas, for example seismic exploration","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/industrialExploration"},{"path":["properties","industrial_extraction"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/industrialExtraction","description":"Extraction of oil, gas, or minerals","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/industrialExtraction"},{"path":["properties","aquaculture"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/aquaculture","description":"Any type of marine farmed fishing","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/aquaculture"},{"path":["properties","construction"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/construction","description":"Development or construction of new infrastructure","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/construction"},{"path":["properties","overflight_drones"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/overflightDrones","description":"Overflight with manned or unmanned aircraft","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/overflightDrones"},{"path":["properties","anchor_dragging_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/anchorDragging","description":"Dragging an anchor along the seafloor","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/anchorDragging"},{"path":["properties","dredging_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/dredging","description":"Removal of silt and other material from the bottom of bodies of water","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/dredging"},{"path":["properties","drilling_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/drilling","description":"Drilling for the purpose of oil or gas extraction","schema_type":["integer","null"],"enum":[0,1,2,3,null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/drilling"},{"path":["properties","subzone"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/subzone","description":"1 = Subzone, 0 = not a subzone","schema_type":"integer","enum":[0,1],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/subzone"},{"path":["properties","primary_site_id"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/primarySiteId","description":"Site ID of the primary site of a subzone. NULL = not a subzone","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineP