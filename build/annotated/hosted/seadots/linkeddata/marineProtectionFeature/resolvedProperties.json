rineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/siteMajorVersion"},{"path":["properties","site_minor_version"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/siteMinorVersion","description":"Data minor version of site attributes and boundary","schema_type":"integer","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/siteMinorVersion"},{"path":["properties","version_start_date"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/versionStartDate","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date this version became effective","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/versionStartDate"},{"path":["properties","change_type_regulations"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/changeTypeRegulations","description":"Site regulations change between versions","schema_type":["string","null"],"enum":["Correction","Regulation Increase","Regulation Decrease","Regulation Neutral","New Site","Removed Site",null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/changeTypeRegulations"},{"path":["properties","change_type_boundary"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/changeTypeBoundary","description":"Site boundary change between versions","schema_type":["string","null"],"enum":["Correction","Boundary Increase","Boundary Decrease","Boundary Neutral","New Site","Removed Site",null],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/changeTypeBoundary"},{"path":["properties","regulation_updates_legacyV1"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/latestUpdates","description":"Email, phone number, and/or mailing lists to receive the latest updates on regulations regarding removal of marine life","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/latestUpdates"},{"path":["properties","last_update"],"id":"http://purl.org/dc/terms/modified","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date of the most recent site attributes update","schema_type":["string","null"],"sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"http://purl.org/dc/terms/modified"},{"path":["properties","last_reviewed"],"id":"https://w3id.org/ogc/hosted/demo/marine-protections/lastReviewed","jsonld_type":"http://www.w3.org/2001/XMLSchema#date","description":"Date of most recent ProtectedSeas review","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"],"effectiveId":"https://w3id.org/ogc/hosted/demo/marine-protections/lastReviewed"},{"path":["properties","geom_complexity"],"description":"Geometry complexity measure of the serving database (the sample value equals the vertex count of the geometry). Not listed in the Navigator data dictionary; a technical field with no semantic mapping.","schema_type":"integer","sources":["bblocks://ogc.hosted.seadots.linkeddata.marineProtectionProperties"]},{"path":["geometry","_oneOf","7","geometries","coordinates"],"id":"https://purl.org/geojson/vocab#coordinates","required":true,"schema_type":"array","sources":["bblocks://ogc.geo.common.data_types.geojson"],"effectiveId":"https://purl.org/geojson/vocab#coordinates"},{"path":["geometry","_oneOf","7","geometries","bbox"],"id":"https://purl.org/geojson/vocab#bbox","schema_type":"array","sources":["bblocks://ogc.geo.common.data_types.geojson"],"effectiveId":"https://purl.org/geojson/vocab#bbox"}]}