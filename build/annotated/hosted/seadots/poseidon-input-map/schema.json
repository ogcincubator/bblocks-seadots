{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POSEIDON Map Input",
  "description": "Spatial domain input for POSEIDON map initializers.",
  "type": "object",
  "required": [
    "initializerType"
  ],
  "properties": {
    "initializerType": {
      "type": "string",
      "examples": [
        "Simple Map",
        "From File Map",
        "OSMOSE Map",
        "Two Sided Map"
      ]
    },
    "mapFile": {
      "type": "string",
      "description": "Path or URI to a CSV-like map file when using a file-backed map initializer.",
      "x-jsonld-id": "http://purl.org/dc/terms/source"
    },
    "stacItem": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "$ref": "https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/item/schema.json"
        }
      ],
      "x-jsonld-id": "https://w3id.org/ogc/stac/Item",
      "x-jsonld-type": "@id"
    },
    "stacCollection": {
      "oneOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "$ref": "https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/collection/schema.json"
        }
      ],
      "x-jsonld-id": "https://w3id.org/ogc/stac/Collection",
      "x-jsonld-type": "@id"
    },
    "cellSizeInKilometers": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "gridWidthInCell": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "width": {
      "type": "number"
    },
    "height": {
      "type": "number"
    },
    "header": {
      "type": "boolean"
    },
    "latLong": {
      "type": "boolean"
    },
    "mapPaddingInDegrees": {
      "type": "number"
    },
    "minInitialDepth": {
      "type": "number"
    },
    "maxInitialDepth": {
      "type": "number"
    },
    "lowRightEasting": {
      "type": "number"
    },
    "lowRightNorthing": {
      "type": "number"
    },
    "upLeftEasting": {
      "type": "number"
    },
    "upLeftNorthing": {
      "type": "number"
    },
    "depthOverrides": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "farOffPorts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "x-jsonld-vocab": "https://w3id.org/iliad/seadots/poseidon/input#",
  "x-jsonld-prefixes": {
    "dcterms": "http://purl.org/dc/terms/",
    "stac": "https://w3id.org/ogc/stac/"
  }
}