@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ses: <https://w3id.org/ogc/hosted/seadots/emodnet-compliant-windfarm/baltic-project-extension#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ses:MatchCandidate a rdfs:Class ;
    rdfs:label "windfarm match candidate"@en ;
    rdfs:comment "A candidate relationship considered when comparing a source windfarm record with a target or reference record."@en .

<https://w3id.org/ogc/hosted/seadots/emodnet-compliant-windfarm/baltic-project-extension> a owl:Ontology ;
    dcterms:description "Additional project, source provenance, reporting-time, matching, and location terms used by the harmonized windfarm target."@en ;
    dcterms:title "Baltic windfarm project extension vocabulary"@en .

ses:candidateRankScore a rdf:Property ;
    rdfs:label "candidate rank score"@en ;
    rdfs:comment "Combined score used to rank a record-match candidate."@en ;
    rdfs:range xsd:decimal .

ses:capacityDifferenceMW a rdf:Property ;
    rdfs:label "capacity difference in megawatts"@en ;
    rdfs:comment "Difference between the reported capacities of two records, in megawatts."@en ;
    rdfs:range xsd:decimal .

ses:capacitySimilarity a rdf:Property ;
    rdfs:label "capacity similarity"@en ;
    rdfs:comment "Similarity score comparing reported power capacities."@en ;
    rdfs:range xsd:decimal .

ses:distanceKm a rdf:Property ;
    rdfs:label "distance in kilometres"@en ;
    rdfs:comment "Geographic separation between candidate locations, in kilometres."@en ;
    rdfs:range xsd:decimal .

ses:locationEmodnetIds a rdf:Property ;
    rdfs:label "EMODnet location record identifiers"@en ;
    rdfs:comment "Identifiers of EMODnet records used as location references for this project."@en ;
    rdfs:range xsd:string .

ses:locationMethod a rdf:Property ;
    rdfs:label "location method"@en ;
    rdfs:comment "Description of how a record's geometry was obtained or estimated."@en ;
    rdfs:range xsd:string .

ses:locationReference a rdf:Property ;
    rdfs:label "location reference"@en ;
    rdfs:comment "URI of a source supporting the location or location estimate."@en ;
    rdfs:range rdfs:Resource .

ses:locationStatus a rdf:Property ;
    rdfs:label "location status"@en ;
    rdfs:comment "How the record's location was obtained: supplied by the source, matched to reference data, anticipated from public evidence, or unmatched."@en ;
    rdfs:range xsd:string .

ses:matchMethod a rdf:Property ;
    rdfs:label "match method"@en ;
    rdfs:comment "Method used to identify or rank a relationship between records."@en ;
    rdfs:range xsd:string .

ses:nameSimilarity a rdf:Property ;
    rdfs:label "name similarity"@en ;
    rdfs:comment "Similarity score comparing the names of two candidate windfarm records."@en ;
    rdfs:range xsd:decimal .

ses:propertyAgreement a rdf:Property ;
    rdfs:label "property agreement"@en ;
    rdfs:comment "Score summarizing agreement between comparable non-name properties of two records."@en ;
    rdfs:range xsd:decimal .

ses:sourceDataset a rdf:Property ;
    rdfs:label "source dataset"@en ;
    rdfs:comment "Name or description of the dataset from which this record was translated."@en ;
    rdfs:range xsd:string .

ses:sourceRecord a rdf:Property ;
    rdfs:label "source record"@en ;
    rdfs:comment "The source record considered in a match candidate."@en ;
    rdfs:range rdfs:Resource .

ses:sourceRecordId a rdf:Property ;
    rdfs:label "source record identifier"@en ;
    rdfs:comment "Identifier or source name used to identify the record in its originating dataset."@en ;
    rdfs:range xsd:string .

ses:sourceReference a rdf:Property ;
    rdfs:label "source reference"@en ;
    rdfs:comment "URI of the source publication, service, or dataset for this record."@en ;
    rdfs:range rdfs:Resource .

ses:sourceSnapshotDate a rdf:Property ;
    rdfs:label "source snapshot date"@en ;
    rdfs:comment "Date on which the source data snapshot used for this record was retrieved."@en ;
    rdfs:range xsd:date .

ses:sourceType a rdf:Property ;
    rdfs:label "source type"@en ;
    rdfs:comment "Category of source represented by the record, such as national reporting or EMODnet."@en ;
    rdfs:range xsd:string .

ses:statusAsOf a rdf:Property ;
    rdfs:label "status as of date"@en ;
    rdfs:comment "Date on which the stated project status was reported or observed."@en ;
    rdfs:range xsd:date .

ses:statusDetail a rdf:Property ;
    rdfs:label "source status detail"@en ;
    rdfs:comment "Unnormalized status wording copied from the source record."@en ;
    rdfs:range xsd:string .

ses:statusMatch a rdf:Property ;
    rdfs:label "status match"@en ;
    rdfs:comment "Indicates whether the compared records report compatible statuses."@en ;
    rdfs:range xsd:boolean .

ses:targetRecord a rdf:Property ;
    rdfs:label "target record"@en ;
    rdfs:comment "The target or reference record considered in a match candidate."@en ;
    rdfs:range rdfs:Resource .

ses:yearIsAssumed a rdf:Property ;
    rdfs:label "year is assumed"@en ;
    rdfs:comment "Indicates whether the year value is an estimate or assumption rather than an explicit source statement."@en ;
    rdfs:range xsd:boolean .

ses:yearMatch a rdf:Property ;
    rdfs:label "year match"@en ;
    rdfs:comment "Indicates whether the compared records report compatible years."@en ;
    rdfs:range xsd:boolean .

ses:yearSemantics a rdf:Property ;
    rdfs:label "year meaning"@en ;
    rdfs:comment "Explanation of what the reported year represents, such as planned first power or a source-reported year."@en ;
    rdfs:range xsd:string .

