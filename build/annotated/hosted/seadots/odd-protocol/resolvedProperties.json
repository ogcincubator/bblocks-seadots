rl.org/dc/terms/modified","description":"The most recent date on which the record was changed.","schema_type":"string","format":"date-time","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/modified"},{"path":["properties","type"],"description":"The nature or genre of the resource. The value should be a code, convenient for filtering records. Where available, a link to the canonical URI of the record type resource will be added to the 'links' property.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"]},{"path":["properties","title"],"id":"http://purl.org/dc/terms/title","description":"A human-readable name given to the resource.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","description"],"id":"http://purl.org/dc/terms/description","description":"A free-text account of the resource.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","keywords"],"id":"http://www.w3.org/ns/dcat#keyword","description":"The topic or topics of the resource. Typically represented using free-form keywords, tags, key phrases, or classification codes.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#keyword"},{"path":["properties","language"],"id":"https://www.opengis.net/def/ogc-api/records/language","description":"The language used for textual values in this record representation.","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"ref":"0","effectiveId":"https://www.opengis.net/def/ogc-api/records/language"},{"path":["properties","languages"],"id":"https://www.opengis.net/def/ogc-api/records/languages","description":"This list of languages in which this record is available.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"ref":"0","effectiveId":"https://www.opengis.net/def/ogc-api/records/languages"},{"path":["properties","resourceLanguages"],"id":"https://www.opengis.net/def/ogc-api/records/resourceLanguages","description":"The list of languages in which the resource described by this record is available.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"ref":"0","effectiveId":"https://www.opengis.net/def/ogc-api/records/resourceLanguages"},{"path":["properties","externalIds"],"id":"https://www.opengis.net/def/ogc-api/records/scopedIdentifier","description":"An identifier for the resource assigned by an external (to the catalog) entity.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/scopedIdentifier"},{"path":["properties","externalIds","scheme"],"id":"https://www.opengis.net/def/ogc-api/records/scheme","description":"A reference to an authority or identifier for a knowledge organization system from which the external identifier was obtained. It is recommended that the identifier be a resolvable URI.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/scheme"},{"path":["properties","externalIds","value"],"id":"https://www.opengis.net/def/ogc-api/records/id","description":"The value of the identifier.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/id"},{"path":["properties","themes"],"id":"https://www.opengis.net/def/ogc-api/records/themes","description":"A knowledge organization system used to classify the resource.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/themes"},{"path":["properties","themes","concepts"],"id":"https://w3id.org/ogc/stac/themes/concepts","description":"One or more entity/concept identifiers from this knowledge\nsystem. it is recommended that a resolvable URI be used for\neach entity/concept identifier.","required":true,"schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/concepts"},{"path":["properties","themes","concepts","id"],"id":"https://w3id.org/ogc/stac/themes/id","description":"An identifier for the concept.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/id"},{"path":["properties","themes","concepts","title"],"id":"http://purl.org/dc/terms/title","description":"A human readable title for the concept.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","themes","concepts","description"],"id":"http://purl.org/dc/terms/description","description":"A human readable description for the concept.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","themes","concepts","url"],"id":"@id","description":"A URI providing further description of the concept.","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"@id"},{"path":["properties","themes","scheme"],"id":"https://w3id.org/ogc/stac/themes/scheme","description":"An identifier for the knowledge organization system used\nto classify the resource.  It is recommended that the\nidentifier be a resolvable URI.  The list of schemes used\nin a searchable catalog can be determined by inspecting\nthe server's OpenAPI document or, if the server implements\nCQL2, by exposing a queryable (e.g. named `scheme`) and\nenumerating the list of schemes in the queryable's schema\ndefinition.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/scheme"},{"path":["properties","formats"],"id":"https://www.opengis.net/def/ogc-api/records/format","jsonld_type":"@id","description":"A list of available distributions of the resource.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/format"},{"path":["properties","formats","name"],"id":"https://www.opengis.net/def/ogc-api/records/name","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/name"},{"path":["properties","formats","mediaType"],"id":"https://www.opengis.net/def/ogc-api/records/mediaType","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/mediaType"},{"path":["properties","contacts"],"id":"http://www.w3.org/ns/dcat#contactPoint","jsonld_type":"@id","description":"A list of contacts qualified by their role(s) in association to the record or the resource described by the record.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#contactPoint"},{"path":["properties","contacts","identifier"],"description":"A value uniquely identifying a contact.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","name"],"description":"The name of the responsible person.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","position"],"description":"The name of the role or position of the responsible person taken from the organization's formal organizational hierarchy or chart.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","organization"],"description":"Organization/affiliation of the contact.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","logo"],"description":"Graphic identifying a contact. The link relation should be `icon` and the media type should be an image media type.","sources":["bblocks://ogc.api.records.v1.schemas.contact"],"ref":"1"},{"path":["properties","contacts","logo","rel"],"required":true,"enum":["icon"],"sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","phones"],"description":"Telephone numbers at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","phones","value"],"description":"The value is the phone number itself.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","phones","roles"],"description":"The type of phone number (e.g. home, work, fax, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","emails"],"description":"Email addresses at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","emails","value"],"description":"The value is the email number itself.","required":true,"schema_type":"string","format":"email","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","emails","roles"],"description":"The type of email (e.g. home, work, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses"],"description":"Physical location at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","deliveryPoint"],"description":"Address lines for the location.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","city"],"description":"City for the location.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","administrativeArea"],"description":"State or province of the location.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","postalCode"],"description":"ZIP or other postal code.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","country"],"description":"Country of the physical address.  ISO 3166-1 is recommended.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","roles"],"description":"The type of address (e.g. office, home, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","links"],"description":"On-line information about the contact.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"],"ref":"1"},{"path":["properties","contacts","hoursOfService"],"description":"Time period when the contact can be contacted.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","contactInstructions"],"description":"Supplemental instructions on how or when to contact the\nresponsible party.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","roles"],"description":"The set of named duties, job functions and/or permissions associated with this contact. (e.g. developer, administrator, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","license"],"id":"http://www.w3.org/ns/dcat#license","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#license"},{"path":["properties","rights"],"id":"http://www.w3.org/ns/dcat#rights","description":"A statement that concerns all rights not addressed by the license such as a copyright statement.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#rights"},{"path":["linkTemplates"],"id":"https://www.opengis.net/def/ogc-api/records/hasLinkTemplate","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/hasLinkTemplate"},{"path":["linkTemplates","uriTemplate"],"id":"https://www.opengis.net/def/ogc-api/records/uriTemplate","jsonld_type":"xsd:string","description":"Supplies a resolvable URI to a remote resource (or resource fragment).","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.linkTemplate"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/uriTemplate"},{"path":["linkTemplates","varBase"],"id":"https://www.opengis.net/def/ogc-api/records/varBase","description":"The base URI to which the variable name can be appended to retrieve the definition of the variable as a JSON Schema fragment.","schema_type":"string","format":"url","sources":["bblocks://ogc.api.records.v1.schemas.linkTemplate"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/varBase"},{"path":["linkTemplates","variables"],"id":"https://www.opengis.net/def/ogc-api/records/hasVariable","description":"This object contains one key per substitution variable in the templated URL.  Each key defines the schema of one substitution variable using a JSON Schema fragment and can thus include things like the data type of the variable, enumerations, minimum values, maximum values, etc.","schema_type":"object","sources":["bblocks://ogc.api.records.v1.schemas.linkTemplate"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/hasVariable"},{"path":["properties","odd"],"id":"https://w3id.org/iliad/odd#","description":"ODD Protocol structured description. Keys map directly to the seven ODD elements. Each text field accepts plain prose; structured sub-fields provide vocabulary anchor points for domain profiles.\n","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#"},{"path":["properties","odd","purpose"],"id":"https://w3id.org/iliad/odd#purpose","description":"Why was the model developed? What question(s) does it address? Include any patterns the model is intended to reproduce (Pattern-Oriented Modeling).\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#purpose"},{"path":["properties","odd","patterns"],"id":"https://w3id.org/iliad/odd#patterns","description":"Empirical or stylised patterns used to design, parameterise, or validate the model. Each entry links to an observation or dataset (domain vocabulary slot).\n","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#patterns"},{"path":["properties","odd","patterns","name"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","odd","patterns","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","odd","patterns","reference"],"id":"http://purl.org/dc/terms/references","jsonld_type":"@id","description":"DOI, URL, or vocabulary term URI for the pattern source","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/references"},{"path":["properties","odd","entities"],"id":"https://w3id.org/iliad/odd#entities","description":"Agent types, environmental entities, and other model components. `stateVariables[].vocabularyTerm` is the slot for domain vocabulary injection (NERC, CF, Darwin Core, ICES, \u2026).\n","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#entities"},{"path":["properties","odd","entities","name"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","odd","entities","entityType"],"id":"https://w3id.org/iliad/odd#entityType","description":"Role of the entity: agent | patch | grid-cell | network-node | network-link | environment | resource | observer | other\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#entityType"},{"path":["properties","odd","entities","stateVariables"],"id":"https://w3id.org/iliad/odd#stateVariables","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#stateVariables"},{"path":["properties","odd","entities","stateVariables","name"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","odd","entities","stateVariables","type"],"id":"https://w3id.org/iliad/odd#variableType","description":"Data type (boolean, integer, real, string, list, \u2026)","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#variableType"},{"path":["properties","odd","entities","stateVariables","unit"],"id":"http://qudt.org/schema/qudt/unit","description":"Physical unit string (e.g. \"m s-1\"). For QUDT or NERC unit alignment, use vocabularyTerm.\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://qudt.org/schema/qudt/unit"},{"path":["properties","odd","entities","stateVariables","range"],"id":"https://w3id.org/iliad/odd#range","description":"Valid range or enumeration (e.g. \"[0, 1]\", \"non-negative\")","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#range"},{"path":["properties","odd","entities","stateVariables","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","odd","entities","stateVariables","vocabularyTerm"],"id":"http://www.w3.org/2004/02/skos/core#exactMatch","jsonld_type":"@id","description":"Authoritative URI for the variable concept. Priority: NERC > CF > Darwin Core > OBIS > ICES > OGC > schema.org\n","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://www.w3.org/2004/02/skos/core#exactMatch"},{"path":["properties","odd","entities","scales"],"id":"https://w3id.org/iliad/odd#scales","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#scales"},{"path":["properties","odd","entities","scales","spatial"],"id":"https://w3id.org/iliad/odd#spatialScale","description":"Spatial resolution and extent (e.g. \"1 m grid, 10 km \u00d7 10 km\")","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#spatialScale"},{"path":["properties","odd","entities","scales","temporal"],"id":"https://w3id.org/iliad/odd#temporalScale","description":"Time step and total duration (e.g. \"1 day, 30 years\")","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#temporalScale"},{"path":["properties","odd","processOverview"],"id":"https://w3id.org/iliad/odd#processOverview","description":"Which processes are executed, by whom, and in what order? The scheduling field must describe the temporal ordering precisely (e.g. \"synchronous, random order within step\").\n","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#processOverview"},{"path":["properties","odd","processOverview","scheduling"],"id":"https://w3id.org/iliad/odd#scheduling","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#scheduling"},{"path":["properties","odd","processOverview","processes"],"id":"https://w3id.org/iliad/odd#processes","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#processes"},{"path":["properties","odd","processOverview","processes","name"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","odd","processOverview","processes","executedBy"],"id":"https://w3id.org/iliad/odd#executedBy","description":"Entity type that runs this process","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#executedBy"},{"path":["properties","odd","processOverview","processes","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","odd","designConcepts"],"id":"https://w3id.org/iliad/odd#designConcepts","description":"The 11 design concepts defined by ODD. Each is a free-text field; domain profiles may add controlled-vocabulary annotations alongside.\n","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#designConcepts"},{"path":["properties","odd","designConcepts","basicPrinciples"],"id":"https://w3id.org/iliad/odd#basicPrinciples","description":"Which general theoretical or empirical concepts (theories, hypotheses, heuristics) underlie the model?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#basicPrinciples"},{"path":["properties","odd","designConcepts","emergence"],"id":"https://w3id.org/iliad/odd#emergence","description":"Which key model results emerge from agent interactions rather than being imposed directly on the agents?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#emergence"},{"path":["properties","odd","designConcepts","adaptation"],"id":"https://w3id.org/iliad/odd#adaptation","description":"What adaptive traits do agents have, and on what information are adaptation decisions based?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#adaptation"},{"path":["properties","odd","designConcepts","objectives"],"id":"https://w3id.org/iliad/odd#objectives","description":"What objectives do agents seek to achieve, and how are the objectives measured?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#objectives"},{"path":["properties","odd","designConcepts","learning"],"id":"https://w3id.org/iliad/odd#learning","description":"Do agents adapt their behaviour over time in response to experience? What algorithm is used?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#learning"},{"path":["properties","odd","designConcepts","prediction"],"id":"https://w3id.org/iliad/odd#prediction","description":"Do agents make predictions about future conditions? What methods or models are used for prediction?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#prediction"},{"path":["properties","odd","designConcepts","sensing"],"id":"https://w3id.org/iliad/odd#sensing","description":"What information can agents perceive about themselves and the environment? Are sensing assumptions justified?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#sensing"},{"path":["properties","odd","designConcepts","interaction"],"id":"https://w3id.org/iliad/odd#interaction","description":"What direct and indirect interactions occur among agents and between agents and the environment?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#interaction"},{"path":["properties","odd","designConcepts","stochasticity"],"id":"https://w3id.org/iliad/odd#stochasticity","description":"Which processes are represented as stochastic? How and why?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#stochasticity"},{"path":["properties","odd","designConcepts","collectives"],"id":"https://w3id.org/iliad/odd#collectives","description":"Are there collectives (groups, flocks, organisations, markets)? How are they represented and how do they affect agent behaviour?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#collectives"},{"path":["properties","odd","designConcepts","observation"],"id":"https://w3id.org/iliad/odd#observation","description":"What data are collected from the model for analysis? How are collectives, individuals, and the environment observed?\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#observation"},{"path":["properties","odd","initialization"],"id":"https://w3id.org/iliad/odd#initialization","description":"State of the model at t=0: number of agents, their initial attributes, spatial configuration, and how the initial state was chosen.\n","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#initialization"},{"path":["properties","odd","initialization","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","odd","initialization","seed"],"id":"https://w3id.org/iliad/odd#randomSeed","description":"How the random seed is specified or varied across runs","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#randomSeed"},{"path":["properties","odd","initialization","links"],"id":"http://www.w3.org/2000/01/rdf-schema#seeAlso","jsonld_type":"@id","description":"References to initialization data files or datasets (domain vocabulary slot for DCAT Dataset links).\n","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#seeAlso"},{"path":["properties","odd","initialization","links","href"],"id":"https://schema.org/url","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://schema.org/url"},{"path":["properties","odd","initialization","links","title"],"id":"http://purl.org/dc/terms/title","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","odd","initialization","links","type"],"id":"https://w3id.org/iliad/odd#variableType","description":"Media type","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#variableType"},{"path":["properties","odd","inputData"],"id":"https://w3id.org/iliad/odd#inputData","description":"External data sources (time series, maps, tables) used to drive or parameterise the model. `vocabularyTerm` is the domain slot for NERC, CF, or dataset-catalogue URIs.\n","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#inputData"},{"path":["properties","odd","inputData","name"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","odd","inputData","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","odd","inputData","source"],"id":"http://www.w3.org/ns/dcat#accessURL","jsonld_type":"@id","description":"Access URL (DCAT Distribution, OGC API, or DOI)","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://www.w3.org/ns/dcat#accessURL"},{"path":["properties","odd","inputData","format"],"id":"http://purl.org/dc/terms/format","description":"Media type or format name (e.g. \"text/csv\", \"NetCDF\")","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/format"},{"path":["properties","odd","inputData","temporalCoverage"],"id":"http://purl.org/dc/terms/temporal","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/temporal"},{"path":["properties","odd","inputData","vocabularyTerm"],"id":"http://www.w3.org/2004/02/skos/core#exactMatch","jsonld_type":"@id","description":"Concept URI for the variable or dataset type. Priority: NERC > CF > Darwin Core > OBIS > ICES > EMODnet\n","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://www.w3.org/2004/02/skos/core#exactMatch"},{"path":["properties","odd","submodels"],"id":"https://w3id.org/iliad/odd#submodels","description":"Detailed descriptions of each submodel. Equations and parameterisation choices that are not derivable from first principles must be fully documented here.\n","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#submodels"},{"path":["properties","odd","submodels","name"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","odd","submodels","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","odd","submodels","equations"],"id":"https://w3id.org/iliad/odd#equations","description":"Mathematical specification (LaTeX or plain text)","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#equations"},{"path":["properties","odd","submodels","parameterization"],"id":"https://w3id.org/iliad/odd#parameterization","description":"Parameter values, sources, and calibration approach","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#parameterization"},{"path":["properties","odd","submodels","links"],"id":"http://www.w3.org/2000/01/rdf-schema#seeAlso","jsonld_type":"@id","description":"References to code, data, or supplementary material","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#seeAlso"},{"path":["properties","odd","submodels","links","href"],"id":"https://schema.org/url","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://schema.org/url"},{"path":["properties","odd","submodels","links","rel"],"id":"https://w3id.org/iliad/odd#linkRel","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"https://w3id.org/iliad/odd#linkRel"},{"path":["properties","odd","submodels","links","title"],"id":"http://purl.org/dc/terms/title","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.odd-protocol"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["geometry","_oneOf","7","geometries","bbox"],"id":"https://purl.org/geojson/vocab#bbox","schema_type":"array","sources":["bblocks://ogc.geo.common.data_types.geojson"],"effectiveId":"https://purl.org/geojson/vocab#bbox"},{"path":["geometry","_oneOf","7","geometries","coordinates"],"id":"https://purl.org/geojson/vocab#coordinates","required":true,"schema_type":"array","sources":["bblocks://ogc.geo.common.data_types.geojson"],"effectiveId":"https://purl.org/geojson/vocab#coordinates"},{"path":["time","resolution"],"description":"Minimum time period resolvable in the dataset, as an ISO 8601 duration","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.time"]},{"path":["time","interval"],"schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.time"]},{"path":["time","timestamp"],"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.time"]},{"path":["time","date"],"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.time"]}]}