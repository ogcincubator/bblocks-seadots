org/dc/terms/temporal","vocab":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/temporal"},{"path":["properties","created"],"id":"http://purl.org/dc/terms/created","description":"Date of creation of this record.","schema_type":"string","format":"date-time","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/created"},{"path":["properties","updated"],"id":"http://purl.org/dc/terms/modified","description":"The most recent date on which the record was changed.","schema_type":"string","format":"date-time","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/modified"},{"path":["properties","type"],"description":"The nature or genre of the resource. The value should be a code, convenient for filtering records. Where available, a link to the canonical URI of the record type resource will be added to the 'links' property.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"]},{"path":["properties","title"],"id":"http://purl.org/dc/terms/title","description":"A human-readable name given to the resource.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","description"],"id":"http://purl.org/dc/terms/description","description":"A free-text account of the resource.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","keywords"],"id":"http://www.w3.org/ns/dcat#keyword","description":"The topic or topics of the resource. Typically represented using free-form keywords, tags, key phrases, or classification codes.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#keyword"},{"path":["properties","language"],"id":"https://www.opengis.net/def/ogc-api/records/language","description":"The language used for textual values in this record representation.","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"ref":"0","effectiveId":"https://www.opengis.net/def/ogc-api/records/language"},{"path":["properties","languages"],"id":"https://www.opengis.net/def/ogc-api/records/languages","description":"This list of languages in which this record is available.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"ref":"0","effectiveId":"https://www.opengis.net/def/ogc-api/records/languages"},{"path":["properties","resourceLanguages"],"id":"https://www.opengis.net/def/ogc-api/records/resourceLanguages","description":"The list of languages in which the resource described by this record is available.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"ref":"0","effectiveId":"https://www.opengis.net/def/ogc-api/records/resourceLanguages"},{"path":["properties","externalIds"],"id":"https://www.opengis.net/def/ogc-api/records/scopedIdentifier","description":"An identifier for the resource assigned by an external (to the catalog) entity.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/scopedIdentifier"},{"path":["properties","externalIds","scheme"],"id":"https://www.opengis.net/def/ogc-api/records/scheme","description":"A reference to an authority or identifier for a knowledge organization system from which the external identifier was obtained. It is recommended that the identifier be a resolvable URI.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/scheme"},{"path":["properties","externalIds","value"],"id":"https://www.opengis.net/def/ogc-api/records/id","description":"The value of the identifier.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/id"},{"path":["properties","themes"],"id":"https://www.opengis.net/def/ogc-api/records/themes","description":"A knowledge organization system used to classify the resource.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/themes"},{"path":["properties","themes","concepts"],"id":"https://w3id.org/ogc/stac/themes/concepts","description":"One or more entity/concept identifiers from this knowledge\nsystem. it is recommended that a resolvable URI be used for\neach entity/concept identifier.","required":true,"schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/concepts"},{"path":["properties","themes","concepts","id"],"id":"https://w3id.org/ogc/stac/themes/id","description":"An identifier for the concept.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/id"},{"path":["properties","themes","concepts","title"],"id":"http://purl.org/dc/terms/title","description":"A human readable title for the concept.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","themes","concepts","description"],"id":"http://purl.org/dc/terms/description","description":"A human readable description for the concept.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","themes","concepts","url"],"id":"@id","description":"A URI providing further description of the concept.","schema_type":"string","format":"uri","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"@id"},{"path":["properties","themes","scheme"],"id":"https://w3id.org/ogc/stac/themes/scheme","description":"An identifier for the knowledge organization system used\nto classify the resource.  It is recommended that the\nidentifier be a resolvable URI.  The list of schemes used\nin a searchable catalog can be determined by inspecting\nthe server's OpenAPI document or, if the server implements\nCQL2, by exposing a queryable (e.g. named `scheme`) and\nenumerating the list of schemes in the queryable's schema\ndefinition.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.theme"],"effectiveId":"https://w3id.org/ogc/stac/themes/scheme"},{"path":["properties","formats"],"id":"https://www.opengis.net/def/ogc-api/records/format","jsonld_type":"@id","description":"A list of available distributions of the resource.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/format"},{"path":["properties","formats","name"],"id":"https://www.opengis.net/def/ogc-api/records/name","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/name"},{"path":["properties","formats","mediaType"],"id":"https://www.opengis.net/def/ogc-api/records/mediaType","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/mediaType"},{"path":["properties","contacts"],"id":"http://www.w3.org/ns/dcat#contactPoint","jsonld_type":"@id","description":"A list of contacts qualified by their role(s) in association to the record or the resource described by the record.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#contactPoint"},{"path":["properties","contacts","identifier"],"description":"A value uniquely identifying a contact.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","name"],"description":"The name of the responsible person.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","position"],"description":"The name of the role or position of the responsible person taken from the organization's formal organizational hierarchy or chart.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","organization"],"description":"Organization/affiliation of the contact.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","logo"],"description":"Graphic identifying a contact. The link relation should be `icon` and the media type should be an image media type.","sources":["bblocks://ogc.api.records.v1.schemas.contact"],"ref":"1"},{"path":["properties","contacts","logo","rel"],"required":true,"enum":["icon"],"sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","phones"],"description":"Telephone numbers at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","phones","value"],"description":"The value is the phone number itself.","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","phones","roles"],"description":"The type of phone number (e.g. home, work, fax, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","emails"],"description":"Email addresses at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","emails","value"],"description":"The value is the email number itself.","required":true,"schema_type":"string","format":"email","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","emails","roles"],"description":"The type of email (e.g. home, work, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses"],"description":"Physical location at which contact can be made.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","deliveryPoint"],"description":"Address lines for the location.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","city"],"description":"City for the location.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","administrativeArea"],"description":"State or province of the location.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","postalCode"],"description":"ZIP or other postal code.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","country"],"description":"Country of the physical address.  ISO 3166-1 is recommended.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","addresses","roles"],"description":"The type of address (e.g. office, home, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","links"],"description":"On-line information about the contact.","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.contact"],"ref":"1"},{"path":["properties","contacts","hoursOfService"],"description":"Time period when the contact can be contacted.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","contactInstructions"],"description":"Supplemental instructions on how or when to contact the\nresponsible party.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","contacts","roles"],"description":"The set of named duties, job functions and/or permissions associated with this contact. (e.g. developer, administrator, etc.).","sources":["bblocks://ogc.api.records.v1.schemas.contact"]},{"path":["properties","license"],"id":"http://www.w3.org/ns/dcat#license","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#license"},{"path":["properties","rights"],"id":"http://www.w3.org/ns/dcat#rights","description":"A statement that concerns all rights not addressed by the license such as a copyright statement.","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"http://www.w3.org/ns/dcat#rights"},{"path":["linkTemplates"],"id":"https://www.opengis.net/def/ogc-api/records/hasLinkTemplate","vocab":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#","schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.recordGeoJSON"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/hasLinkTemplate"},{"path":["linkTemplates","uriTemplate"],"id":"https://www.opengis.net/def/ogc-api/records/uriTemplate","jsonld_type":"xsd:string","description":"Supplies a resolvable URI to a remote resource (or resource fragment).","required":true,"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.linkTemplate"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/uriTemplate"},{"path":["linkTemplates","varBase"],"id":"https://www.opengis.net/def/ogc-api/records/varBase","description":"The base URI to which the variable name can be appended to retrieve the definition of the variable as a JSON Schema fragment.","schema_type":"string","format":"url","sources":["bblocks://ogc.api.records.v1.schemas.linkTemplate"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/varBase"},{"path":["linkTemplates","variables"],"id":"https://www.opengis.net/def/ogc-api/records/hasVariable","description":"This object contains one key per substitution variable in the templated URL.  Each key defines the schema of one substitution variable using a JSON Schema fragment and can thus include things like the data type of the variable, enumerations, minimum values, maximum values, etc.","schema_type":"object","sources":["bblocks://ogc.api.records.v1.schemas.linkTemplate"],"effectiveId":"https://www.opengis.net/def/ogc-api/records/hasVariable"},{"path":["properties","experimentOutput"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#output","required":true,"schema_type":"object","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#output"},{"path":["properties","experimentOutput","name"],"id":"http://purl.org/dc/terms/title","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["properties","experimentOutput","description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["properties","experimentOutput","role"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#role","description":"`primary result`, `catalog`, `provenance`, `diagnostic`.\n","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#role"},{"path":["properties","experimentOutput","format"],"id":"http://purl.org/dc/terms/format","description":"Media type or format profile URI.","required":true,"schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://purl.org/dc/terms/format"},{"path":["properties","experimentOutput","vocabularyTerm"],"id":"http://www.w3.org/2004/02/skos/core#exactMatch","jsonld_type":"@id","description":"Concept URI for the produced quantity.","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/2004/02/skos/core#exactMatch"},{"path":["properties","experimentOutput","experiment"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect#experiment","jsonld_type":"@id","description":"URI of the experiment record that produced this output.","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect#experiment"},{"path":["properties","experimentOutput","observedProperty"],"id":"http://www.w3.org/ns/sosa/observedProperty","jsonld_type":"@id","description":"SOSA-aligned. URI of the property observed by this output. For the reef-biomass result this is the `floating-wind-reef-biomass` indicator URI. Carrying this field aligns the record with the OIM-OBS / SOSA observation profile.\n","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/sosa/observedProperty"},{"path":["properties","experimentOutput","hasSimpleResult"],"id":"http://www.w3.org/ns/sosa/hasSimpleResult","description":"SOSA-aligned. The simple (scalar or short structured) result of the observation/calculation. Type follows the observed property; for B_reef this is the headline scalar in kg with units carried by `hasSimpleResultUnit`.\n","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/sosa/hasSimpleResult"},{"path":["properties","experimentOutput","hasSimpleResultUnit"],"id":"http://qudt.org/schema/qudt/unit","description":"Units of `hasSimpleResult` (e.g. `kg`, `t`, `kg m-2`).","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://qudt.org/schema/qudt/unit"},{"path":["properties","experimentOutput","resultTime"],"id":"http://www.w3.org/ns/sosa/resultTime","jsonld_type":"http://www.w3.org/2001/XMLSchema#dateTime","description":"SOSA-aligned. Time at which the result was produced or applies. For a standing-stock calculation, the end-of-scenario instant.\n","schema_type":"string","format":"date-time","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/sosa/resultTime"},{"path":["properties","experimentOutput","phenomenonTime"],"id":"http://www.w3.org/ns/sosa/phenomenonTime","description":"SOSA-aligned. Time interval over which the observed phenomenon occurred (e.g. the scenario interval). String, or object with `start` and `end` keys.\n","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/sosa/phenomenonTime"},{"path":["properties","experimentOutput","hasFeatureOfInterest"],"id":"http://www.w3.org/ns/sosa/hasFeatureOfInterest","jsonld_type":"@id","description":"SOSA-aligned. URI of the feature of interest (typically the AOI `area-of-interest` record, typically).\n","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/sosa/hasFeatureOfInterest"},{"path":["properties","experimentOutput","conformsTo"],"id":"http://purl.org/dc/terms/conformsTo","jsonld_type":"@id","description":"Conformance classes the output is expected to satisfy.","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://purl.org/dc/terms/conformsTo"},{"path":["properties","experimentOutput","aggregation"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#aggregation","description":"How the output aggregates over the equation index, when applicable (e.g. `sum-over-i`, `per-taxon`, `scalar`).\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#aggregation"},{"path":["properties","experimentOutput","data"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#data","description":"Representative inline result of this output. For a primary result, typically a `headline` scalar/CI plus `perTaxon`, `timeSeries`, and `uncertainty` sub-objects. For a catalog or provenance record, may be a small structural sample. Shape is format-specific and not further constrained.\n","schema_type":"object","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#data"},{"path":["properties","experimentOutput","data","provenance"],"id":"http://www.w3.org/ns/prov#wasDerivedFrom","description":"Source pointer for every concrete value in this `data` block. Required on every example.\n","required":true,"schema_type":"object","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/prov#wasDerivedFrom"},{"path":["properties","experimentOutput","data","provenance","values"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#provenanceValues","description":"`computed` \u2014 values are the deterministic result of applying the documented equation to the cited input records (must list `derivedFrom`). `retrieved` \u2014 values came from the cited API call. `illustrative` \u2014 placeholders for schema shape. `mixed` \u2014 some are computed/retrieved and the rest are illustrative, annotated in-line.\n","required":true,"schema_type":"string","enum":["computed","retrieved","illustrative","mixed"],"sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#provenanceValues"},{"path":["properties","experimentOutput","data","provenance","derivedFrom"],"id":"http://www.w3.org/ns/prov#wasDerivedFrom","jsonld_type":"@id","description":"URIs of the input records that drive these values. Required when `values=computed`.\n","schema_type":"array","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/prov#wasDerivedFrom"},{"path":["properties","experimentOutput","data","provenance","equationRecord"],"id":"http://www.w3.org/ns/prov#hadPlan","jsonld_type":"@id","description":"URI of the equation-property-relationship record that defines the closed-form expression evaluated here.\n","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/ns/prov#hadPlan"},{"path":["properties","experimentOutput","data","provenance","computedOn"],"id":"http://purl.org/dc/terms/date","description":"ISO date the values were last computed.","schema_type":"string","format":"date","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://purl.org/dc/terms/date"},{"path":["properties","experimentOutput","data","provenance","computeCode"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#computeCode","jsonld_type":"@id","description":"URI of the script / notebook that produced these values.\n","schema_type":"string","format":"uri","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#computeCode"},{"path":["properties","experimentOutput","data","provenance","uncertaintyMethod"],"id":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#uncertaintyMethod","description":"Name of the uncertainty-propagation method applied (e.g. `log-linear CV`, `Monte Carlo`, `analytic first-order`).\n","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"https://w3id.org/ogc/hosted/seadots/reef-effect-output#uncertaintyMethod"},{"path":["properties","experimentOutput","data","provenance","note"],"id":"http://www.w3.org/2004/02/skos/core#note","schema_type":"string","sources":["bblocks://ogc.hosted.seadots.reef-effect-output"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["geometry","_oneOf","7","geometries","bbox"],"id":"https://purl.org/geojson/vocab#bbox","schema_type":"array","sources":["bblocks://ogc.geo.common.data_types.geojson"],"effectiveId":"https://purl.org/geojson/vocab#bbox"},{"path":["geometry","_oneOf","7","geometries","coordinates"],"id":"https://purl.org/geojson/vocab#coordinates","required":true,"schema_type":"array","sources":["bblocks://ogc.geo.common.data_types.geojson"],"effectiveId":"https://purl.org/geojson/vocab#coordinates"},{"path":["time","resolution"],"description":"Minimum time period resolvable in the dataset, as an ISO 8601 duration","schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.time"]},{"path":["time","interval"],"schema_type":"array","sources":["bblocks://ogc.api.records.v1.schemas.time"]},{"path":["time","timestamp"],"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.time"]},{"path":["time","date"],"schema_type":"string","sources":["bblocks://ogc.api.records.v1.schemas.time"]}]}