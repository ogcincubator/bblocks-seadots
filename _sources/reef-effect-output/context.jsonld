{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://w3id.org/ogc/hosted/seadots/reef-effect-output#",

    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sosa": "http://www.w3.org/ns/sosa/",
    "ssn": "http://www.w3.org/ns/ssn/",
    "dwc": "http://rs.tdwg.org/dwc/terms/",
    "qudt": "http://qudt.org/schema/qudt/",
    "unit": "http://qudt.org/vocab/unit/",
    "seadots": "https://w3id.org/ogc/hosted/seadots/reef-effect-output#",
    "indo": "https://w3id.org/indicators/marine/obs/",
    "indp": "https://w3id.org/indicators/marine/parameters/",
    "ind": "https://w3id.org/indicators/marine/",

    "id": "@id",
    "type": "@type",
    "geometry": "https://purl.org/geojson/vocab#geometry",
    "coordinates": "https://purl.org/geojson/vocab#coordinates",
    "Feature": "https://purl.org/geojson/vocab#Feature",
    "Polygon": "https://purl.org/geojson/vocab#Polygon",
    "properties": "https://purl.org/geojson/vocab#properties",
    "links": { "@id": "http://www.w3.org/ns/iana/link-relations/relation", "@container": "@set" },
    "href": { "@id": "@id" },
    "rel": "https://purl.org/geojson/vocab#rel",

    "title": "dcterms:title",
    "name": "dcterms:title",
    "description": "dcterms:description",
    "created": "dcterms:created",
    "updated": "dcterms:modified",
    "language": "dcterms:language",
    "code": "dcterms:identifier",
    "license": "dcterms:license",
    "keywords": { "@id": "dcat:keyword", "@container": "@set" },
    "themes": { "@id": "dcat:theme", "@container": "@set" },
    "concepts": { "@id": "skos:Concept", "@container": "@set" },
    "scheme": "skos:inScheme",
    "label": "skos:prefLabel",
    "formats": { "@id": "dcterms:format", "@container": "@set" },
    "format": "dcterms:format",
    "mediaType": "dcterms:format",
    "conformsTo": { "@id": "dcterms:conformsTo", "@type": "@id", "@container": "@set" },

    "experimentOutput": "seadots:output",
    "role": "seadots:role",
    "vocabularyTerm": { "@id": "skos:exactMatch", "@type": "@id" },
    "experiment": { "@id": "https://w3id.org/ogc/hosted/seadots/reef-effect#experiment", "@type": "@id" },
    "aggregation": "seadots:aggregation",

    "observedProperty": { "@id": "sosa:observedProperty", "@type": "@id" },
    "hasSimpleResult": "sosa:hasSimpleResult",
    "hasSimpleResultUnit": "qudt:unit",
    "resultTime": { "@id": "sosa:resultTime", "@type": "http://www.w3.org/2001/XMLSchema#dateTime" },
    "phenomenonTime": "sosa:phenomenonTime",
    "start": { "@id": "http://www.w3.org/2006/time#hasBeginning", "@type": "http://www.w3.org/2001/XMLSchema#dateTime" },
    "end": { "@id": "http://www.w3.org/2006/time#hasEnd", "@type": "http://www.w3.org/2001/XMLSchema#dateTime" },
    "hasFeatureOfInterest": { "@id": "sosa:hasFeatureOfInterest", "@type": "@id" },

    "data": "seadots:data",
    "equation": "seadots:equation",
    "asOf_months": "seadots:asOf_months",
    "scenarioInterval": "dcterms:temporal",
    "units": "qudt:unit",

    "headline": "seadots:headline",
    "B_reef_kg": { "@id": "indo:floating-wind-reef-biomass-effect", "@type": "qudt:QuantityValue" },
    "B_reef_tonnes": { "@id": "indo:floating-wind-reef-biomass-effect", "@type": "qudt:QuantityValue" },
    "sigma_kg": "qudt:standardUncertainty",
    "sigma_tonnes": "qudt:standardUncertainty",
    "totalSigma_kg": "qudt:standardUncertainty",
    "totalSigma_tonnes": "qudt:standardUncertainty",
    "CV": "qudt:coefficientOfVariation",
    "totalCV": "qudt:coefficientOfVariation",
    "ci95_kg": "seadots:ci95_kg",
    "ci95_tonnes": "seadots:ci95_tonnes",

    "perTaxonAtT24": { "@id": "seadots:perTaxonAtT24", "@container": "@set" },
    "scientificName": "dwc:scientificName",
    "aphiaID": "dwc:taxonID",
    "A_sub_m2": { "@id": "indp:submerged-infrastructure-area", "@type": "qudt:QuantityValue" },
    "D_pre_kg_m2": { "@id": "indo:baseline-benthic-biomass-density", "@type": "qudt:QuantityValue" },
    "AF_i": { "@id": "indp:reef-aggregation-index", "@type": "qudt:DimensionlessQuantity" },
    "C_t": { "@id": "indp:colonisation-time-factor", "@type": "qudt:DimensionlessQuantity" },
    "B_kg": { "@id": "indo:floating-wind-reef-biomass-effect", "@type": "qudt:QuantityValue" },
    "shareOfTotal": "seadots:shareOfTotal",

    "timeSeries": { "@id": "seadots:timeSeries", "@container": "@list" },
    "t_months": "seadots:t_months",
    "timeSeriesNote": "skos:note",

    "uncertainty": "seadots:uncertainty",
    "method": "dcterms:methodology",
    "methodDetail": "skos:definition",
    "uncertaintyMethod": "seadots:uncertaintyMethod",

    "inputs": { "@id": "seadots:uncertaintyInput", "@container": "@set" },
    "variable": "seadots:variable",
    "value": "qudt:value",
    "valueUnits": "qudt:unit",
    "sigma": "qudt:standardUncertainty",
    "valueSource": "dcterms:source",
    "valueKind": "seadots:valueKind",
    "sigmaSource": "dcterms:source",
    "sigmaKind": "seadots:sigmaKind",

    "perTaxonVariance": { "@id": "seadots:perTaxonVariance", "@container": "@set" },
    "D_times_AF": "seadots:D_times_AF",
    "var_D_times_AF": "seadots:var_D_times_AF",
    "shareWithinS": "seadots:shareWithinS",
    "S_value_kg_m2": "seadots:S_value_kg_m2",
    "S_sigma_kg_m2": "seadots:S_sigma_kg_m2",
    "S_CV": "seadots:S_CV",

    "varianceAttribution": { "@id": "seadots:varianceAttribution", "@container": "@set" },
    "term": "skos:notation",
    "CV_squared": "seadots:CV_squared",
    "dominantUncertainty": "seadots:dominantUncertainty",

    "caveats": { "@id": "skos:note", "@container": "@set" },

    "provenance": "prov:wasDerivedFrom",
    "values": "seadots:provenanceValues",
    "derivedFrom": { "@id": "prov:wasDerivedFrom", "@type": "@id", "@container": "@set" },
    "equationRecord": { "@id": "prov:hadPlan", "@type": "@id" },
    "computedOn": "dcterms:date",
    "computeCode": { "@id": "seadots:computeCode", "@type": "@id" },
    "computeCodeNote": "skos:note",
    "note": "skos:note"
  }
}
