{
  "@context": {
    "@version": 1.1,
    "geojson": "https://purl.org/geojson/vocab#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "osmdata": "https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "type": "@type",
    "FeatureCollection": "geojson:FeatureCollection",
    "Feature": "geojson:Feature",
    "Point": "geojson:Point",
    "Polygon": "geojson:Polygon",
    "MultiPoint": "geojson:MultiPoint",
    "LineString": "geojson:LineString",
    "MultiLineString": "geojson:MultiLineString",
    "MultiPolygon": "geojson:MultiPolygon",
    "GeometryCollection": "geojson:GeometryCollection",
    "id": {"@id": "osmdata:sourceElementReference", "@type": "xsd:string"},
    "source": "dcterms:source",
    "features": {"@id": "geojson:features", "@container": "@set"},
    "geometry": "geojson:geometry",
    "coordinates": {"@id": "geojson:coordinates", "@container": "@list"},
    "properties": "geojson:properties",
    "osm_type": "osmdata:elementType",
    "osm_id": {"@id": "osmdata:elementIdentifier", "@type": "xsd:integer"},
    "tags": {"@id": "osmdata:tagSet", "@type": "@json"},
    "members": {"@id": "osmdata:relationMemberReference", "@container": "@list"}
  }
}
