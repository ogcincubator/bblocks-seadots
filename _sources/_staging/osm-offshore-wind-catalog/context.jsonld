{
  "@context": [
    "../../catalog-data-tabular/context.jsonld",
    {
      "osm": "https://www.openstreetmap.org/",
      "odrl": "http://www.w3.org/ns/odrl/2/",
      "schema": "https://schema.org/",
      "retrieved": {
        "@id": "http://purl.org/dc/terms/date",
        "@type": "http://www.w3.org/2001/XMLSchema#date"
      },
      "coverage_note": "http://purl.org/dc/terms/description",
      "feature_count": {
        "@id": "https://schema.org/numberOfItems",
        "@type": "http://www.w3.org/2001/XMLSchema#integer"
      },
      "geometry_counts": "https://schema.org/additionalProperty",
      "extent": {
        "@id": "http://www.opengis.net/ont/geosparql#hasBoundingBox"
      },
      "attribution": "http://purl.org/dc/terms/rightsHolder",
      "source": {
        "@id": "http://purl.org/dc/terms/source",
        "@type": "@id"
      },
      "license": "http://purl.org/dc/terms/license"
    }
  ]
}
