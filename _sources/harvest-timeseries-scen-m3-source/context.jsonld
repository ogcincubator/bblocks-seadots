{
  "@context": {
    "geojson": "https://purl.org/geojson/vocab#",
    "dct": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "type": {"@id": "@type"},
    "features": {"@id": "geojson:features"},
    "id": {"@id": "dct:identifier", "@type": "xsd:integer"},
    "geometry": {"@id": "geojson:geometry"},
    "coordinates": {"@id": "geojson:coordinates"},
    "properties": {"@id": "geojson:properties"},
    "time": {"@id": "dct:temporal"},
    "bwmus": {"@id": "https://w3id.org/iliad/property/bwmus", "@type": "xsd:double"}
  }
}
