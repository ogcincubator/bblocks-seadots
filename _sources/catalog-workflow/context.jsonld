{
  "@context": [
    "https://ogcincubator.github.io/geodcat-ogcapi-records/build/annotated/geo/geodcat/geodcat-records/context.jsonld",
    "https://ogcincubator.github.io/bblock-prov-schema/build/annotated/ogc-utils/prov-entity/context.jsonld",
    {
      "@version": 1.1,
      "@vocab": "https://w3id.org/ogc/hosted/seadots/catalog#",
      "apkg": "https://w3id.org/apkg/terms/",
      "dcterms": "http://purl.org/dc/terms/",
      "prov": "http://www.w3.org/ns/prov#",
      "schema": "https://schema.org/",
      "seadots": "https://w3id.org/ogc/hosted/seadots/catalog#",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "Workflow": "prov:Plan",
      "applicationCategory": "schema:applicationCategory",
      "version": "dcterms:hasVersion",
      "method": "dcterms:method",
      "activity": {
        "@id": "prov:activity",
        "@type": "@id"
      },
      "softwareVersion": "schema:softwareVersion",
      "programmingLanguage": "schema:programmingLanguage",
      "applicationPackage": {
        "@id": "seadots:applicationPackage",
        "@type": "@id"
      },
      "inputs": {
        "@id": "apkg:inputs",
        "@container": "@set"
      },
      "outputs": {
        "@id": "apkg:outputs",
        "@container": "@set"
      },
      "profileId": {
        "@id": "dcterms:conformsTo",
        "@type": "@id"
      },
      "required": {
        "@id": "seadots:required",
        "@type": "xsd:boolean"
      },
      "role": "seadots:role"
    }
  ]
}
