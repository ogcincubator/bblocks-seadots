{
  "@context": {
    "@version": 1.1,
    "pa": "https://w3id.org/ogc/hosted/seadots/emodnet-protected-area/",
    "seadotsTransformReport": "pa:transformReport",
    "excluded": { "@id": "pa:excludedSite", "@container": "@set" },
    "reason": "pa:exclusionReason",
    "notYetReportedToEEA": { "@id": "pa:notYetReportedToEEA", "@container": "@set" },
    "needsMarineAreaOverlay": { "@id": "pa:needsMarineAreaOverlay", "@container": "@set" },
    "inferredDesignation": { "@id": "pa:inferredDesignation", "@container": "@set" },
    "differsFromEMODnet": { "@id": "pa:differsFromEMODnet", "@container": "@set" },
    "fields": { "@id": "pa:fieldDifferences", "@type": "@json" },
    "routedToNatura2000": { "@id": "pa:routedToNatura2000", "@container": "@set" },
    "routedToNationallyDesignatedAreas": { "@id": "pa:routedToNationallyDesignatedAreas", "@container": "@set" },
    "unresolvedCode": { "@id": "pa:unresolvedCode", "@container": "@set" },
    "noStatusInRegister": { "@id": "pa:noStatusInRegister", "@container": "@set" },
    "mergedParts": { "@id": "pa:mergedParts", "@type": "@json" },
    "target": "pa:routingTarget",
    "nationalid": "pa:nationalSiteId",
    "verneform": "pa:nationalDesignationType",
    "designatio": "pa:designationType",
    "code": "pa:siteCode",
    "name": "pa:siteName",
    "country": "pa:countryName",
    "type": "pa:sourceDesignationTypeLabel"
  }
}
