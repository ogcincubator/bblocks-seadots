{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://w3id.org/ogc/hosted/seadots/benthic-biomass-observations-imr#",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dwc": "http://rs.tdwg.org/dwc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "qudt": "http://qudt.org/schema/qudt/",
    "sosa": "http://www.w3.org/ns/sosa/",
    "sdn": "https://vocab.nerc.ac.uk/collection/SDN/current/",
    "time": "http://www.w3.org/2006/time#",
    "seadots": "https://w3id.org/ogc/hosted/seadots/benthic-biomass-observations-imr#",

    "id": "@id",
    "type": "@type",
    "FeatureCollection": "https://purl.org/geojson/vocab#FeatureCollection",
    "Feature": "https://purl.org/geojson/vocab#Feature",
    "Point": "https://purl.org/geojson/vocab#Point",
    "Polygon": "https://purl.org/geojson/vocab#Polygon",
    "bbox": "https://purl.org/geojson/vocab#bbox",
    "geometry": "https://purl.org/geojson/vocab#geometry",
    "coordinates": { "@id": "https://purl.org/geojson/vocab#coordinates", "@container": "@list" },
    "properties": "https://purl.org/geojson/vocab#properties",
    "features": { "@id": "https://purl.org/geojson/vocab#features", "@container": "@set" },
    "links": { "@id": "http://www.w3.org/ns/iana/link-relations/relation", "@container": "@set" },
    "href": { "@id": "@id" },
    "rel": "https://purl.org/geojson/vocab#rel",

    "title": "dcterms:title",
    "description": "dcterms:description",
    "created": "dcterms:created",
    "source": "dcterms:source",
    "name": "dcterms:title",
    "api": { "@id": "dcat:accessURL", "@type": "@id" },
    "speciesListEndpoint": { "@id": "seadots:speciesListEndpoint", "@type": "@id" },
    "perSpeciesEndpoint": "seadots:perSpeciesEndpoint",
    "license": "dcterms:license",
    "aoi": "seadots:areaOfInterest",
    "phenomenonTime": "time:hasTime",
    "start": { "@id": "time:hasBeginning", "@type": "http://www.w3.org/2001/XMLSchema#date" },
    "end": { "@id": "time:hasEnd", "@type": "http://www.w3.org/2001/XMLSchema#date" },

    "summary": "seadots:summary",
    "speciesQueried": "seadots:speciesQueried",
    "cruiseQueries": { "@id": "seadots:cruiseQueries", "@container": "@set" },
    "apiQueries": "seadots:apiQueries",
    "sourceFeatures": "seadots:sourceFeatures",
    "featuresInAOI": "seadots:featuresInAOI",
    "speciesInAOI": { "@id": "seadots:speciesInAOI", "@container": "@set" },
    "cruisesInAOI": { "@id": "seadots:cruisesInAOI", "@container": "@set" },
    "equipmentInAOI": { "@id": "seadots:equipmentInAOI", "@container": "@set" },

    "provenance": "prov:wasDerivedFrom",
    "values": "seadots:provenanceValues",
    "generator": "prov:wasGeneratedBy",
    "fetched_utc": "prov:generatedAtTime",
    "cacheDirectory": "seadots:cacheDirectory",
    "timeBoundaryNote": "seadots:timeBoundaryNote",

    "scientificName": "dwc:scientificName",
    "species": "dwc:scientificName",
    "sourceSpeciesQuery": "dwc:scientificName",
    "sourceCruiseQuery": "seadots:sourceCruiseQuery",
    "cruise": "sdn:cruise",
    "equipment": "sosa:usedProcedure",
    "Cruise": "sdn:cruise",
    "Equipment": "sosa:usedProcedure",
    "Scientific name": "dwc:scientificName",
    "Number": "dwc:individualCount",
    "Weight": { "@id": "sosa:hasSimpleResult", "@type": "qudt:QuantityValue" },
    "Catch Id": "dcterms:identifier",
    "Sample Number": "dwc:materialSampleID",
    "Station (R)": "dwc:locality",
    "Bottom depth": "sdn:depthMax"
  }
}
