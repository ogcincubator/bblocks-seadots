    "foaf": "http://xmlns.com/foaf/0.1/",
    "rsc": { "@id": "pa:regionalSeaConvention", "@type": "@vocab", "@context": { "@vocab": "https://w3id.org/ogc/hosted/seadots/emodnet-protected-area/rsc/" } },
    "code": "pa:conventionSiteCode",
    "name": "pa:siteName",
    "orig_name": "pa:originalSiteName",
    "country": "pa:countryName",
    "designatio": "pa:designationLabel",
    "iucn_cat": { "@id": "pa:iucnCategory", "@type": "@vocab", "@context": { "@vocab": "https://w3id.org/ogc/hosted/seadots/emodnet-protected-area/iucn/" } },
    "rep_m_area": { "@id": "pa:reportedMarineArea", "@type": "xsd:double" },
    "gis_m_area": { "@id": "pa:gisMarineArea", "@type": "xsd:double" },
    "rep_area": { "@id": "pa:reportedArea", "@type": "xsd:double" },
    "gis_area": { "@id": "pa:gisArea", "@type": "xsd:double" },
    "status": "pa:managementStatus",
    "status_yr": { "@id": "pa:establishmentYear", "@type": "xsd:gYear" },
    "mang_auth": "pa:managementAuthority",
    "link": { "@id": "foaf:page", "@type": "@id" },
    "shape_leng": { "@id": "pa:shapeLengthDegrees", "@type": "xsd:double" },
    "shape_area": { "@id": "pa:shapeAreaSquareDegrees", "@type": "xsd:double" }
  }
}
