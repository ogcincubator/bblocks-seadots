{
  "@context": [
    "https://ogcincubator.github.io/geodcat-ogcapi-records/build/annotated/geo/geodcat/geodcat-records-prov/context.jsonld",
    {
      "@version": 1.1,
      "@vocab": "https://w3id.org/ogc/hosted/seadots/catalog#",
      "prov": "http://www.w3.org/ns/prov#",
      "seadots": "https://w3id.org/ogc/hosted/seadots/catalog#",
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "Execution": "prov:Activity",
      "workflow": {
        "@id": "prov:hadPlan",
        "@type": "@id"
      },
      "inputRecords": {
        "@id": "prov:used",
        "@container": "@set",
        "@type": "@id"
      },
      "outputRecords": {
        "@id": "prov:generated",
        "@container": "@set",
        "@type": "@id"
      },
      "startTime": {
        "@id": "prov:startedAtTime",
        "@type": "xsd:dateTime"
      },
      "endTime": {
        "@id": "prov:endedAtTime",
        "@type": "xsd:dateTime"
      },
      "status": "seadots:status",
      "parameters": "seadots:parameters"
    }
  ]
}
