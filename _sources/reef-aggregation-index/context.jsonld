{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://w3id.org/ogc/hosted/seadots/reef-aggregation-index#",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "prov": "http://www.w3.org/ns/prov#",
    "dwc": "http://rs.tdwg.org/dwc/terms/",
    "qudt": "http://qudt.org/schema/qudt/",
    "seadots": "https://w3id.org/ogc/hosted/seadots/reef-aggregation-index#",
    "indo": "https://id3.seadots.eu/indicator/",

    "id": "@id",
    "type": "@type",
    "geometry": "https://purl.org/geojson/vocab#geometry",
    "Feature": "https://purl.org/geojson/vocab#Feature",
    "properties": "https://purl.org/geojson/vocab#properties",
    "links": { "@id": "http://www.w3.org/ns/iana/link-relations/relation", "@container": "@set" },
    "href": { "@id": "@id" },
    "rel": "https://purl.org/geojson/vocab#rel",

    "title": "dcterms:title",
    "name": "dcterms:title",
    "description": "dcterms:description",
    "created": "dcterms:created",
    "updated": "dcterms:modified",
    "language": "dcterms:language",
    "license": "dcterms:license",
    "keywords": { "@id": "dcat:keyword", "@container": "@set" },
    "themes": { "@id": "dcat:theme", "@container": "@set" },
    "concepts": { "@id": "skos:Concept", "@container": "@set" },
    "scheme": "skos:inScheme",
    "label": "skos:prefLabel",
    "formats": { "@id": "dcterms:format", "@container": "@set" },
    "format": "dcterms:format",
    "mediaType": "dcterms:format",

    "reefAggregationIndex": "seadots:reefAggregationIndex",
    "role": "seadots:role",
    "source": { "@id": "dcat:accessURL", "@type": "@id" },
    "vocabularyTerm": { "@id": "skos:exactMatch", "@type": "@id" },
    "data": "seadots:data",
    "units": "qudt:unit",

    "perTaxon": { "@id": "seadots:perTaxon", "@container": "@set" },
    "scientificName": "dwc:scientificName",
    "aphiaID": "dwc:taxonID",
    "AF_i": { "@id": "indo:reef-aggregation-index", "@type": "qudt:DimensionlessQuantity" },
    "validityScope": "dcterms:coverage",
    "evidence": { "@id": "prov:wasInfluencedBy", "@type": "@id" },

    "provenance": "prov:wasDerivedFrom",
    "values": "seadots:provenanceValues",
    "primarySource": "dcterms:source",
    "doi": "seadots:doi",
    "url": { "@id": "dcat:accessURL", "@type": "@id" },
    "citation": "dcterms:bibliographicCitation",
    "supportingFigure": "seadots:supportingFigure",
    "nearestAuthoritativeSource": "seadots:nearestAuthoritativeSource",
    "verificationGap": "seadots:verificationGap",
    "note": "skos:note"
  }
}
