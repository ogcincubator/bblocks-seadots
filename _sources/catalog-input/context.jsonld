{
  "@context": [
    "https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/item/context.jsonld",
    "https://ogcincubator.github.io/bblocks-stac/build/annotated/contrib/stac/extensions/cf/context.jsonld",
    {
      "@version": 1.1,
      "@vocab": "https://w3id.org/ogc/hosted/seadots/catalog#",
      "cf": "https://stac-extensions.github.io/cf/v0.2.0/schema.json#",
      "dcterms": "http://purl.org/dc/terms/",
      "seadots": "https://w3id.org/ogc/hosted/seadots/catalog#",
      "role": "seadots:role",
      "convention": "seadots:metadataConvention",
      "cf:parameter": {
        "@id": "cf:parameter",
        "@container": "@set"
      },
      "schema": {
        "@id": "dcterms:conformsTo",
        "@type": "@id"
      }
    }
  ]
}
