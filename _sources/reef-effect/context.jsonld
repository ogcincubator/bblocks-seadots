{
  "@context": [
    "../catalog-workflow/context.jsonld",
    {
      "@version": 1.1,
      "@vocab": "https://w3id.org/ogc/hosted/seadots/reef-effect#",
      "dcterms": "http://purl.org/dc/terms/",
      "prov": "http://www.w3.org/ns/prov#",
      "schema": "https://schema.org/",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "seadotsReef": "https://w3id.org/ogc/hosted/seadots/reef-effect#",
      "softwareType": "dcterms:type",
      "code": "dcterms:identifier",
      "language": "dcterms:language",
      "contacts": {
        "@id": "http://www.w3.org/ns/dcat#contactPoint",
        "@container": "@set"
      },
      "roles": {
        "@id": "http://www.w3.org/ns/dcat#hadRole",
        "@container": "@set"
      },
      "organization": "schema:affiliation",
      "time": "dcterms:temporal",
      "interval": "dcterms:temporal",
      "resolution": "http://www.w3.org/ns/dcat#temporalResolution",
      "concepts": {
        "@id": "skos:Concept",
        "@container": "@set"
      },
      "scheme": "skos:inScheme",
      "label": "skos:prefLabel",
      "formats": {
        "@id": "dcterms:format",
        "@container": "@set"
      },
      "format": "dcterms:format",
      "mediaType": "dcterms:format",
      "experiment": {
        "@id": "seadotsReef:experiment",
        "@context": {
          "inputs": {
            "@id": "seadotsReef:input",
            "@container": "@set"
          },
          "outputs": {
            "@id": "seadotsReef:output",
            "@container": "@set",
            "@type": "@id"
          }
        }
      },
      "kind": "seadotsReef:kind",
      "purpose": "dcterms:purpose",
      "application": {
        "@id": "seadotsReef:application",
        "@type": "@id"
      },
      "modelledBy": {
        "@id": "seadotsReef:modelledBy",
        "@type": "@id"
      },
      "evidenceEquation": {
        "@id": "seadotsReef:evidenceEquation",
        "@type": "@id"
      },
      "parameters": {
        "@id": "seadotsReef:parameter",
        "@container": "@set"
      },
      "parameterSchema": "seadotsReef:parameterSchema",
      "vocabularyTerm": {
        "@id": "skos:exactMatch",
        "@type": "@id"
      },
      "equationBinding": "seadotsReef:equationBinding",
      "execution": "seadotsReef:execution",
      "languageVersion": "seadotsReef:languageVersion",
      "dependencies": {
        "@id": "seadotsReef:dependency",
        "@container": "@set"
      },
      "entrypoint": "seadotsReef:entrypoint",
      "scheduling": "seadotsReef:scheduling",
      "reproducibility": "seadotsReef:reproducibility",
      "seedPolicy": "seadotsReef:seedPolicy",
      "provenance": "prov:wasGeneratedBy",
      "successCriteria": {
        "@id": "seadotsReef:successCriterion",
        "@container": "@set"
      }
    }
  ]
}
