@prefix mpr: <https://w3id.org/ogc/hosted/demo/marine-protections/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ogc/hosted/demo/marine-protections/> a owl:Ontology ;
  dct:title "Marine Protections Ontology"@en ;
  dct:description "Terms describing the regulation of marine managed areas, for attributes of the ProtectedSeas Navigator dataset that have no exact equivalent in the ontologies of the OGC Cross Domain Model. Example namespace: not published or endorsed by ProtectedSeas."@en ;
  owl:versionInfo "0.1" ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:MarineManagedArea a owl:Class ;
  rdfs:label "marine managed area"@en ;
  skos:definition "An area dedicated to the protection of marine life and the conservation of habitats in saltwater and coastal zones, with verified regulations and clearly defined boundaries. Includes marine protected areas and other area based management tools."@en ;
  rdfs:subClassOf geo:Feature, schema:Place ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/what-do-we-include/> ;
.

mpr:regulationStatus a owl:DatatypeProperty ;
  rdfs:label "regulation status"@en ;
  skos:definition "The legal classification of an activity within a site, coded from the regulationStatuses scheme: Allowed (0); Prohibited (1); Restricted (2); N/A or Unknown (3). An absent value means not yet coded."@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:fishingRegulation a owl:DatatypeProperty ;
  rdfs:subPropertyOf mpr:regulationStatus ;
  rdfs:label "fishing regulation"@en ;
  skos:definition "The regulation status of a fishing sector, gear type or method within a site."@en ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:marineActivityRegulation a owl:DatatypeProperty ;
  rdfs:subPropertyOf mpr:regulationStatus ;
  rdfs:label "marine activity regulation"@en ;
  skos:definition "The regulation status of a non-fishing marine activity within a site."@en ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:category a owl:DatatypeProperty ;
  rdfs:label "category"@en ;
  skos:definition "Site category. The value is the category name from the Navigator Site Categories table."@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:designation a owl:DatatypeProperty ;
  rdfs:label "designation"@en ;
  skos:definition "Specific site type (e.g. National Marine Sanctuary)"@en ;
  skos:closeMatch dct:type ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:managingAuthority a owl:DatatypeProperty ;
  rdfs:label "managing authority"@en ;
  skos:definition "Agency(s) with presiding jurisdiction over this site"@en ;
  skos:closeMatch schema:maintainer ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:wdpaId a owl:DatatypeProperty ;
  rdfs:label "WDPA ID"@en ;
  skos:definition "WDPA-assigned unique identifier for site. NULL = Area not included in WDPA"@en ;
  rdfs:subPropertyOf dct:identifier ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:iucnCategory a owl:DatatypeProperty ;
  rdfs:label "IUCN category"@en ;
  skos:definition "IUCN Protected Area Category. 'Unassigned' if no value found, not reported, or not applicable"@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  skos:editorialNote "Observed values may be a semicolon-separated list, one value per component designation."@en ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:purpose a owl:DatatypeProperty ;
  rdfs:label "purpose"@en ;
  skos:definition "Short summary explaining what is special about this marine area; number of habitats and endangered species"@en ;
  rdfs:subPropertyOf dct:description ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:restrictions a owl:DatatypeProperty ;
  rdfs:label "restrictions"@en ;
  skos:definition "Lists prohibited or entirely banned marine-related activities (fishing, dumping, pollution, anchoring, boating) and outlines restricted commercial and/or recreational fishing activities"@en ;
  rdfs:subPropertyOf dct:description ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:allowedActivities a owl:DatatypeProperty ;
  rdfs:label "allowed activities"@en ;
  skos:definition "Lists allowed marine-related activities, including associated licenses/permits if applicable"@en ;
  rdfs:subPropertyOf dct:description ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:regulatoryDefinitions a owl:DatatypeProperty ;
  rdfs:label "regulatory definitions"@en ;
  skos:definition "Definitions, where necessary and possible, of terms contained in 'Restrictions' or 'Allowed', e.g. fishing gear, enumerated species, or geographical locations"@en ;
  rdfs:subPropertyOf dct:description ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:regulationName a owl:DatatypeProperty ;
  rdfs:label "regulation name"@en ;
  skos:definition "List of names of the relevant regulations that established the site. Semicolon-separated."@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:regulationUrl a owl:DatatypeProperty ;
  rdfs:label "regulation URL"@en ;
  skos:definition "List of URLs of relevant regulations. Semicolon-separated."@en ;
  skos:closeMatch dct:references ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  skos:editorialNote "Observed entries may take the form label|URL, so the value is a literal rather than an IRI."@en ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:website a owl:DatatypeProperty ;
  rdfs:label "website"@en ;
  skos:definition "URL link to the most relevant webpage about the site"@en ;
  skos:closeMatch schema:url ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  skos:editorialNote "Observed values may hold several semicolon-separated URLs, so the value is a literal rather than an IRI."@en ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:season a owl:DatatypeProperty ;
  rdfs:label "season"@en ;
  skos:definition "Temporal applicability of the listed restrictions; either Year-round (permanent) or Seasonal (only effective between Effective From and Effective To dates each year)"@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:effectiveFrom a owl:DatatypeProperty ;
  rdfs:label "effective from"@en ;
  skos:definition "Date restrictions begin, if seasonal"@en ;
  skos:closeMatch schema:validFrom ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:date ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:effectiveTo a owl:DatatypeProperty ;
  rdfs:label "effective to"@en ;
  skos:definition "Date restrictions end, if seasonal"@en ;
  skos:closeMatch schema:validThrough ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:date ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:protectionFocus a owl:DatatypeProperty ;
  rdfs:label "protection focus"@en ;
  skos:definition "The focus of the protection afforded by the site."@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:speciesOfConcern a owl:DatatypeProperty ;
  rdfs:label "species of concern"@en ;
  skos:definition "General categories of species that are of interest or concern"@en ;
  skos:closeMatch schema:about ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:governmentLevel a owl:DatatypeProperty ;
  rdfs:label "level of government"@en ;
  skos:definition "Agency(s) level of government. NULL = Not Yet Coded"@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:yearEstablished a owl:DatatypeProperty ;
  rdfs:label "year established"@en ;
  skos:definition "Year the site was first established"@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:otherLinks a owl:DatatypeProperty ;
  rdfs:label "other helpful links"@en ;
  skos:definition "Other helpful URL links related to site"@en ;
  skos:closeMatch dct:references ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:string ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:levelOfFishingProtection a owl:DatatypeProperty ;
  rdfs:label "level of fishing protection"@en ;
  skos:definition "An indicator of the strength of fishing regulations, coded on a 1-5 scale, with higher scores indicating more restrictions and more protection."@en ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  skos:editorialNote "The published scale is 1-5, but the value 0 occurs in the data; its meaning is not documented."@en ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/methodology/> ;
.

mpr:recreationalFishing a owl:DatatypeProperty ;
  rdfs:label "recreational fishing"@en ;
  skos:definition "Fishing for recreational purposes - not sold"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:commercialFishing a owl:DatatypeProperty ;
  rdfs:label "commercial/industrial fishing"@en ;
  skos:definition "Professional large-scale fisheries that use large, often impactful, gear"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:artisanalFishing a owl:DatatypeProperty ;
  rdfs:label "artisanal fishing"@en ;
  skos:definition "Artisanal fisheries are those that use a relatively low level of technology: small canoes or boats instead of larger, more powerful vessels; no engines or very simple low-power engines; and traditional fishing gear such as spears or hand reels, some nets"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:subsistenceFishing a owl:DatatypeProperty ;
  rdfs:label "subsistence fishing"@en ;
  skos:definition "Fishing in order to feed the fisher's family - not sold"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:bottomTrawling a owl:DatatypeProperty ;
  rdfs:label "bottom trawling"@en ;
  skos:definition "A fishing practice that herds and captures the target species, like ground fish or crabs, by towing a net along the ocean floor"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:pelagicTrawling a owl:DatatypeProperty ;
  rdfs:label "pelagic trawling"@en ;
  skos:definition "Pelagic or midwater trawling involves towing a large net through the water column. Trawls are designed to capture and trap the target species inside the codend as the net is hauled through the water"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:hookAndLine a owl:DatatypeProperty ;
  rdfs:label "hook and line"@en ;
  skos:definition "A fishing method that catches fish by means of a series of baited hooks, which are suspended on lines into the ocean. Excludes trolling and longline, which are separate categories"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:trolling a owl:DatatypeProperty ;
  rdfs:label "trolling"@en ;
  skos:definition "To trail artificial or natural baits behind a moving boat. The bait can be made to skip along the surface or trailed below at any depth to just above the bottom. A bait or lure trailed behind an angler walking along a pier, bridge, or breakwater is also called trolling"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:purseSeineSurroundingNets a owl:DatatypeProperty ;
  rdfs:label "purse seine/roundhaul/surrounding nets"@en ;
  skos:definition "A net that encircles schools of fish"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:gillnetsEntanglingNets a owl:DatatypeProperty ;
  rdfs:label "gillnets and entangling nets"@en ;
  skos:definition "Gillnets and entangling nets are walls of netting that hang in the water column, typically made of monofilament or multifilament nylon"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:trammelNets a owl:DatatypeProperty ;
  rdfs:label "trammel nets"@en ;
  skos:definition "An entangling net that hangs down in several curtains"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:dipScoopNets a owl:DatatypeProperty ;
  rdfs:label "dip/scoop nets"@en ;
  skos:definition "A bag net with a handle that is used to scoop fish from the water"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:castNets a owl:DatatypeProperty ;
  rdfs:label "cast nets"@en ;
  skos:definition "A net constructed from a series of tailored netting sections joined together to produce a cone-shaped net with weights and a drawstring attached to the perimeter and cast by a fisher to catch fish"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:driftNets a owl:DatatypeProperty ;
  rdfs:label "drift nets"@en ;
  skos:definition "A fishing net that drifts with the tide or current and is buoyed or attached to a boat"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:otherNets a owl:DatatypeProperty ;
  rdfs:label "other nets"@en ;
  skos:definition "Any fishing net types not accounted for"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:dredges a owl:DatatypeProperty ;
  rdfs:label "dredges"@en ;
  skos:definition "Dredges are dragged along the seafloor to catch shellfish. Dredges are made from an openmouthed frame that scoops shellfish from the seafloor. Attached to the back of the frame is a collection area made from metal rings or mesh"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:trapsAndPots a owl:DatatypeProperty ;
  rdfs:label "traps and pots"@en ;
  skos:definition "Traps and pots are submerged three-dimensional wire or wood devices that permit organisms to enter the enclosure but make escape extremely difficult or impossible"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:spearFishing a owl:DatatypeProperty ;
  rdfs:label "spear fishing"@en ;
  skos:definition "Fishing with a shaft with one or more sharpened points at one end"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:underwaterExtractionDiving a owl:DatatypeProperty ;
  rdfs:label "underwater extraction (diving)"@en ;
  skos:definition "Fishing or collecting marine life underwater by hand, spear, or harpoon gun with or without the use of an underwater breathing device gear"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:handCapture a owl:DatatypeProperty ;
  rdfs:label "hand capture"@en ;
  skos:definition "Fishing or collecting by hand without the use of gear"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:fishAggregatingDevices a owl:DatatypeProperty ;
  rdfs:label "fish aggregating devices"@en ;
  skos:definition "Floating objects that are designed and strategically placed to attract pelagic fish. Includes both static and free-floating"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
  rdfs:isDefinedBy <https://w3id.org/ogc/hosted/demo/marine-protections/> ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:longlining a owl:DatatypeProperty ;
  rdfs:label "longlining"@en ;
  skos:definition "A line that is deployed horizontally to which gangions and hooks are attached. A longline may be a bottom longline, i.e., designed for use on the bottom, or a pelagic longline, i.e., designed for use off the bottom. The longline hauler may be manually, electrically, or hydraulically operated"@en ;
  rdfs:subPropertyOf mpr:fishingRegulation ;
  rdfs:domain mpr:MarineManagedArea ;
  rdfs:range xsd:integer ;
