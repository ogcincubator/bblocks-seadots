.

mpr:regulationStatuses a skos:ConceptScheme ;
  skos:prefLabel "regulation statuses"@en ;
  skos:definition "Codes for the legal classification of an activity within a site."@en ;
  skos:hasTopConcept mpr:status-allowed, mpr:status-prohibited, mpr:status-restricted, mpr:status-unknown ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:status-allowed a skos:Concept ;
  skos:prefLabel "Allowed"@en ;
  skos:notation 0 ;
  skos:definition "The activity is classified as allowed. As coded by ProtectedSeas legal review of the regulations for the site. The data dictionary gives this label only."@en ;
  skos:inScheme mpr:regulationStatuses ;
  skos:topConceptOf mpr:regulationStatuses ;
.

mpr:status-prohibited a skos:Concept ;
  skos:prefLabel "Prohibited"@en ;
  skos:notation 1 ;
  skos:definition "The activity is classified as prohibited. As coded by ProtectedSeas legal review of the regulations for the site. The data dictionary gives this label only."@en ;
  skos:inScheme mpr:regulationStatuses ;
  skos:topConceptOf mpr:regulationStatuses ;
.

mpr:status-restricted a skos:Concept ;
  skos:prefLabel "Restricted"@en ;
  skos:notation 2 ;
  skos:definition "The activity is classified as restricted. As coded by ProtectedSeas legal review of the regulations for the site. The data dictionary gives this label only."@en ;
  skos:inScheme mpr:regulationStatuses ;
  skos:topConceptOf mpr:regulationStatuses ;
.

mpr:status-unknown a skos:Concept ;
  skos:prefLabel "N/A or Unknown"@en ;
  skos:notation 3 ;
  skos:definition "The classification of the activity is not applicable or unknown. As coded by ProtectedSeas legal review of the regulations for the site. The data dictionary gives this label only."@en ;
  skos:inScheme mpr:regulationStatuses ;
  skos:topConceptOf mpr:regulationStatuses ;
.

mpr:siteCategories a skos:ConceptScheme ;
  skos:prefLabel "site categories"@en ;
  skos:definition "The Navigator Site Categories table. Values of mpr:category match skos:prefLabel."@en ;
  skos:hasTopConcept mpr:category-1, mpr:category-2, mpr:category-3, mpr:category-4, mpr:category-5, mpr:category-6, mpr:category-7, mpr:category-8, mpr:category-9, mpr:category-10, mpr:category-11, mpr:category-12, mpr:category-13 ;
  dct:source <https://navigatormap.org/data-dictionary/> ;
.

mpr:category-1 a skos:Concept ;
  skos:prefLabel "Marine Protected Area"@en ;
  skos:notation 1 ;
  skos:definition "Marine Protected Areas (MPA) as defined by each country or as classified by the WDPA"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-2 a skos:Concept ;
  skos:prefLabel "Other Effective Area-Based Conservation Area"@en ;
  skos:notation 2 ;
  skos:definition "Other Effective Area-Based Conservation (OECM) Areas as defined by each country or as classified by the WDPA"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-3 a skos:Concept ;
  skos:prefLabel "Fisheries Management Area"@en ;
  skos:notation 3 ;
  skos:definition "Areas that protect fishery resources so sustainable exploitation is possible"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-4 a skos:Concept ;
  skos:prefLabel "Water Quality/Human Health Area"@en ;
  skos:notation 4 ;
  skos:definition "Areas that focus on protecting existing good water quality in an area"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-5 a skos:Concept ;
  skos:prefLabel "Recreational Area"@en ;
  skos:notation 5 ;
  skos:definition "Areas that focus on recreational activities. Includes shipwrecks, swimming areas, state & local parks"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-6 a skos:Concept ;
  skos:prefLabel "Vessel Restricted Area"@en ;
  skos:notation 6 ;
  skos:definition "Areas that restrict boating speeds, entry (either restricts or prohibits operation of a power-driven vessel or a vessel driven by electrical propulsion), or both"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-7 a skos:Concept ;
  skos:prefLabel "Vessel Reporting Area"@en ;
  skos:notation 7 ;
  skos:definition "Areas that require vessels to report when they enter them"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-8 a skos:Concept ;
  skos:prefLabel "Voluntary Conservation Measure Area"@en ;
  skos:notation 8 ;
  skos:definition "Includes Vessel Recommended Routes, some Vessel Speed Restricted Areas (Whales), Areas to be avoided"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-9 a skos:Concept ;
  skos:prefLabel "Jurisdictional Authority Area"@en ;
  skos:notation 9 ;
  skos:definition "EEZs, territorial seas, & other state/provincial waters"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-10 a skos:Concept ;
  skos:prefLabel "Other"@en ;
  skos:notation 10 ;
  skos:definition "Overflight Protection Zones, Ecological Preserves, etc..."@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-11 a skos:Concept ;
  skos:prefLabel "To Be Determined"@en ;
  skos:notation 11 ;
  skos:definition "Unsure how to categorize"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-12 a skos:Concept ;
  skos:prefLabel "Local Marine Managed Area"@en ;
  skos:notation 12 ;
  skos:definition "Coastal waters designated, implemented, and managed directly by the communities adjacent to those waters, often through traditional practices"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:category-13 a skos:Concept ;
  skos:prefLabel "Marine Spatial Planning Area"@en ;
  skos:notation 13 ;
  skos:definition "Areas that are part of a comprehensive framework where human activities are mapped and balanced with ecological protection"@en ;
  skos:inScheme mpr:siteCategories ;
  skos:topConceptOf mpr:siteCategories ;
.

mpr:protectionFocuses a skos:ConceptScheme ;
  skos:prefLabel "protection focuses"@en ;
  skos:definition "Values of the Protection Focus attribute. Values of mpr:protectionFocus match skos:prefLabel."@en ;
