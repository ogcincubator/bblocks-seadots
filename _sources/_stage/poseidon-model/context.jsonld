{
  "@context": [
    "../../odd-protocol/context.jsonld",
    {
      "@version": 1.1,
      "pos": "https://w3id.org/iliad/seadots/poseidon#",
      "stac": "https://w3id.org/ogc/stac/",
      "osc": "https://github.com/ILIAD-ocean-twin/OIM/blob/main/openscience#",
      "schema": "https://schema.org/",
      "prov": "http://www.w3.org/ns/prov#",
      "dcterms": "http://purl.org/dc/terms/",
      "poseidon": {
        "@id": "pos:metadata"
      },
      "modelRole": {
        "@id": "pos:modelRole"
      },
      "publication": {
        "@id": "dcterms:source"
      },
      "doi": {
        "@id": "bibo:doi",
        "@type": "@id"
      },
      "citation": {
        "@id": "dcterms:bibliographicCitation"
      },
      "published": {
        "@id": "dcterms:issued",
        "@type": "xsd:date"
      },
      "supplementaryMaterial": {
        "@id": "schema:encoding",
        "@container": "@list"
      },
      "policyOptimization": {
        "@id": "pos:policyOptimization"
      },
      "method": {
        "@id": "pos:optimizationMethod"
      },
      "objectiveFunction": {
        "@id": "pos:objectiveFunction"
      },
      "decisionVariables": {
        "@id": "pos:decisionVariables",
        "@container": "@list"
      },
      "outputs": {
        "@id": "pos:outputs",
        "@container": "@list"
      },
      "spatialSupport": {
        "@id": "pos:spatialSupport"
      },
      "stacCollections": {
        "@id": "stac:Collection",
        "@container": "@list"
      },
      "stacItems": {
        "@id": "stac:Item",
        "@container": "@list"
      },
      "openScience": {
        "@id": "osc:OpenScienceResource"
      },
      "workflow": {
        "@id": "prov:used"
      },
      "experiments": {
        "@id": "prov:wasGeneratedBy",
        "@container": "@list"
      },
      "products": {
        "@id": "prov:generated",
        "@container": "@list"
      },
      "reproducibility": {
        "@id": "osc:reproducibility"
      },
      "implementationStatus": {
        "@id": "pos:implementationStatus"
      },
      "randomSeedPolicy": {
        "@id": "pos:randomSeedPolicy"
      },
      "runProtocol": {
        "@id": "pos:runProtocol"
      },
      "calibration": {
        "@id": "pos:calibration"
      }
    }
  ]
}
