{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://w3id.org/iliad/seadots/poseidon/output#",
    "schema": "https://schema.org/",
    "stac": "https://w3id.org/ogc/stac/",
    "runId": "schema:identifier",
    "runConfigRef": "schema:isBasedOn",
    "stacCollection": {"@id": "stac:Collection"},
    "stacItem": {"@id": "stac:Item"},
    "timeSeries": {"@id": "schema:hasPart", "@container": "@list"},
    "agentLogs": {"@id": "schema:hasPart", "@container": "@list"},
    "gridded": {"@id": "schema:hasPart", "@container": "@list"},
    "events": {"@id": "schema:hasPart", "@container": "@list"},
    "validationLinks": {"@id": "schema:subjectOf", "@container": "@list"}
  }
}
