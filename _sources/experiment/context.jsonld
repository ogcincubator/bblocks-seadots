{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://w3id.org/ogc/hosted/seadots/experiment#",

    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "seadots": "https://w3id.org/ogc/hosted/seadots/experiment#",

    "id": "@id",
    "type": "@type",
    "geometry": "https://purl.org/geojson/vocab#geometry",
    "coordinates": "https://purl.org/geojson/vocab#coordinates",
    "Feature": "https://purl.org/geojson/vocab#Feature",
    "Polygon": "https://purl.org/geojson/vocab#Polygon",
    "properties": "https://purl.org/geojson/vocab#properties",
    "bbox": "https://purl.org/geojson/vocab#bbox",
    "links": { "@id": "http://www.w3.org/ns/iana/link-relations/relation", "@container": "@set" },
    "href": { "@id": "@id" },
    "rel": "https://purl.org/geojson/vocab#rel",
    "mediaType": "dcterms:format",
    "title": "dcterms:title",

    "name": "dcterms:title",
    "description": "dcterms:description",
    "created": "dcterms:created",
    "updated": "dcterms:modified",
    "language": "dcterms:language",
    "license": "dcterms:license",
    "keywords": { "@id": "dcat:keyword", "@container": "@set" },
    "themes": { "@id": "dcat:theme", "@container": "@set" },
    "concepts": { "@id": "skos:Concept", "@container": "@set" },
    "scheme": "skos:inScheme",
    "label": "skos:prefLabel",
    "formats": { "@id": "dcterms:format", "@container": "@set" },
    "format": "dcterms:format",
    "conformsTo": { "@id": "dcterms:conformsTo", "@type": "@id", "@container": "@set" },
    "contacts": { "@id": "dcat:contactPoint", "@container": "@set" },
    "roles": { "@id": "dcat:hadRole", "@container": "@set" },
    "organization": "schema:affiliation",
    "time": "dcterms:temporal",
    "interval": "dcterms:temporal",
    "resolution": "dcat:temporalResolution",

    "experiment": "seadots:experiment",
    "kind": "seadots:kind",
    "purpose": "dcterms:purpose",
    "application": { "@id": "seadots:application", "@type": "@id" },
    "modelledBy": { "@id": "seadots:modelledBy", "@type": "@id" },
    "evidenceEquation": { "@id": "seadots:evidenceEquation", "@type": "@id" },

    "parameters": { "@id": "seadots:parameter", "@container": "@set" },
    "schema": "seadots:parameterSchema",
    "vocabularyTerm": { "@id": "skos:exactMatch", "@type": "@id" },

    "inputs": { "@id": "seadots:input", "@container": "@set" },
    "equationBinding": "seadots:equationBinding",
    "outputs": { "@id": "seadots:output", "@type": "@id", "@container": "@set" },

    "execution": "seadots:execution",
    "language": "dcterms:language",
    "languageVersion": "seadots:languageVersion",
    "dependencies": { "@id": "seadots:dependency", "@container": "@set" },
    "entrypoint": "seadots:entrypoint",
    "scheduling": "seadots:scheduling",
    "reproducibility": "seadots:reproducibility",
    "seedPolicy": "seadots:seedPolicy",
    "provenance": "prov:wasGeneratedBy",

    "successCriteria": { "@id": "seadots:successCriterion", "@container": "@set" }
  }
}
