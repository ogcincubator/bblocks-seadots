{
  "@context": {
    "@version": 1.1,
    "prov": "http://www.w3.org/ns/prov#",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "@vocab": "https://w3id.org/ogc/hosted/seadots/emodnet/",
    "geojson": "https://purl.org/geojson/vocab#",
    "owf": "https://w3id.org/ogc/hosted/seadots/windfarm/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "type": "@type",
    "FeatureCollection": "geojson:FeatureCollection",
    "Feature": "geojson:Feature",
    "Point": "geojson:Point",
    "Polygon": "geojson:Polygon",
    "MultiPolygon": "geojson:MultiPolygon",
    "features": {
      "@id": "geojson:features",
      "@container": "@set"
    },
    "geometry": "geojson:geometry",
    "coordinates": {
      "@id": "geojson:coordinates",
      "@container": "@list"
    },
    "properties": "@nest",
    "WindfarmArea": "owf:WindfarmArea",
    "name": "dcterms:title",
    "country": {
      "@id": "owf:country",
      "@type": "@vocab",
      "@context": {
        "@vocab": "https://w3id.org/ogc/hosted/seadots/emodnet/",
        "United Kingdom": "https://w3id.org/ogc/hosted/seadots/emodnet/UnitedKingdom"
      }
    },
    "n_turbines": {
      "@id": "owf:nTurbines",
      "@type": "xsd:integer"
    },
    "power_mw": {
      "@id": "owf:powerMW",
      "@type": "xsd:decimal"
    },
    "status": {
      "@id": "owf:conditionOfFacility",
      "@type": "@vocab"
    },
    "status_detail": "owf:statusDetail",
    "status_as_of": {
      "@id": "owf:statusAsOf",
      "@type": "xsd:date"
    },
    "type_inst": "owf:installationType",
    "offshore": {
      "@id": "owf:offshore",
      "@type": "xsd:boolean"
    },
    "year": "owf:year",
    "year_semantics": "owf:yearSemantics",
    "year_is_assumed": {
      "@id": "owf:yearIsAssumed",
      "@type": "xsd:boolean"
    },
    "updateyear": "owf:updateYear",
    "operational_date": {
      "@id": "owf:operationalDate",
      "@type": "xsd:date"
    },
    "valid_from": {
      "@id": "owf:validFrom",
      "@type": "xsd:date"
    },
    "dist_coast": {
      "@id": "owf:distanceToCoast",
      "@type": "xsd:decimal"
    },
    "area_sqkm": {
      "@id": "owf:areaSqKm",
      "@type": "xsd:decimal"
    },
    "operator": {
      "@id": "owf:operatorName",
      "@container": "@set"
    },
    "owner": "owf:ownerName",
    "developer": "owf:developerName",
    "licence_status": "owf:licenceStatus",
    "licensing_case": {
      "@id": "owf:licensingCase",
      "@type": "@id"
    },
    "admin_units": {
      "@id": "owf:administrativeUnit",
      "@container": "@set"
    },
    "electricity_price_area": "owf:electricityPriceArea",
    "mean_annual_production_gwh": {
      "@id": "owf:meanAnnualProductionGWh",
      "@type": "xsd:decimal"
    },
    "notes": "dcterms:description",
    "source_type": {
      "@id": "owf:sourceType",
      "@type": "@vocab"
    },
    "source_dataset": "owf:sourceDataset",
    "source_reference": {
      "@id": "dcterms:source",
      "@type": "@id"
    },
    "source_record_id": "dcterms:identifier",
    "source_snapshot_date": {
      "@id": "owf:sourceSnapshotDate",
      "@type": "xsd:date"
    },
    "last_updated": {
      "@id": "dcterms:modified",
      "@type": "xsd:dateTime"
    },
    "update_date": {
      "@id": "dcterms:modified",
      "@type": "xsd:date"
    },
    "metadata_record": {
      "@id": "foaf:isPrimaryTopicOf",
      "@type": "@id"
    },
    "location_status": {
      "@id": "owf:locationStatus",
      "@type": "@vocab"
    },
    "location_method": "owf:locationMethod",
    "location_reference": {
      "@id": "owf:locationReference",
      "@type": "@id"
    },
    "positional_accuracy_m": {
      "@id": "owf:positionalAccuracyM",
      "@type": "xsd:decimal"
    },
    "same_as": {
      "@id": "prov:alternateOf",
      "@type": "@id",
      "@container": "@set"
    },
    "osm": "owf:OpenStreetMapSource",
    "emodnet": "owf:EmodnetSource",
    "national": "owf:NationalSource",
    "source-provided": "owf:LocationSourceProvided",
    "mapped": "owf:LocationMapped",
    "anticipated": "owf:LocationAnticipated",
    "unmatched": "owf:LocationUnmatched"
  }
}
