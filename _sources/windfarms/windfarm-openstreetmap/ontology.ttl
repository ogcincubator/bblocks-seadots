@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix osmdata: <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source#> .

<https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source>
    a owl:Ontology ;
    rdfs:label "OpenStreetMap API 0.6 source vocabulary"@en ;
    dcterms:title "OpenStreetMap API 0.6 source vocabulary"@en ;
    dcterms:description "Terms used by the SeaDOTs JSON-LD context for unconverted OpenStreetMap API 0.6 map responses: response metadata, request bounds, nodes, ways, relations, relation members, and edit metadata. Tag keys and values are kept as an uninterpreted JSON literal."@en ;
    dcterms:created "2026-11-04"^^xsd:date ;
    dcterms:creator "SeaDOTs Marine Data Team" ;
    dcterms:source <https://wiki.openstreetmap.org/wiki/API_v0.6> , <https://wiki.openstreetmap.org/wiki/Elements> ;
    owl:versionInfo "0.1" ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/OSM_JSON> .

#################################################################
# Classes
#################################################################

osmdata:MapResponse
    a owl:Class ;
    rdfs:label "OSM map response"@en ;
    rdfs:comment "Response body of the OSM API 0.6 map call for a bounding box, carrying API metadata, the request bounds, and the returned elements."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/API_v0.6#Retrieving_map_data_by_bounding_box:_GET_/api/0.6/map> .

osmdata:Bounds
    a owl:Class ;
    rdfs:label "bounds"@en ;
    rdfs:comment "Bounding box of an OSM map request in WGS 84 decimal degrees."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:Element
    a owl:Class ;
    rdfs:label "OSM element"@en ;
    rdfs:comment "Basic component of the OpenStreetMap data model: a node, way, or relation. Identifiers are unique only within each element type."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Elements> .

osmdata:Node
    a owl:Class ;
    rdfs:subClassOf osmdata:Element ;
    rdfs:label "node"@en ;
    rdfs:comment "OSM element representing a single point, defined by latitude and longitude."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Node> .

osmdata:Way
    a owl:Class ;
    rdfs:subClassOf osmdata:Element ;
    rdfs:label "way"@en ;
    rdfs:comment "OSM element defined by an ordered list of node references; a closed way repeats its first node last."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Way> .

osmdata:Relation
    a owl:Class ;
    rdfs:subClassOf osmdata:Element ;
    rdfs:label "relation"@en ;
    rdfs:comment "OSM element grouping other elements as an ordered list of role-labelled members."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Relation> .

osmdata:RelationMember
    a owl:Class ;
    rdfs:label "relation member"@en ;
    rdfs:comment "Reference from a relation to a member element, given by member type, numeric identifier, and role. It is a reference, not the member element itself."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

#################################################################
# Response metadata
#################################################################

osmdata:apiVersion
    a owl:DatatypeProperty ;
    rdfs:label "API version"@en ;
    rdfs:comment "Version of the OSM API that produced the response, e.g. \"0.6\"."@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:generator
    a owl:DatatypeProperty ;
    rdfs:label "generator"@en ;
    rdfs:comment "Power generator device?"@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:bounds
    a owl:ObjectProperty ;
    rdfs:label "bounds"@en ;
    rdfs:comment "Bounding box of the request that produced the response."@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:range osmdata:Bounds ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:minlat
    a owl:DatatypeProperty ;
    rdfs:label "minimum latitude"@en ;
    rdfs:comment "Southern edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:minlon
    a owl:DatatypeProperty ;
    rdfs:label "minimum longitude"@en ;
    rdfs:comment "Western edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:maxlat
    a owl:DatatypeProperty ;
    rdfs:label "maximum latitude"@en ;
    rdfs:comment "Northern edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:maxlon
    a owl:DatatypeProperty ;
    rdfs:label "maximum longitude"@en ;
    rdfs:comment "Eastern edge of the bounding box, WGS 84 decimal degrees."@en ;
    rdfs:domain osmdata:Bounds ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:element
    a owl:ObjectProperty ;
    rdfs:label "element"@en ;
    rdfs:comment "OSM element returned in the response."@en ;
    rdfs:domain osmdata:MapResponse ;
    rdfs:range osmdata:Element ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

#################################################################
# Element properties
#################################################################

osmdata:elementIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "element identifier"@en ;
    rdfs:comment "Numeric OSM identifier of an element. It is unique only within its element type, so it identifies an element only together with the element's class."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:elementVersion
    a owl:DatatypeProperty ;
    rdfs:label "element version"@en ;
    rdfs:comment "Version number of the element, incremented on each edit."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:changeset
    a owl:DatatypeProperty ;
    rdfs:label "changeset"@en ;
    rdfs:comment "Numeric identifier of the changeset in which this element version was created."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Changeset> .

osmdata:user
    a owl:DatatypeProperty ;
    rdfs:label "user"@en ;
    rdfs:comment "Display name of the user who last edited the element. Display names can change; osmdata:uid is the stable identifier."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:uid
    a owl:DatatypeProperty ;
    rdfs:label "user identifier"@en ;
    rdfs:comment "Numeric identifier of the user who last edited the element."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:TagSet
    a owl:Class ;
    rdfs:label "tag set"@en ;
    rdfs:comment "Set of key-value tags of an OSM element. Each tag is a property whose IRI is the OSM key appended to <https://www.openstreetmap.org/wiki/Key:> (the osm2rdf convention, e.g. osmkey:plant:source); values are the uninterpreted source strings."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Tags> , <https://github.com/ad-freiburg/osm2rdf> .

osmdata:tagSet
    a owl:ObjectProperty ;
    rdfs:label "tag set"@en ;
    rdfs:comment "Key-value tags of the element."@en ;
    rdfs:domain osmdata:Element ;
    rdfs:range osmdata:TagSet ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Tags> .

osmdata:nodeReference
    a owl:ObjectProperty ;
    rdfs:label "node reference"@en ;
    rdfs:comment "Ordered list (rdf:List) of numeric node identifiers that define a way."@en ;
    rdfs:domain osmdata:Way ;
    rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:relationMember
    a owl:ObjectProperty ;
    rdfs:label "relation member"@en ;
    rdfs:comment "Ordered list (rdf:List) of the members of a relation."@en ;
    rdfs:domain osmdata:Relation ;
    rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

#################################################################
# Relation member properties
#################################################################

osmdata:memberType
    a owl:ObjectProperty ;
    rdfs:label "member type"@en ;
    rdfs:comment "Element class of the referenced member: osmdata:Node, osmdata:Way, or osmdata:Relation."@en ;
    rdfs:domain osmdata:RelationMember ;
    rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:memberReference
    a owl:DatatypeProperty ;
    rdfs:label "member reference"@en ;
    rdfs:comment "Numeric identifier of the referenced member, interpreted within the type given by osmdata:memberType."@en ;
    rdfs:domain osmdata:RelationMember ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:memberRole
    a owl:DatatypeProperty ;
    rdfs:label "member role"@en ;
    rdfs:comment "Role of the member within the relation, e.g. \"outer\" or \"inner\"; may be empty."@en ;
    rdfs:domain osmdata:RelationMember ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Relation#Roles> .

#################################################################
# Alignment with the SeaDOTs windfarm ontology (owf:)
#
# Declares how OSM elements and tags map onto owf:WindfarmArea as used by the
# common-windfarm-designated-area block. The mapping is data: the transform
# transforms/osm_to_windfarm_area.py reads it from this file and applies it, so
# changing a mapping here changes the transformation.
#################################################################

@prefix owf: <https://w3id.org/ogc/hosted/seadots/windfarm#> .
@prefix seadots-emodnet: <https://w3id.org/ogc/hosted/seadots/emodnet/> .
@prefix osmkey: <https://www.openstreetmap.org/wiki/Key:> .

<https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source>
    owl:imports <https://w3id.org/ogc/hosted/seadots/windfarm> .

# ---------- alignment vocabulary ----------

osmdata:TagMapping a owl:Class ;
    rdfs:label "tag mapping"@en ;
    rdfs:comment "Maps one or more OSM tag keys of a wind farm element onto one owf property and the corresponding JSON property of the target block."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:ValueRule a owl:Class ;
    rdfs:label "value rule"@en ;
    rdfs:comment "Maps one OSM tag key/value pair to a target value."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:Conversion a owl:Class ;
    rdfs:label "value conversion"@en ;
    rdfs:comment "How a source tag value is turned into the target value."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:targetProperty a owl:ObjectProperty ;
    rdfs:label "target property"@en ; rdfs:comment "The ontology property the mapping produces."@en ;
    rdfs:domain osmdata:TagMapping ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:targetKey a owl:DatatypeProperty ;
    rdfs:label "target JSON key"@en ; rdfs:comment "JSON property name in the target block, i.e. the context term for osmdata:targetProperty."@en ;
    rdfs:domain osmdata:TagMapping ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:sourceKeys a owl:ObjectProperty ;
    rdfs:label "source keys"@en ; rdfs:comment "Ordered list (rdf:List) of OSM tag key properties; the first key with a value is used."@en ;
    rdfs:domain osmdata:TagMapping ; rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:valueRules a owl:ObjectProperty ;
    rdfs:label "value rules"@en ; rdfs:comment "Ordered list (rdf:List) of osmdata:ValueRule; the first rule whose key/value matches gives the target value."@en ;
    rdfs:domain osmdata:TagMapping ; rdfs:range rdf:List ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:conversion a owl:ObjectProperty ;
    rdfs:label "conversion"@en ; rdfs:domain osmdata:TagMapping ; rdfs:range osmdata:Conversion ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:fallback a owl:ObjectProperty ;
    rdfs:label "fallback"@en ; rdfs:comment "Conversion applied when no source key has a value."@en ;
    rdfs:domain osmdata:TagMapping ; rdfs:range osmdata:Conversion ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:whenPresent a owl:DatatypeProperty ;
    rdfs:label "constant when present"@en ; rdfs:comment "Constant target value written when the mapping's source key has a value (used for explanatory fields)."@en ;
    rdfs:domain osmdata:TagMapping ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:ruleKey a owl:ObjectProperty ;
    rdfs:label "rule key"@en ; rdfs:domain osmdata:ValueRule ; rdfs:range rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:ruleValue a owl:DatatypeProperty ;
    rdfs:label "rule value"@en ; rdfs:comment "Source tag value the rule matches; omitted to match any value."@en ;
    rdfs:domain osmdata:ValueRule ; rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:yields a rdf:Property ;
    rdfs:label "yields"@en ; rdfs:comment "Target value of a rule: a concept (written as its local name), a literal, or osmdata:KeyEqualsValue."@en ;
    rdfs:domain osmdata:ValueRule ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:Copy a osmdata:Conversion ; rdfs:label "copy"@en ;
    rdfs:comment "The tag value unchanged."@en ; rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .
osmdata:ParseInteger a osmdata:Conversion ; rdfs:label "parse integer"@en ;
    rdfs:comment "The tag value read as an integer; null when it is not one."@en ; rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .
osmdata:ParseMegawatts a osmdata:Conversion ; rdfs:label "parse megawatts"@en ;
    rdfs:comment "A number with optional unit MW, e.g. \"720 MW\" -> 720; null for any other unit or text."@en ; rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .
osmdata:SplitSemicolon a osmdata:Conversion ; rdfs:label "split on semicolon"@en ;
    rdfs:comment "The OSM multi-value convention: split on ';' and trim, giving an array."@en ; rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .
osmdata:CountGeneratorMembers a osmdata:Conversion ; rdfs:label "count generator members"@en ;
    rdfs:comment "Number of relation members with role generator; null when there are none."@en ; rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .
osmdata:KeyEqualsValue a owl:NamedIndividual ; rdfs:label "key=value"@en ;
    rdfs:comment "Rule result: the matched tag written as key=value."@en ; rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

# ---------- class alignment ----------

osmdata:WindfarmElement a owl:Class ;
    rdfs:label "OSM wind farm element"@en ;
    rdfs:comment "A way or relation tagged as a wind farm. A way that is an outer member of a wind farm relation, or has the same name as one, is part of that relation's wind farm; the relation is the primary element, the ways are linked with prov:alternateOf, and the first area way gives the geometry."@en ;
    rdfs:subClassOf osmdata:Element ;
    owl:equivalentClass [
        owl:intersectionOf ( osmdata:Element
            [ a owl:Restriction ; owl:onProperty osmdata:tagSet ;
              owl:someValuesFrom [ owl:unionOf (
                  [ a owl:Restriction ; owl:onProperty osmkey:plant:source ; owl:hasValue "wind" ]
                  [ a owl:Restriction ; owl:onProperty osmkey:industrial ; owl:hasValue "windfarm" ]
                  [ a owl:Restriction ; owl:onProperty osmkey:seamark:landmark:production_area ; owl:hasValue "wind_farm" ] ) ] ] ) ] ;
    skos:closeMatch owf:WindfarmArea ;
    osmdata:selectionRules ( osmdata:sel-plant-source osmdata:sel-industrial osmdata:sel-seamark ) ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:selectionRules a owl:AnnotationProperty ;
    rdfs:label "selection rules"@en ; rdfs:comment "Any matching rule selects an element; machine-readable form of the class definition."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:sel-plant-source a osmdata:ValueRule ; osmdata:ruleKey osmkey:plant:source ; osmdata:ruleValue "wind" .
osmdata:sel-industrial a osmdata:ValueRule ; osmdata:ruleKey osmkey:industrial ; osmdata:ruleValue "windfarm" .
osmdata:sel-seamark a osmdata:ValueRule ; osmdata:ruleKey osmkey:seamark:landmark:production_area ; osmdata:ruleValue "wind_farm" .

# ---------- property alignment (tag mappings), applied in this order ----------

osmdata:windfarmTagMappings a owl:AnnotationProperty ;
    rdfs:label "windfarm tag mappings"@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

<https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source>
    osmdata:windfarmTagMappings ( osmdata:map-name osmdata:map-n-turbines osmdata:map-power
        osmdata:map-status osmdata:map-status-detail osmdata:map-offshore osmdata:map-year
        osmdata:map-year-semantics osmdata:map-operator ) .

osmdata:map-name a osmdata:TagMapping ;
    osmdata:targetProperty dcterms:title ; osmdata:targetKey "name" ;
    osmdata:sourceKeys ( <https://www.openstreetmap.org/wiki/Key:name:> osmkey:seamark:name ) ;
    osmdata:conversion osmdata:Copy .

osmdata:map-n-turbines a osmdata:TagMapping ;
    osmdata:targetProperty owf:nTurbines ; osmdata:targetKey "n_turbines" ;
    osmdata:sourceKeys ( osmkey:turbines ) ;
    osmdata:conversion osmdata:ParseInteger ;
    osmdata:fallback osmdata:CountGeneratorMembers .

osmdata:map-power a osmdata:TagMapping ;
    osmdata:targetProperty owf:powerMW ; osmdata:targetKey "power_mw" ;
    osmdata:sourceKeys ( osmkey:plant:output:electricity ) ;
    osmdata:conversion osmdata:ParseMegawatts .

osmdata:map-status a osmdata:TagMapping ;
    osmdata:targetProperty owf:conditionOfFacility ; osmdata:targetKey "status" ;
    osmdata:valueRules (
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:construction:power ; osmdata:ruleValue "plant" ; osmdata:yields seadots-emodnet:Construction ]
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:status ; osmdata:ruleValue "construction" ; osmdata:yields seadots-emodnet:Construction ]
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:power ; osmdata:ruleValue "plant" ; osmdata:yields seadots-emodnet:Production ] ) .

osmdata:map-status-detail a osmdata:TagMapping ;
    osmdata:targetProperty owf:statusDetail ; osmdata:targetKey "status_detail" ;
    osmdata:valueRules (
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:status ; osmdata:yields osmdata:Copy ]
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:construction:power ; osmdata:yields osmdata:KeyEqualsValue ] ) .

osmdata:map-offshore a osmdata:TagMapping ;
    osmdata:targetProperty owf:offshore ; osmdata:targetKey "offshore" ;
    osmdata:valueRules (
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:offshore ; osmdata:ruleValue "yes" ; osmdata:yields true ]
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:plant:type ; osmdata:ruleValue "offshore" ; osmdata:yields true ] ) .

osmdata:map-year a osmdata:TagMapping ;
    osmdata:targetProperty owf:year ; osmdata:targetKey "year" ;
    osmdata:sourceKeys ( osmkey:start_date ) ;
    osmdata:conversion osmdata:Copy .

osmdata:map-year-semantics a osmdata:TagMapping ;
    osmdata:targetProperty owf:yearSemantics ; osmdata:targetKey "year_semantics" ;
    osmdata:sourceKeys ( osmkey:start_date ) ;
    osmdata:whenPresent "planned start of operation (OSM start_date)" .

osmdata:map-operator a osmdata:TagMapping ;
    osmdata:targetProperty owf:operatorName ; osmdata:targetKey "operator" ;
    osmdata:sourceKeys ( osmkey:operator ) ;
    osmdata:conversion osmdata:SplitSemicolon .

# ---------- element-level alignment (not tag based) ----------
# Implemented by the transform as structural rules:
#   element id (type/id)          -> feature id <https://www.openstreetmap.org/{type}/{id}>, dcterms:identifier
#   max dcterms:modified of parts -> dcterms:modified (last_updated)
#   osmdata:bounds of the response -> dcterms:source (OSM API map URL with that bbox)
#   area way node list            -> geometry (Polygon), owf:areaSqKm (geodesic, WGS 84)
#   area way present / absent     -> owf:locationStatus LocationSourceProvided / LocationUnmatched
#   merged ways                   -> prov:alternateOf (same_as)
# Not derivable from OSM and left null: country, type_inst, dist_coast, updateyear.

osmdata:elementIdentifier skos:relatedMatch dcterms:identifier .
osmdata:bounds skos:relatedMatch dcterms:source .
<https://www.openstreetmap.org/wiki/Key:name:> skos:closeMatch dcterms:title .
osmkey:seamark:name skos:closeMatch dcterms:title .
osmkey:turbines skos:closeMatch owf:nTurbines .
osmkey:plant:output:electricity skos:closeMatch owf:powerMW .
osmkey:operator skos:closeMatch owf:operatorName .
osmkey:start_date skos:closeMatch owf:year .
osmkey:offshore skos:closeMatch owf:offshore .
osmkey:construction:power skos:relatedMatch owf:conditionOfFacility .
osmkey:status skos:relatedMatch owf:conditionOfFacility .
osmkey:power skos:relatedMatch owf:conditionOfFacility .


# ================================================================
# Turbines: alignment to common-windfarm-turbine (owf:WindTurbine)
# Interpreted by transforms/osm_to_windfarm_turbine.py with the same
# TagMapping / ValueRule vocabulary as the wind farm areas above.
# ================================================================

@prefix schema: <https://schema.org/> .
@prefix inspire-cofv: <http://inspire.ec.europa.eu/codelist/ConditionOfFacilityValue/> .

osmdata:ParseNumber a osmdata:Conversion ; rdfs:label "parse number"@en ;
    rdfs:comment "A plain number with an optional metre unit, e.g. \"141\" or \"141 m\" -> 141; null for any other unit or text."@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:TurbineElement a owl:Class ;
    rdfs:label "OSM wind turbine element"@en ;
    rdfs:comment "A node tagged as a wind generator. It belongs to the wind farm relation (an osmdata:WindfarmElement) that has it as a member, in any role."@en ;
    rdfs:subClassOf osmdata:Element ;
    skos:closeMatch owf:WindTurbine ;
    osmdata:selectionRules ( osmdata:sel-generator ) ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

osmdata:sel-generator a osmdata:ValueRule ; osmdata:ruleKey osmkey:power ; osmdata:ruleValue "generator" .

osmdata:turbineTagMappings a owl:AnnotationProperty ;
    rdfs:label "turbine tag mappings"@en ;
    rdfs:isDefinedBy <https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source> .

<https://w3id.org/ogc/hosted/seadots/osm-offshore-wind-source>
    osmdata:turbineTagMappings ( osmdata:tmap-ref osmdata:tmap-manufacturer osmdata:tmap-model
        osmdata:tmap-rated-power osmdata:tmap-hub-height osmdata:tmap-rotor-diameter osmdata:tmap-rotor-axis
        osmdata:tmap-offshore osmdata:tmap-operator osmdata:tmap-status ) .

osmdata:tmap-ref a osmdata:TagMapping ; osmdata:targetProperty owf:turbineReference ; osmdata:targetKey "ref" ;
    osmdata:sourceKeys ( osmkey:ref ) ; osmdata:conversion osmdata:Copy .
osmdata:tmap-manufacturer a osmdata:TagMapping ; osmdata:targetProperty owf:manufacturerName ; osmdata:targetKey "manufacturer" ;
    osmdata:sourceKeys ( osmkey:manufacturer ) ; osmdata:conversion osmdata:Copy .
osmdata:tmap-model a osmdata:TagMapping ; osmdata:targetProperty schema:model ; osmdata:targetKey "model" ;
    osmdata:sourceKeys ( osmkey:model ) ; osmdata:conversion osmdata:Copy .
osmdata:tmap-rated-power a osmdata:TagMapping ; osmdata:targetProperty owf:ratedPowerMW ; osmdata:targetKey "rated_power_mw" ;
    osmdata:sourceKeys ( osmkey:generator:output:electricity ) ; osmdata:conversion osmdata:ParseMegawatts .
osmdata:tmap-hub-height a osmdata:TagMapping ; osmdata:targetProperty owf:hubHeight ; osmdata:targetKey "hub_height_m" ;
    osmdata:sourceKeys ( osmkey:height:hub ) ; osmdata:conversion osmdata:ParseNumber .
osmdata:tmap-rotor-diameter a osmdata:TagMapping ; osmdata:targetProperty owf:rotorDiameter ; osmdata:targetKey "rotor_diameter_m" ;
    osmdata:sourceKeys ( osmkey:rotor:diameter ) ; osmdata:conversion osmdata:ParseNumber .
osmdata:tmap-rotor-axis a osmdata:TagMapping ; osmdata:targetProperty owf:rotorAxis ; osmdata:targetKey "rotor_axis" ;
    osmdata:valueRules (
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:generator:type ; osmdata:ruleValue "horizontal_axis" ; osmdata:yields owf:HorizontalAxis ]
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:generator:type ; osmdata:ruleValue "vertical_axis" ; osmdata:yields owf:VerticalAxis ] ) .
osmdata:tmap-offshore a osmdata:TagMapping ; osmdata:targetProperty owf:offshore ; osmdata:targetKey "offshore" ;
    osmdata:valueRules ( [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:offshore ; osmdata:ruleValue "yes" ; osmdata:yields true ] ) .
osmdata:tmap-operator a osmdata:TagMapping ; osmdata:targetProperty owf:operatorName ; osmdata:targetKey "operator" ;
    osmdata:sourceKeys ( osmkey:operator ) ; osmdata:conversion osmdata:SplitSemicolon .
osmdata:tmap-status a osmdata:TagMapping ; osmdata:targetProperty owf:conditionOfFacility ; osmdata:targetKey "status" ;
    osmdata:valueRules (
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:status ; osmdata:ruleValue "construction" ; osmdata:yields inspire-cofv:underConstruction ]
        [ a osmdata:ValueRule ; osmdata:ruleKey osmkey:construction:power ; osmdata:ruleValue "generator" ; osmdata:yields inspire-cofv:underConstruction ] ) .

# Element-level rules for turbines (implemented by the transform):
#   node id                          -> feature id <https://www.openstreetmap.org/node/{id}>, Point geometry from lat/lon
#   member of a wind farm relation   -> windfarm (relation URL), windfarm_name (relation name)
#   node timestamp                   -> last_updated
# generator:type=offshore is not a rotor axis value and gives no rotor_axis.

#################################################################
# Tag keys (generated by gen_osm_tags.py from the block examples; do not edit by hand)
#
# Each OSM tag key is a property <https://www.openstreetmap.org/wiki/Key:<key>> (osm2rdf convention).
# Bare keys that are also the first segment of a colon key (ISO3166-1, alt_name, name, note, official_name, population, short_name, source)
# expand with a trailing colon (JSON-LD 1.1 prefix rule) and are aligned to the plain key IRI.
#################################################################

<https://www.openstreetmap.org/wiki/Key:ISO3166-1:>
    a owl:DatatypeProperty ;
    rdfs:label "ISO3166-1" ;
    skos:notation "ISO3166-1" ;
    rdfs:domain osmdata:TagSet ;
    rdfs:range xsd:string ;
    owl:equivalentProperty <https://www.openstreetmap.org/wiki/Key:ISO3166-1> ;
    rdfs:seeAlso <https://wiki.openstreetmap.org/wiki/Key:ISO3166-1> .

